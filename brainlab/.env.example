# Copy to brainlab/.env (git-ignored). Names only: put YOUR values in the copy, never in this file, never in chat.
# Used by brainlab/rhread.py, which only READS (quotes, greeks, buying power). It has no order call and selfcheck.py fails if one appears.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# A one-time code for THIS run, if Robinhood asks. Do NOT store the MFA seed (the secret behind the code) in a file: with the password
# beside it, anyone who reads the file can sign in without your phone, which defeats the second factor.
ROBINHOOD_MFA=
# The account whose buying power is read. The desk trades ONE account (docs/RH_LIVE_ROUTINE.md).
RH_ACCOUNT_NUMBER=995386158
