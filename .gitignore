# Embedded Postgres fallback data (local dev only)
.pglite/

# Python gateway (gateway/)
gateway/__pycache__/
gateway/*.pyc
gateway/.venv/

# Capture resume files — large, transient, rewritten on every chunk.
src/data/*.json.part
.cache/
.claude/worktrees/

# Brain lab vector store and one-off bar dumps. Rebuilt locally. Not the book.
brainlab/.chroma/
brainlab/out/
brainlab/**/__pycache__/


# The lab virtualenv (brainlab/requirements.txt installs here)
brainlab/.venv/
brainlab/*.db

# Graphify writes a parse cache beside its report (9,000+ generated files, ~30 MB). The report and the Obsidian notes stay tracked; the cache does not.
graphify-out/cache/

# Forge Atlas Wave 1 H1: generated Graphify Obsidian notes are rebuilt by `graphify`, not tracked.
# Kept tracked: graph.json, GRAPH_REPORT.md, SEED_REPORT.md, graph.canvas and the hand-exported brain/ book
# (scripts/verify-brain-vault.mjs and brainlab/ read those).
graphify-out/obsidian/*
!graphify-out/obsidian/brain/
!graphify-out/obsidian/graph.canvas
ai/.sessions.log
graphify-out/.post-commit.log
ai/.context.md
ai/.context.md.tmp
