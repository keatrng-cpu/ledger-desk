+import copy
+import json
+import os
+import time
+
+from watcher import free_data
+
+FD = {"mode": "shadow", "live": False, "asOf": "2026-10-20T12:26:00.000Z",
+      "ff": {"source": "cache", "usdScoped": [], "actualsAvailable": False,
+             "nextPrint": {"title": "Housing Starts", "dateCt": "2026-10-20", "timeCt": "07:30", "forecast": "1.30M", "previous": "1.28M", "actual": None, "surpriseSign": None},
+             "printWindow": {"flag": True, "events": ["Housing Starts", "Building Permits"]}},
+      "vix": {"date": "2026-10-16", "vix": 19.99, "vix9d": 20.12, "vix3m": 20.5, "vix9dVix": 1.0065, "vixVix3m": 0.9751, "regime": "flat", "frontInverted": True}}
+NOW = 1792502760000   # 2026-10-20 07:26 CT
+
+
+def test_record_reads_desk_free_data_and_never_orders(tmp_path):
+    r = free_data.record({"wire": {"freeData": FD}}, NOW, str(tmp_path / "none.json"))
+    assert r["broker"] is False and r["orders"] == 0 and r["mode"] == "shadow"
+    assert r["print_window"] is True and r["next_print"]["title"] == "Housing Starts" and r["next_print"]["forecast"] == "1.30M"
+    assert r["vix"]["regime"] == "flat" and r["vix"]["frontInverted"] is True
+    assert r["local_snapshot"] is False and r["orderflow"] is None
+
+
+def test_missing_free_data_is_tolerated(tmp_path):
+    r = free_data.record({}, NOW, str(tmp_path / "none.json"))
+    assert r["desk_read"] is False and r["print_window"] is None and r["vix"] is None
+    assert free_data.record(None, NOW, None)["desk_read"] is False
+
+
+def test_local_snapshot_orderflow_and_staleness(tmp_path):
+    p = tmp_path / "free-features.json"
+    p.write_text(json.dumps({"asOf": "x", "orderflow": {"ES": {"60s": {"start_ct": "07:25", "delta": -84, "cvd": -5347}, "30s": {"start_ct": "07:25:30", "delta": -8}}},
+                             "xasset": {"ZN": {"close": 110.5}}}))
+    r = free_data.record({"wire": {"freeData": FD}}, int(time.time() * 1000), str(p))
+    assert r["orderflow"]["ES"] == {"bar_1m": "07:25", "delta_1m": -84, "cvd": -5347, "bar_30s": "07:25:30", "delta_30s": -8}
+    assert r["xasset"]["ZN"]["close"] == 110.5
+    old = time.time() - free_data.MAX_SNAPSHOT_AGE_S - 5
+    os.utime(p, (old, old))
+    assert free_data.record({}, int(time.time() * 1000), str(p))["local_snapshot"] is False
+
+
+def test_once_per_minute(tmp_path, monkeypatch):
+    monkeypatch.setenv("DESK_FREE_DATA", "1")
+    st = {}
+    assert free_data.log(str(tmp_path), {"wire": {"freeData": FD}}, st, NOW, str(tmp_path / "x")) is not None
+    assert free_data.log(str(tmp_path), {"wire": {"freeData": FD}}, st, NOW + 30_000, str(tmp_path / "x")) is None
+    assert free_data.log(str(tmp_path), {"wire": {"freeData": FD}}, st, NOW + 60_000, str(tmp_path / "x")) is not None
+    assert len(open(tmp_path / free_data.FILE).read().splitlines()) == 2
+
+
+def test_module_has_no_broker_import_and_does_not_touch_gates():
+    src = open(free_data.__file__).read()
+    code = src.split('"""', 2)[2]
+    assert "import broker" not in code and "from .broker" not in code and "from . import broker" not in code
+    assert "gates" not in code and "RULES" not in code
+
+
+def test_gates_identical_with_and_without_free_data():
+    """The shadow block on the card must not change a single gate row."""
+    from watcher import gates
+    here = os.path.dirname(__file__)
+    card = json.load(open(os.path.join(here, "fixtures", "card_live_watch.json")))
+    with_fd = copy.deepcopy(card); with_fd.setdefault("wire", {})["freeData"] = FD
+    a = gates.snapshot(card); b = gates.snapshot(with_fd)
+    assert a == b
+
+
+def test_daemon_hook_logs_and_never_raises(tmp_path, monkeypatch):
+    monkeypatch.setenv("DESK_FREE_DATA", "1")
+    from watcher import daemon
+
+    class Cfg:
+        def path(self, p):
+            return str(tmp_path / p) if p else str(tmp_path)
+
+    logged = []
+    w = daemon.Watcher.__new__(daemon.Watcher)
+    w.cfg = Cfg(); w.log = lambda kind, **kw: logged.append(kind)
+    w._free_data_shadow({"wire": {"freeData": FD}}, NOW)
+    w._free_data_shadow("not a card", NOW + 60_000)
+    assert "free_data_shadow_error" not in logged
+    assert len(open(tmp_path / free_data.FILE).read().splitlines()) == 2
+
+
+def test_default_off_writes_nothing(tmp_path, monkeypatch):
+    monkeypatch.delenv("DESK_FREE_DATA", raising=False)
+    for v in (None, "", "0", "false", "TRUE", "yes", " 1"):
+        if v is None:
+            monkeypatch.delenv("DESK_FREE_DATA", raising=False)
+        else:
+            monkeypatch.setenv("DESK_FREE_DATA", v)
+        assert free_data.enabled() is False
+        assert free_data.log(str(tmp_path), {"wire": {"freeData": FD}}, {}, NOW, str(tmp_path / "x")) is None
+    assert not (tmp_path / free_data.FILE).exists()
+
+
+def test_enabled_only_by_1_or_true(tmp_path, monkeypatch):
+    for i, v in enumerate(("1", "true")):
+        monkeypatch.setenv("DESK_FREE_DATA", v)
+        assert free_data.enabled() is True
+        assert free_data.log(str(tmp_path), {"wire": {"freeData": FD}}, {}, NOW + i * 60_000, str(tmp_path / "x")) is not None
+    assert len(open(tmp_path / free_data.FILE).read().splitlines()) == 2
+
+
+def test_rotation_daily_size_cap_and_retention(tmp_path, monkeypatch):
+    monkeypatch.setenv("DESK_FREE_DATA", "1")
+    p = tmp_path / free_data.FILE
+    day1 = 1792502760.0                          # 2026-10-20 12:26 UTC
+    p.write_text(json.dumps({"ts": int(day1 * 1000)}) + "\n")
+    assert free_data.rotate(str(tmp_path), int(day1 * 1000) + 60_000) is None          # same day, small -> no rotate
+    dst = free_data.rotate(str(tmp_path), int((day1 + 86400) * 1000))                  # next day -> rotate
+    assert dst and dst.endswith("free_data_shadow.20261020.jsonl") and not p.exists()
+    p.write_text("y" * 50)
+    assert free_data.rotate(str(tmp_path), int(time.time() * 1000), max_bytes=10)      # size cap
+    for i in range(10):
+        (tmp_path / f"free_data_shadow.2026090{i}.jsonl").write_text("z")
+    p.write_text("y" * 50)
+    free_data.rotate(str(tmp_path), int(time.time() * 1000), max_bytes=10, keep=3)
+    rotated = [f for f in os.listdir(tmp_path) if f.startswith("free_data_shadow.") and f != free_data.FILE]
+    assert len(rotated) == 3
+    st = {}
+    assert free_data.log(str(tmp_path), {"wire": {"freeData": FD}}, st, int(time.time() * 1000), str(tmp_path / "x"))
+    assert len(p.read_text().splitlines()) == 1
