+"""Free data feeds SHADOW logger (ledger-desk shared/free-data.json, docs/free-data-1018).
+
+Once per closed minute, appends one row to free_data_shadow.jsonl with: the desk's free-data read (card wire
+`freeData`: next USD print, 07:30 CT print-window flag, VIX term structure) and, when present and fresh, the local
+feature snapshot written by ledger-desk feeds/free_data (order-flow delta / session CVD of the last CLOSED 30s/1m
+bars, ZN/6E 1m reads). LOG-ONLY: it never imports the broker, never touches the snapshot the gates read, never
+changes a gate, the fire path or the rules hash. The news gate (gates.news_blackout) is unchanged.
+"""
+import json
+import os
+import time
+
+FILE = "free_data_shadow.jsonl"
+SNAPSHOT_ENV = "FREE_FEATURES_PATH"
+SNAPSHOT_DEFAULT = "/workspace/data/free-feeds/free-features.json"
+MAX_SNAPSHOT_AGE_S = 1800
+ENABLE_ENV = "DESK_FREE_DATA"
+MAX_BYTES = 20 * 1024 * 1024    # size cap per file
+KEEP_ROTATED = 7                # rotated files kept (about a week at daily rotation)
+
+
+def enabled(env=None):
+    """Release Watch: OFF by default. On only when DESK_FREE_DATA is exactly "1" or "true" (same rule as the desk)."""
+    v = (os.environ if env is None else env).get(ENABLE_ENV)
+    return v in ("1", "true")
+
+
+def _local(path, now_s):
+    try:
+        if not path or not os.path.exists(path) or now_s - os.path.getmtime(path) > MAX_SNAPSHOT_AGE_S:
+            return None
+        with open(path, encoding="utf-8") as f:
+            return json.load(f)
+    except (OSError, ValueError):
+        return None
+
+
+def record(card, now_ms, snapshot_path=None):
+    card = card if isinstance(card, dict) else {}
+    fd = (card.get("wire") or {}).get("freeData") or card.get("freeData") or {}
+    ff = fd.get("ff") or {}
+    nxt = ff.get("nextPrint") or {}
+    vix = fd.get("vix") or {}
+    loc = _local(snapshot_path or os.environ.get(SNAPSHOT_ENV, SNAPSHOT_DEFAULT), now_ms / 1000.0) or {}
+    of = {}
+    for sym, lanes in (loc.get("orderflow") or {}).items():
+        b = (lanes or {}).get("60s") or {}
+        h = (lanes or {}).get("30s") or {}
+        of[sym] = {"bar_1m": b.get("start_ct"), "delta_1m": b.get("delta"), "cvd": b.get("cvd"),
+                   "bar_30s": h.get("start_ct"), "delta_30s": h.get("delta")}
+    return {
+        "ts": now_ms, "kind": "free_data_shadow", "mode": "shadow", "broker": False, "orders": 0,
+        "desk_read": bool(fd),
+        "print_window": (ff.get("printWindow") or {}).get("flag"),
+        "print_window_events": (ff.get("printWindow") or {}).get("events") or [],
+        "next_print": {k: nxt.get(k) for k in ("title", "dateCt", "timeCt", "forecast", "previous", "actual", "surpriseSign")} if nxt else None,
+        "vix": {k: vix.get(k) for k in ("date", "vix", "vix9dVix", "vixVix3m", "regime", "frontInverted")} if vix else None,
+        "orderflow": of or None,
+        "xasset": loc.get("xasset"),
+        "local_snapshot": bool(loc), "local_as_of": loc.get("asOf"),
+    }
+
+
+def rotate(path_dir, now_ms, max_bytes=MAX_BYTES, keep=KEEP_ROTATED):
+    """Daily (UTC day of the file's first row `ts`) or size-capped rotation: free_data_shadow.<YYYYMMDD[-HHMMSS]>.jsonl.
+    Keeps the newest `keep` rotated files. Never raises."""
+    p = os.path.join(path_dir, FILE)
+    try:
+        if not os.path.exists(p):
+            return None
+        st = os.stat(p)
+        try:
+            with open(p, encoding="utf-8") as f:
+                first_ts = json.loads(f.readline())["ts"] / 1000.0
+        except (ValueError, KeyError, TypeError):
+            first_ts = st.st_mtime
+        day = time.strftime("%Y%m%d", time.gmtime(first_ts))
+        if day == time.strftime("%Y%m%d", time.gmtime(now_ms / 1000.0)) and st.st_size < max_bytes:
+            return None
+        tag = day if st.st_size < max_bytes else time.strftime("%Y%m%d-%H%M%S", time.gmtime(now_ms / 1000.0))
+        dst = os.path.join(path_dir, FILE.replace(".jsonl", f".{tag}.jsonl"))
+        if os.path.exists(dst):
+            dst = dst.replace(".jsonl", f".{int(now_ms)}.jsonl")
+        os.replace(p, dst)
+        old = sorted(f for f in os.listdir(path_dir) if f.startswith("free_data_shadow.") and f != FILE)
+        for f in old[:-keep] if keep else old:
+            try:
+                os.remove(os.path.join(path_dir, f))
+            except OSError:
+                pass
+        return dst
+    except OSError:
+        return None
+
+
+def log(path_dir, card, state, now_ms=None, snapshot_path=None):
+    """Append at most one row per minute. `state` is a dict the caller keeps (holds the last minute logged).
+    Default OFF: returns None and writes nothing unless enabled()."""
+    if not enabled():
+        return None
+    now_ms = now_ms or int(time.time() * 1000)
+    minute = now_ms // 60_000
+    if state.get("minute") == minute:
+        return None
+    state["minute"] = minute
+    row = record(card, now_ms, snapshot_path)
+    rotate(path_dir, now_ms)
+    with open(os.path.join(path_dir, FILE), "a", encoding="utf-8") as f:
+        f.write(json.dumps(row, default=str) + "\n")
+    return row
