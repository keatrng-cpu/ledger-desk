index 0000000..5ce8bb9
--- /dev/null
+++ b/tests/test_evfire.py
@@ -0,0 +1,58 @@
+"""evFire (OFF by default): EV math, calibration refuse, hold survives flips, crossed stop, fast:entry text, sizing."""
+import copy, json
+from watcher import evfire as ev, fastchain, gates
+
+T = ev.TABLE
+SNAP = {"symbol": "MNQ", "side": "short", "band": "B", "q": 0.47, "entry": 29771.13, "stop_px": 29798.31, "first_target": 29703.25,
+        "tape_prices": {"MNQ": 29760.0}, "htf_bias": [("1h", "bear"), ("4h", "bear")],
+        "smc_unity_rows": [{"rule": "continuation", "would": "short: structure holds on 6 rungs (1m,2m,3m,4m,5m,15m)"}]}
+
+def test_off_by_default_and_shadow_rows_never_block():
+    assert gates.RULES["evFire"]["mode"] == "off" and ev.mode() == "off" and ev.rows(SNAP, [], 0) == ([], False, None)
+    for k in ("ltfSoft", "qRawOnce", "dropCrossedStop"): assert gates.RULES["evFire"][k]["mode"] == "off"
+
+def test_ev_math_and_rr_cap():
+    assert ev.ev_r(0.5, 2.0) == round(0.5 * 2 - 0.5 - 0.10, 6)
+    assert ev.ev_r(0.3, 34.0) == ev.ev_r(0.3, 4.0)          # RR capped at 4 for scoring
+    assert ev.ev_r(0.5, 2.0, cost_r=0.05) == ev.ev_r(0.5, 2.0)  # cost floor 0.10
+    assert ev.ev_r(0.5, 2.0, cost_r=0.30) == round(1.0 - 0.5 - 0.30, 6)
+
+def test_calibration_refuses_untrained_or_wrong_hash():
+    assert T and T["trained"] and ev.table_hash(T) == T["hash"] == gates.RULES["evFire"]["calibration"]["tableHash"]
+    assert ev.p_of(0.6, 6, True) is not None
+    bad = copy.deepcopy(T); bad["trained"] = False; assert ev.p_of(0.6, 6, True, table=bad) is None
+    bad = copy.deepcopy(T); bad["cells"] = {}; assert ev.p_of(0.6, 6, True, table=bad) is None   # stored hash no longer matches
+    assert ev.p_of(0.6, 6, True, pin="deadbeef") is None
+
+def test_size_probe_and_full():
+    assert ev.size_usd("B") == 325 and ev.size_usd("C") == 325 and ev.size_usd("B+") == 650 and ev.size_usd("A+") == 650
+
+def test_hold_survives_card_flip_and_resets_on_crossed_stop():
+    h = ev.hold_next({}, SNAP, True, 1000)
+    es = {**SNAP, "symbol": "ES", "side": "long", "entry": 6700, "stop_px": 6690, "first_target": 6720, "tape_prices": {"ES": 6701}}
+    h = ev.hold_next(h, es, False, 5000)                     # primary card flips to ES: the MNQ:short hold stays
+    assert h["MNQ:short"] == 1000
+    h = ev.hold_next(h, SNAP, True, 22000); assert h["MNQ:short"] == 1000
+    crossed = {**SNAP, "tape_prices": {"MNQ": 29800.0}}
+    assert "MNQ:short" not in ev.hold_next(h, crossed, True, 23000)
+    opp = {**SNAP, "side": "long", "entry": 29700, "stop_px": 29680, "first_target": 29760}
+    assert "MNQ:short" not in ev.hold_next(h, opp, True, 24000)   # opposite-side EV pass resets
+
+def test_rows_shadow_and_hard_gates(monkeypatch):
+    monkeypatch.setitem(ev.EVF, "mode", "shadow")
+    s = {**SNAP, "ev_holds": {"MNQ:short": 0}}
+    r = ev.read(s); rows, would, _ = ev.rows(s, [("news", True, "")], 30000)
+    assert rows[0][0] == "shadow:ev:fire" and rows[0][1] is True and would == r["would"]
+    rows, would, _ = ev.rows(s, [("fast:entry", False, "")], 30000); assert not would and "fast:entry" in rows[0][2]
+    rows, would, _ = ev.rows({**s, "ev_holds": {"MNQ:short": 25000}}, [], 30000); assert not would   # 5 s < 20 s hold
+    rows, would, _ = ev.rows({**s, "brain_symbol": "MNQ", "brain_side": "long"}, [], 30000); assert not would and "brain_ev_veto" in rows[0][2]
+
+def test_fast_entry_prints_real_limit():
+    s = {**SNAP, "atr": 54.36, "tape_prices": {"MNQ": 29731.13}}
+    row = [r for r in fastchain.setup_rows(s) if r[0] == "fast:entry"][0]
+    assert not row[1] and "= 40.0 <= 27.18 (0.5xATR 54.36)" in row[2]
+
+def test_desk_parity_cases():
+    """Same numbers as src/lib/desk/ev-fire.ts evCard (scripts/ev-fire.test.mjs feeds these exact cases)."""
+    for q, rungs, ok in ((0.47, 6, True), (0.6499, 0, False), (0.52, 5, True), (0.90, 9, True)):
+        p = ev.p_of(q, rungs, ok); assert p is not None and 0 < p < 1
