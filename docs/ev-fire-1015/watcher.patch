diff --git a/watcher/evfire.py b/watcher/evfire.py
new file mode 100644
index 0000000..4c4e927
--- /dev/null
+++ b/watcher/evfire.py
@@ -0,0 +1,113 @@
+"""EV fire path (shared rules evFire; TS twin src/lib/desk/ev-fire.ts; parity in tests/test_evfire.py and the desk's
+scripts/ev-fire.test.mjs). OFF by default. shadow = rows + paper brackets only (shadow_ev.jsonl); never an order.
+EV_R = p*min(RR, rrCap) - (1-p) - max(costFloorR, costR), p = calibrated P(T1) from ev-calibration.json."""
+import json, os, re, hashlib
+from .gates import RULES, BAND_RANK, _num
+
+EVF = RULES["evFire"]
+_CAL_PATH = os.path.join(os.path.dirname(__file__), "ev-calibration.json")
+
+def mode(): return EVF.get("mode", "off")
+def on(m=None): return (m if m is not None else mode()) in ("shadow", "live")
+
+def table_hash(t):
+    b = {k: v for k, v in t.items() if k != "hash"}
+    return hashlib.sha256(json.dumps(b, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()[:16]
+
+def load_table(path=_CAL_PATH):
+    try:
+        with open(path) as f: return json.load(f)
+    except (OSError, ValueError): return None
+
+TABLE = load_table()
+
+def cal_key(q, rungs, htf_ok, bucket):
+    import math
+    return f"{min(math.floor(q / bucket + 1e-9), math.floor(0.75 / bucket))}|{1 if rungs >= 5 else 0}|{1 if htf_ok else 0}"
+
+def p_of(q, rungs, htf_ok, table=None, pin=None):
+    """Calibrated P(T1); None = refuse (missing/untrained table, stored hash wrong, or not the pinned hash)."""
+    t = TABLE if table is None else table; pin = EVF["calibration"].get("tableHash") if pin is None else pin
+    if not t or not t.get("trained") or not pin or t.get("hash") != pin or table_hash(t) != pin: return None
+    c = t["cells"].get(cal_key(q, rungs, htf_ok, t["bucket"]))
+    return c["p"] if c else t["global"]
+
+def ev_r(p, rr, cost_r=None):
+    return round(p * min(rr, EVF["rrCap"]) - (1 - p) - max(EVF["costFloorR"], cost_r or 0), 6)
+
+def size_usd(band):
+    return EVF["fullUsd"] if BAND_RANK.get(band, -99) >= BAND_RANK[EVF["fullMinBand"]] else EVF["probeUsd"]
+
+def stop_crossed(side, px, stop):
+    if px is None or stop is None: return False
+    return px <= stop if side == "long" else px >= stop if side == "short" else False
+
+def rungs_of(snap):
+    for r in snap.get("smc_unity_rows") or []:
+        if r.get("rule") == "continuation":
+            m = re.search(r"holds on (\d+) rungs", str(r.get("would") or ""))
+            if m: return int(m.group(1))
+    return 0
+
+def htf_ok(snap):
+    want = "bull" if snap.get("side") == "long" else "bear"
+    return all(b in (None, want) for _, b in (snap.get("htf_bias") or []))
+
+def read(snap):
+    """dict(p, rr, ev, would, size, why) for the snapshot's card (same math as the desk's evCard)."""
+    side = snap.get("side"); e, st, t1 = _num(snap.get("entry")), _num(snap.get("stop_px")), _num(snap.get("first_target"))
+    q = snap.get("q") or 0; size = size_usd(snap.get("band"))
+    ok = None not in (e, st, t1) and ((side == "long" and st < e < t1) or (side == "short" and t1 < e < st))
+    if not ok: return dict(p=None, rr=None, ev=None, would=False, size=size, why="plan levels invalid")
+    rr = abs(t1 - e) / abs(e - st); p = p_of(q, rungs_of(snap), htf_ok(snap))
+    if p is None: return dict(p=None, rr=rr, ev=None, would=False, size=size, why="calibration untrained or hash mismatch — refuse")
+    ev = ev_r(p, rr)
+    would = q >= EVF["qFloor"] and ev >= EVF["threshold"]
+    return dict(p=p, rr=rr, ev=ev, would=would, size=size,
+                why=f"EV {ev:.3f}R p {p} RR {rr:.2f} (cap {EVF['rrCap']}) q {q} (need EV >= {EVF['threshold']}, q >= {EVF['qFloor']}); size ${size}")
+
+def hold_next(holds, snap, ev_ok, now_ms):
+    """Per symbol:side EV hold (>= holdS). Survives primary-card flips (other keys are left untouched);
+    reset only by a crossed stop on this key, an opposite-side EV pass on the same symbol, or EV failing on this key."""
+    holds = dict(holds or {}); sym, side = snap.get("symbol"), snap.get("side")
+    if sym is None or side not in ("long", "short"): return holds
+    key = f"{sym}:{side}"; other = f"{sym}:{'short' if side == 'long' else 'long'}"
+    px = (snap.get("tape_prices") or {}).get(sym)
+    if stop_crossed(side, px, _num(snap.get("stop_px"))): holds.pop(key, None); return holds
+    if ev_ok:
+        holds.pop(other, None)
+        holds.setdefault(key, now_ms)
+    else:
+        holds.pop(key, None)
+    return holds
+
+REPLACES = ("band", "fast:persist", "fast:velocity", "second_entry_band", "band_truth")
+HARD_EV = ("news", "entry_cutoff", "fast:plan", "fast:geometry", "fast:entry", "fast:agree", "tape", "tape_fresh", "card_age",
+           "entries_day", "weekly_lock", "account", "no_position", "no_working_order", "live_quote", "sizing", "buying_power",
+           "exec_account", "rules_parity", "late_pnl_live", "entry_distance", "day_loss", "opt:spread")
+
+def rows(snap, g, now_ms):
+    """Shadow (or live) ev rows given the evaluated gate list g. Returns (rows, would_fire, read)."""
+    if not on(): return [], False, None
+    r = read(snap); out = []
+    px = (snap.get("tape_prices") or {}).get(snap.get("symbol"))
+    crossed = stop_crossed(snap.get("side"), px, _num(snap.get("stop_px")))
+    since = (snap.get("ev_holds") or {}).get(f"{snap.get('symbol')}:{snap.get('side')}")
+    held = None if since is None else (now_ms - since) / 1000
+    fails = sorted({n for n, ok, _ in g if n in HARD_EV and ok is False})
+    bv = snap.get("brain_symbol") == snap.get("symbol") and snap.get("brain_side") in ("long", "short") and snap.get("brain_side") != snap.get("side")
+    would = bool(r["would"] and not crossed and not fails and not bv and held is not None and held >= EVF["holdS"])
+    why = (f"WOULD fire ${r['size']} " if would else "no fire: ") + r["why"] + f"; hold {None if held is None else round(held, 1)}s (need >= {EVF['holdS']}s)" \
+          + (f"; hard fails {fails}" if fails else "") + ("; stop already crossed" if crossed else "") + ("; brain_ev_veto (brain on the opposite side)" if bv else "")
+    name = "ev:fire" if mode() == "live" else "shadow:ev:fire"
+    out.append((name, would if mode() == "live" else True, why))
+    return out, would, r
+
+def paper(path, snap, r, now_ms):
+    """Shadow paper bracket (no order code path)."""
+    rec = {"ts": now_ms / 1000, "symbol": snap.get("symbol"), "side": snap.get("side"), "band": snap.get("band"), "q": snap.get("q"),
+           "entry": snap.get("entry"), "stop": snap.get("stop_px"), "t1": snap.get("first_target"),
+           "px": (snap.get("tape_prices") or {}).get(snap.get("symbol")), "p": r["p"], "rr": r["rr"], "ev": r["ev"], "size_usd": r["size"],
+           "cal_hash": (TABLE or {}).get("hash"), "mode": mode()}
+    with open(path, "a") as f: f.write(json.dumps(rec) + "\n")
+    return rec
