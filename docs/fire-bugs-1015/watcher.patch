+    st = fc.streak_next(st, snap(at="c2", **CHASE), 120_000)                                # ran for 2 min
+    st = fc.streak_next(st, snap(at="p1"), 125_000); assert st["first_ms"] == 125_000 and st["polls"] == 1 and _persist(st, 125_000) is False
