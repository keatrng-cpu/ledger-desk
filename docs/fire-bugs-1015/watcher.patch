+        assert "fast:velocity" not in r and r["soft:fast:velocity"] is True and "fast:velocity" not in fc.FC["hard"]
+    v = lambda m, n: fc.velocity_size(n, snap(loss={"velocity": {"expMin": m}}), cfg)[0]
+    assert v(20, 4) == 4 and v(30, 4) == 4                 # within the 30m cap: full size
+    assert v(31, 4) == 2 and v(45, 3) == 1 and v(59, 1) == 1   # > cap: half, whole contracts, min 1
+    assert v(61, 4) == 1 and v(None, 4) == 1                # > 2x cap or unknown: minimum size
