index 0000000..cbc1512
--- /dev/null
+++ b/watcher/fix1016.py
@@ -0,0 +1,90 @@
+"""Short post-mortem 2026-10-16 — watcher half of fixes 3/6/7/8 (shared rules fix1016; TS twin src/lib/smc/fix1016.ts).
+Every STRATEGY item is shadow by default: rows are logged as shadow:fix1016:<item> and change nothing. Item 6
+(watch window 09:25 ET + market_open gate at 09:30 ET) is not a strategy change and is live."""
+from .gates import RULES, _hm, ET, _num
+
+FX = RULES.get("fix1016") or {}
+
+def mode(k):
+    return "live" if (FX.get(k) or {}).get("mode") == "live" else "shadow"
+
+def item(k):
+    return FX.get(k) or {}
+
+# ---- fix 6: fast window from 09:25 ET; fires only from 09:30 ET (options open) ----
+def fast_window_default(end="11:30"):
+    return f"{item('watcherWindow').get('fastStartEt', '09:30')}-{end}"
+
+def fire_not_before():
+    return item("watcherWindow").get("fireNotBeforeEt", "09:30")
+
+def market_open_row(now_ms):
+    """Hard gate (never softened): no fire before fireNotBeforeEt ET — the watcher may poll from 09:25 but RH options open 09:30."""
+    import datetime as _d
+    t = _d.datetime.fromtimestamp(now_ms / 1000, ET); m = t.hour * 60 + t.minute; lim = fire_not_before()
+    return ("market_open", m >= _hm(lim), f"{t.strftime('%H:%M:%S')} ET {'>=' if m >= _hm(lim) else '<'} {lim} ET (options open)")
+
+# ---- fix 3: ltfArm promotion (desk half on the card; watcher adds Brain TAKE same symbol+side) ----
+def ltf_promote_rows(snap):
+    f = snap.get("fix1016") or {}; p = f.get("ltfPromote") or {}
+    if not isinstance(p, dict) or not p: return []
+    w = str(snap.get("brain_word") or "").upper(); bs, bd = snap.get("brain_symbol"), snap.get("brain_side")
+    brain_ok = w == "TAKE" and bs == snap.get("symbol") and bd == snap.get("side") and not snap.get("brain_missing")
+    why = "; ".join(p.get("why") or []) + f"; brain {w or 'none'} {bs} {bd}"
+    if p.get("promoted") and mode("ltfPromote") == "live":
+        return [("fix1016:ltf_promote_brain", brain_ok, ("promoted LTF arm: Brain TAKE agrees — " if brain_ok else "promoted LTF arm needs Brain TAKE on the card's symbol+side — ") + why)]
+    if p.get("deskOk"):
+        return [("shadow:fix1016:ltf_promote", True, f"WOULD {'promote + fire-eligible' if brain_ok else 'promote, blocked by Brain'} (plan {((p.get('plan') or {}).get('entry'))}/{((p.get('plan') or {}).get('stop'))}): {why}")]
+    return []
+
+def shadow_rows(snap):
+    """Desk-side shadow reads (re-anchor / chase / score5 / runner) as gates.log rows; never gate."""
+    f = snap.get("fix1016") or {}
+    if not isinstance(f, dict) or not f: return []
+    out = []
+    r = f.get("reanchor") or {}
+    if r.get("trigger") and not r.get("applied"):
+        to = r.get("to") or {}
+        out.append(("shadow:fix1016:reanchor", True, f"desk WOULD re-anchor ({r.get('trigger')}, {r.get('distAtr')}xATR): {r.get('from', {}).get('entry')} -> {to.get('entry') if to else 'released'} {to.get('src', '') if to else ''}"))
+    c = f.get("chase") or {}
+    if (c.get("live") or {}).get("distAtr") != (c.get("anchor") or {}).get("distAtr") and c.get("anchor"):
+        out.append(("shadow:fix1016:chase", True, f"chase from anchor {(c.get('anchor') or {}).get('distAtr')}xATR vs card {(c.get('live') or {}).get('distAtr')}xATR"))
+    s = f.get("score5") or {}
+    if s and s.get("mode") != "live":
+        out.append(("shadow:fix1016:score5", True, f"score5 {s.get('total')} vs q {s.get('old')} (layers {s.get('layers')})"))
+    rn = f.get("runner") or {}
+    if rn and rn.get("mode") != "live" and rn.get("runnerTarget") is not None:
+        out.append(("shadow:fix1016:runner", True, f"WOULD take {rn.get('partialFrac')} at T1 {rn.get('t1')}, BE {rn.get('beStop')}, runner -> {rn.get('runnerTarget')} ({rn.get('runnerR')}R)"))
+    return out
+
+# ---- fix 8: runner management ----
+def runner_manage(pos, underlying_px):
+    """live: at T1 trim t1PartialFrac (>=2 ct) and move the futures stop to break-even; exit the rest at the runner pool.
+    shadow: logs WOULD rows once each (pos['shadow_new']) and returns None (existing management unchanged)."""
+    tgt, t1, ref = pos.get("fut_runner"), pos.get("fut_t1"), pos.get("fut_ref")
+    if underlying_px is None or t1 is None or ref is None or tgt is None: return None
+    L = pos.get("fut_side") == "long"
+    at_t1 = underlying_px >= t1 if L else underlying_px <= t1
+    at_rt = underlying_px >= tgt if L else underlying_px <= tgt
+    frac = float(item("runner").get("t1PartialFrac", 0.5)); be = item("runner").get("beAfterT1", True)
+    if mode("runner") != "live":
+        if at_t1 and not pos.get("shadow_runner_t1"):
+            pos["shadow_runner_t1"] = True; pos.setdefault("shadow_new", []).append(("shadow:fix1016:runner", f"WOULD trim {frac:.0%} at T1 {t1} (px {underlying_px}), stop -> BE {ref}; runner -> {tgt}"))
+        if at_rt and pos.get("shadow_runner_t1") and not pos.get("shadow_runner_done"):
+            pos["shadow_runner_done"] = True; pos.setdefault("shadow_new", []).append(("shadow:fix1016:runner", f"WOULD exit runner at pool {tgt} (px {underlying_px})"))
+        return None
+    if pos.get("runner_t1") and at_rt:
+        return "exit", pos["qty"], f"runner at next pool {tgt} (fix1016 #8)"
+    if at_t1 and not pos.get("runner_t1"):
+        pos["runner_t1"] = True
+        if be: pos["fut_stop"] = ref; pos["be_moved"] = True
+        n = int(pos["qty"] * frac) if pos["qty"] >= 2 else 0
+        if n and not pos.get("trimmed"):
+            return "trim", n, f"T1 {t1}: trim {n} ({frac:.0%}), stop -> BE {ref}, runner -> {tgt} (fix1016 #8)"
+        return "hold", 0, f"T1 {t1} on {pos['qty']} ct: stop -> BE {ref}, runner -> {tgt} (fix1016 #8)"
+    return None
+
+# ---- fix 7: order-review quote retry ----
+def review_retry_cfg():
+    r = item("reviewQuoteRetry")
+    return mode("reviewQuoteRetry"), int(r.get("rounds", 2)), float(r.get("roundDelayMs", 400)) / 1000, float(r.get("maxTotalMs", 2500)) / 1000
