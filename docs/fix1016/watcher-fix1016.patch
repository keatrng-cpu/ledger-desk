diff --git a/tools/replay_fix1016.py b/tools/replay_fix1016.py
new file mode 100644
index 0000000..9e9bd74
--- /dev/null
+++ b/tools/replay_fix1016.py
@@ -0,0 +1,73 @@
+"""fix1016 proof: replay cards.log through the watcher gates of TWO trees (v5 baseline vs this patch) and compare.
+usage: python tools/replay_fix1016.py dump <tree> <cards.log> <out.jsonl>   (run once per tree, each with its own sys.path)
+       python tools/replay_fix1016.py diff <base.jsonl> <new.jsonl>
+Same card, same clock, same daemon extras, same config; the card's rules hash is mapped to each tree's own RULES_HASH
+(the desk ships the new hash with the new rules). New rows (market_open, fix1016:*, shadow:fix1016:*) are reported apart."""
+import json, os, sys
+
+INJECT = {"modes": {"reanchor": "shadow", "ltfPromote": "shadow", "score5": "shadow", "runner": "shadow"},
+          "reanchor": {"mode": "shadow", "trigger": "distance", "distAtr": 1.6, "from": {"entry": 30089.25, "stop": 30112.25}, "to": {"src": "ltfArm 1m ifvg", "entry": 30018.75, "stop": 30052.5, "t1": 29958.75, "t": 0}, "applied": False, "why": "replay"},
+          "chase": {"live": {"distAtr": 2.1, "qFactor": 0}, "anchor": {"distAtr": 0.6, "qFactor": 0.7}, "mode": "shadow"},
+          "ltfPromote": {"mode": "shadow", "eligible": True, "deskOk": True, "needsBrainTake": True, "why": ["band B+ >= B+"], "plan": {"entry": 30018.75, "stop": 30052.5}},
+          "score5": {"mode": "shadow", "total": 0.81, "old": 0.65, "delta": 0.16, "layers": {}, "sub": {}},
+          "runner": {"mode": "shadow", "t1": 29958.75, "partialFrac": 0.5, "runnerTarget": 29786.75, "runnerR": 6.9, "beStop": 30018.75, "why": "replay"}}
+
+def dump(tree, cards, out, inject=False):
+    sys.path.insert(0, tree); os.chdir(tree)
+    from watcher import gates
+    from watcher.config import Config
+    from tests.conftest import _raw_snapshot
+    cal = json.load(open(os.path.join(tree, "data", "news-calendar.json")))
+    def cfg(d):
+        c = Config()
+        for k, v in (d or {}).items():
+            if hasattr(c, k): setattr(c, k, v)
+        return c
+    n = 0
+    with open(out, "w") as fo:
+        for l in open(cards):
+            try: c = json.loads(l)
+            except Exception: continue
+            if "extra" not in c or c.get("broker"): continue
+            snap = _raw_snapshot(c["card"]); snap.update(c["extra"]); snap["_now_ms"] = c["now_ms"]; dayst = c.get("dayst") or {}
+            if inject: snap["fix1016"] = INJECT   # every shadow read present: must change no non-shadow row
+            old = snap.get("rules_hash")
+            if old and old != gates.RULES_HASH:
+                sub = lambda v: json.loads(json.dumps(v).replace(old, gates.RULES_HASH)); snap, dayst = sub(snap), sub(dayst)
+            try: rows = gates.evaluate_fire(snap, cfg(c.get("cfg")), c["now_ms"], dayst, None, cal)
+            except Exception as e: rows = [("replay_error", False, str(e)[:120])]
+            fo.write(json.dumps({"ts": c["ts"], "now_ms": c["now_ms"], "pass": all(ok is True for _, ok, _ in rows),
+                                 "rows": [[a, b, w] for a, b, w in rows]}) + "\n"); n += 1
+    print(tree, n, "cards")
+
+import re
+_H = re.compile(r"\b[0-9a-f]{16}\b")
+def _norm(rows): return [[a, b, _H.sub("<hash>", str(w))] for a, b, w in rows]
+NEW = lambda r: r[0] == "market_open" or str(r[0]).startswith("fix1016:") or str(r[0]).startswith("shadow:fix1016:")
+
+def diff(a, b):
+    A = [json.loads(l) for l in open(a)]; B = [json.loads(l) for l in open(b)]
+    assert len(A) == len(B), (len(A), len(B))
+    fire_diff, row_diff, new_rows, mo_false, earliest = [], [], {}, 0, None
+    import datetime as d, zoneinfo as z
+    for x, y in zip(A, B):
+        old_rows = _norm([r for r in y["rows"] if not NEW(r)])
+        if old_rows != _norm(x["rows"]): row_diff.append(x["ts"])
+        for r in y["rows"]:
+            if NEW(r): new_rows[r[0]] = new_rows.get(r[0], 0) + 1
+            if r[0] == "market_open" and r[1] is not True: mo_false += 1
+        # fire decision: v5 all-pass vs new all-pass; a new row may only ever REFUSE (market_open before 09:30 / brain on a live promotion)
+        # dry replay has no broker (broker rows ok=None), so "would fire" = no row False among the v5 rows + the new hard rows
+        xp = not any(r[1] is False for r in x["rows"]); yp = not any(r[1] is False for r in y["rows"] if not str(r[0]).startswith("shadow:"))
+        x["dry"], y["dry"] = xp, yp
+        if xp != yp: fire_diff.append((x["ts"], xp, yp))
+        t = d.datetime.fromtimestamp(x["now_ms"] / 1000, z.ZoneInfo("America/New_York"))
+        earliest = t if earliest is None or t < earliest else earliest
+    rep = {"cards": len(A), "dry_would_fire_v5": sum(x["dry"] for x in A), "dry_would_fire_new": sum(y["dry"] for y in B), "fire_decision_changed": fire_diff[:20],
+           "n_fire_changed": len(fire_diff), "v5_rows_changed": len(row_diff), "new_rows": new_rows, "market_open_false": mo_false, "earliest_card_et": str(earliest), "days": sorted({str(__import__("datetime").datetime.fromtimestamp(x["now_ms"] / 1000).date()) for x in A})}
+    print(json.dumps(rep, indent=1)); return rep
+
+if __name__ == "__main__":
+    if sys.argv[1] == "dump": dump(*sys.argv[2:5], inject="--inject" in sys.argv)
+    else:
+        r = diff(*sys.argv[2:4]); sys.exit(1 if r["n_fire_changed"] or r["v5_rows_changed"] else 0)
