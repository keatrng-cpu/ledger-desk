+
+    def _review_quote_retry(self, c, q, okq, whyq):
+        """fix1016 #7: still stale after the v5 tries -> up to `rounds` more refetch rounds (bounded by maxTotalMs).
+        live: a fresh quote passes review (the caller's chase_check still bounds the price). shadow: the extra reads run
+        and log review_quote_retry_shadow (would pass / not); the original refusal is returned unchanged."""
+        from . import fix1016
+        md, rounds, delay, budget = fix1016.review_retry_cfg()
+        if okq or rounds <= 0 or "old" not in str(whyq): return q, okq, whyq
+        t0 = time.monotonic(); q2, ok2, why2 = q, okq, whyq
+        for r in range(rounds):
+            if time.monotonic() - t0 + delay > budget: break
+            time.sleep(delay)
