+# ---- (4) re-entered post-fill branch can't orphan / replace a working resting stop ----
+def _daemon_stub(b, monkeypatch):
+    from watcher import daemon as dm
+    monkeypatch.setenv("EXIT_SAFE", "1"); monkeypatch.setenv("EXIT_SAFE_RESTING_STOP", "1")
+    alerts, logs = [], []
+    me = NS(broker=b, cfg=NS(hard_stop_loss=0.5), log=lambda *a, **k: logs.append((a, k)),
+            alert=lambda m, **k: alerts.append(m), save=lambda: None, stopped=lambda: False)
+    me._stop_px = lambda pos: dm.Watcher._stop_px(me, pos)
+    me._close_guard = lambda pos: dm.Watcher._close_guard(me, pos)
+    me._place_resting_stop = lambda pos, qty=None, force=False: dm.Watcher._place_resting_stop(me, pos, qty, force)
+    me.state = {"days": {}}
+    me.day = lambda d: dm.Watcher.day(me, d)
+    me._book_close = lambda pos, et, act, px, qty: dm.Watcher._book_close(me, pos, et, act, px, qty)
+    me._book_resting_stop_fill = lambda pos, oid, et: dm.Watcher._book_resting_stop_fill(me, pos, oid, et)
+    return dm, me, alerts, logs
+
+def test_post_fill_reentry_keeps_resting_stop(monkeypatch):
+    b = FakeBroker(held=1); dm, me, alerts, logs = _daemon_stub(b, monkeypatch)
+    pos = {"contract": C, "qty": 1, "entry": 2.0}
+    me._place_resting_stop(pos); first = pos["resting_stop_id"]
+    me._place_resting_stop(pos)               # branch re-entered
+    me._place_resting_stop(pos)
+    assert pos["resting_stop_id"] == first and len(b.sends("stop")) == 1 and len(b.working()) == 1
+
+def test_resting_stop_failure_does_not_null_existing(monkeypatch):
+    b = FakeBroker(held=1); dm, me, alerts, logs = _daemon_stub(b, monkeypatch)
+    pos = {"contract": C, "qty": 1, "entry": 2.0, "resting_stop_id": "o9"}; b.states["o9"] = "queued"
+    me._place_resting_stop(pos, force=False)
+    assert pos["resting_stop_id"] == "o9" and not b.sends("stop")
+
+def test_daemon_ladder_timeout_replaces_stop_for_whole_position(monkeypatch):
+    b = FakeBroker(held=2); dm, me, alerts, logs = _daemon_stub(b, monkeypatch)
+    pos = {"contract": C, "qty": 2, "entry": 2.0}
+    me._place_resting_stop(pos)
+    b.mark = lambda _id: (1.0, {"bid_price": "1.0"})
+    clk = Clock(); monkeypatch.setattr(ex.time, "monotonic", clk); monkeypatch.setattr(ex.time, "sleep", clk.sleep)
+    monkeypatch.setattr(ex, "run_ladder", (lambda f: (lambda *a, **k: f(*a, clock=clk, sleep=clk.sleep, **k)))(ex.run_ladder))
+    px, res, act = dm.Watcher._ladder_close(me, pos, 1, {}, "trim")
+    assert px is None and any("re-protecting" in a for a in alerts)
+    w = b.working(); assert len(w) == 1 and b.orders[w[0]][0] == "stop" and b.orders[w[0]][1] == 2
+    assert pos["resting_stop_id"] == w[0]
