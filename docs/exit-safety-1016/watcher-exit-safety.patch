index 0000000..1d20304
--- /dev/null
+++ b/tests/test_exitsafe.py
@@ -0,0 +1,116 @@
+import pytest
+from types import SimpleNamespace as NS
+from watcher import exitsafe as ex
+
+
+class FakeBroker:
+    def __init__(self, live=True, ready=True, fills=None):
+        self.cfg = NS(live=live); self.ready = ready; self.rs = object() if ready else None
+        self.orders, self.states, self.log = {}, {}, []
+        self.fills = fills or {}   # order seq -> fill on Nth state check
+        self.n = 0; self.pos_qty = 1
+    def _guard(self):
+        if not self.cfg.live: raise Exception("LIVE=0 — dry-run")
+    def session_valid(self): return True
+    def _new(self, kind, *a):
+        self.n += 1; oid = f"o{self.n}"; self.orders[oid] = (kind, a); self.states[oid] = "queued"; self.log.append(("send", kind, oid, a)); return {"id": oid}
+    def sell(self, c, qty, px): return self._new("sell", qty, px)
+    def place_stop_limit_close(self, c, qty, stop, lim): return self._new("stop", qty, stop, lim)
+    def cancel(self, oid): self.log.append(("cancel", oid)); self.states[oid] = "cancelled"
+    def order_state(self, oid):
+        f = self.fills.get(oid)
+        if f is not None:
+            self.fills[oid] = f - 1
+            if f <= 0: self.states[oid] = "filled"; self.pos_qty = 0
+        return self.states[oid]
+    def position_qty(self, _id): return self.pos_qty, None
+    def working(self): return [o for o, s in self.states.items() if s not in ex.TERMINAL]
+
+
+class Clock:
+    def __init__(self): self.t = 0.0
+    def __call__(self): return self.t
+    def sleep(self, s): self.t += s
+
+
+C = {"id": "opt1"}
+
+# ---- preflight ----
+def test_preflight_refuses_live_mismatch():
+    ok, why = ex.preflight_exit_path(NS(live=True), FakeBroker(live=False))
+    assert not ok and "LIVE mismatch" in why
+
+def test_preflight_refuses_dry_run_both():
+    ok, why = ex.preflight_exit_path(NS(live=False), FakeBroker(live=False))
+    assert not ok and "LIVE=0" in why
+
+def test_preflight_refuses_other_instance():
+    b = FakeBroker(); ok, why = ex.preflight_exit_path(b.cfg, b, entry_broker=FakeBroker())
+    assert not ok and "instance" in why
+
+def test_preflight_refuses_no_session():
+    b = FakeBroker(ready=False); ok, why = ex.preflight_exit_path(b.cfg, b)
+    assert not ok and "session" in why
+
+def test_preflight_refuses_missing_exit_fn():
+    b = FakeBroker(); b.sell = None; ok, why = ex.preflight_exit_path(b.cfg, b)
+    assert not ok and "sell" in why
+
+def test_preflight_ok_same_mode():
+    b = FakeBroker(); assert ex.preflight_exit_path(b.cfg, b)[0]
+
+def test_flags_default_off(monkeypatch):
+    monkeypatch.delenv("EXIT_SAFE", raising=False); assert not ex.enabled() and not ex.resting_stop_enabled()
+
+# ---- single close ----
+def test_single_close_invariant_blocks_second_send():
+    b = FakeBroker(); g = ex.CloseGuard(b, C, sleep=lambda s: None)
+    g.place_resting_stop(1, 1.20)
+    with pytest.raises(ex.ExitPathRefused): g.send("ladder", b.sell, C, 1, 1.0)
+    assert len(b.working()) == 1
+
+def test_stop_limit_price_offset():
+    assert ex.stop_limit_price(1.20) == 1.02 and ex.stop_limit_price(0.20) == 0.15
+
+# ---- resting stop cancel on other exit ----
+def test_ladder_cancels_resting_stop_first():
+    b = FakeBroker(); clk = Clock(); g = ex.CloseGuard(b, C, sleep=clk.sleep)
+    g.place_resting_stop(1, 1.20)
+    b.fills["o2"] = 1
+    st, rungs = ex.run_ladder(g, 1, lambda: 1.47, clock=clk, sleep=clk.sleep)
+    assert b.log[1] == ("cancel", "o1") and b.log[2][1] == "sell"
+    assert st == "filled" and b.working() == []
+
+def test_resting_stop_already_filled_no_second_sell():
+    b = FakeBroker(); g = ex.CloseGuard(b, C, sleep=lambda s: None)
+    g.place_resting_stop(1, 1.20); b.states["o1"] = "filled"
+    st, rungs = ex.run_ladder(g, 1, lambda: 1.0, sleep=lambda s: None)
+    assert st == "closed_by_stop" and not [l for l in b.log if l[1] == "sell"]
+    with pytest.raises(ex.ExitPathRefused): g.send("ladder", b.sell, C, 1, 1.0)
+
+# ---- ladder timing / reprice / cross ----
+def test_ladder_reprices_then_crosses():
+    b = FakeBroker(); clk = Clock(); g = ex.CloseGuard(b, C, sleep=clk.sleep)
+    bids = iter([1.47, 1.40, 1.30, 1.20, 1.14, 1.10])
+    b.fills["o4"] = 0
+    st, rungs = ex.run_ladder(g, 1, lambda: next(bids), clock=clk, sleep=clk.sleep)
+    assert st == "filled"
+    assert [r[1] for r in rungs] == [1.47, 1.40, 1.30, 1.19]
+    assert [r[2] for r in rungs] == [False, False, False, True]
+    ts = [r[0] for r in rungs]
+    assert all(2.0 <= b2 - a2 <= 3.0 for a2, b2 in zip(ts, ts[1:]))
+    assert ts[-1] >= ex.PARAMS["cross_after_s"] and ts[2] < ex.PARAMS["cross_after_s"]
+    # never more than one working close: each new rung preceded by cancel of prior
+    sends = [i for i, l in enumerate(b.log) if l[0] == "send"]
+    for i in sends[1:]: assert b.log[i - 1][0] == "cancel"
+
+def test_ladder_timeout_leaves_nothing_working():
+    b = FakeBroker(); clk = Clock(); g = ex.CloseGuard(b, C, sleep=clk.sleep)
+    st, _ = ex.run_ladder(g, 1, lambda: 1.0, clock=clk, sleep=clk.sleep)
+    assert st == "timeout" and b.working() == []
+
+def test_filled_not_flat_flagged():
+    b = FakeBroker(); clk = Clock(); g = ex.CloseGuard(b, C, sleep=clk.sleep)
+    b.fills["o1"] = 0; b.position_qty = lambda _i: (1, None)
+    st, _ = ex.run_ladder(g, 1, lambda: 1.0, clock=clk, sleep=clk.sleep)
+    assert st == "filled_not_flat"
