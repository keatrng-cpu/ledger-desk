+    b, clk, g = mk(); b.sell = lambda c, q, px: (b.log.append(("send", "sell", None, q, px)) or {"detail": "throttled"}); prot = []
+    st, _ = ex.run_ladder(g, 1, lambda: 1.0, clock=clk, sleep=clk.sleep, reprotect=prot.append)
