+    b.place_stop_limit_close = lambda c, q, s_, l: (b.log.append(("send", "stop", None, q, s_)) or {})
+    me._check_resting_stop = lambda pos, qty, et: dm.Watcher._check_resting_stop(me, pos, qty, et)
