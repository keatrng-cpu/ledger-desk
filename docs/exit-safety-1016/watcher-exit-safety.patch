+def test_resting_stop_fill_sets_lost_and_books_dayloss(monkeypatch):
+    """must-fix: a resting-stop fill books like the ladder losing exit (d['lost'], dayLoss pnl), from the ORDER fill."""
+    b = FakeBroker(held=2); dm, me, alerts, logs = _daemon_stub(b, monkeypatch)
+    monkeypatch.setattr(dm.gates, "past_flat", lambda cfg, et: False)
+    pos = {"contract": C, "qty": 2, "entry": 2.0, "filled": True, "signal": "sig-x"}
+    dm.Watcher._check_resting_stop(me, pos, 2, ET0); oid = pos["resting_stop_id"]
+    b.states[oid] = "filled"; b.order_fill = lambda o: (2, 0.95)
+    dm.Watcher._check_resting_stop(me, pos, 2, ET0)
+    d = me.state["days"]["2026-10-16"]
+    assert d["lost"] is True and d["pnl"] == round((0.95 - 2.0) * 100 * 2, 2) and pos["resting_stop_id"] is None
+    assert any(a[0] == ("day_loss_recorded",) for a in logs)
+    dm.Watcher._book_resting_stop_fill(me, pos, oid, ET0)          # booked once per order id
+    assert me.state["days"]["2026-10-16"]["pnl"] == round((0.95 - 2.0) * 200, 2)
