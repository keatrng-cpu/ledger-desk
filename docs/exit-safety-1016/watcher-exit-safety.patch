+# ---- (3) partial fills / fill during final cancel ----
+def test_partial_fill_next_rung_sells_remaining():
+    b, clk, g = mk(held=3); b.fills["o1"] = (0, 2, True); b.fills["o2"] = (0, 1, False)
+    st, rungs = ex.run_ladder(g, 3, lambda: 1.0, clock=clk, sleep=clk.sleep)
+    assert st == "filled" and [s[3] for s in b.sends("sell")] == [3, 1] and b.held == 0
+def test_fill_during_final_cancel_counts_filled():
+    b, clk, g = mk(); prot = []; orig = b.cancel   # only the cancel issued after the 20 s cap races into a fill
+    def cancel(oid):
+        if clk.t > ex.PARAMS["max_ladder_s"]: b.fill_on_cancel.add(oid)
+        orig(oid)
+    b.cancel = cancel
+    st, _ = ex.run_ladder(g, 1, lambda: 1.0, clock=clk, sleep=clk.sleep, reprotect=prot.append)
+    assert st == "filled" and prot == [] and b.held == 0
