+import json, os, pytest
+from types import SimpleNamespace as NS
+from watcher import exitsafe as ex
+
+
+class FakeBroker:
+    """Fake RH: orders, states, a position qty. fills[oid] = (checks_before_fill, qty_filled, partial_only)."""
+    def __init__(self, live=True, ready=True, held=1):
+        self.cfg = NS(live=live); self.ready = ready; self.rs = object() if ready else None
+        self.orders, self.states, self.log = {}, {}, []
+        self.fills = {}; self.n = 0; self.held = held
+        self.fill_on_cancel = set(); self.raise_on_sell = None
+    def _guard(self):
+        if not self.cfg.live: raise Exception("LIVE=0 — dry-run")
+    def session_valid(self): return True
+    def _new(self, kind, qty, *a):
+        self.n += 1; oid = f"o{self.n}"; self.orders[oid] = (kind, qty, a); self.states[oid] = "queued"
+        self.log.append(("send", kind, oid, qty, a)); return {"id": oid}
+    def sell(self, c, qty, px):
+        if self.raise_on_sell: raise self.raise_on_sell
+        return self._new("sell", qty, px)
+    def place_stop_limit_close(self, c, qty, stop, lim): return self._new("stop", qty, stop, lim)
+    def _fill(self, oid, q):
+        self.held -= q; self.orders[oid] = self.orders[oid][:1] + (self.orders[oid][1] - q,) + self.orders[oid][2:]
+    def cancel(self, oid):
+        self.log.append(("cancel", oid))
+        if oid in self.fill_on_cancel:
+            self._fill(oid, self.orders[oid][1]); self.states[oid] = "filled"
+        else: self.states[oid] = "cancelled"
+    def order_state(self, oid):
+        f = self.fills.get(oid)
+        if f is not None and self.states[oid] not in ex.TERMINAL:
+            n, q, partial = f
+            if n <= 0:
+                self._fill(oid, q); del self.fills[oid]
+                self.states[oid] = "partially_filled" if partial else "filled"
+            else: self.fills[oid] = (n - 1, q, partial)
+        return self.states[oid]
+    def position_qty(self, _id): return self.held, None
+    def working(self): return [o for o, s in self.states.items() if s not in ex.TERMINAL]
+    def sends(self, kind=None): return [l for l in self.log if l[0] == "send" and (kind is None or l[1] == kind)]
+
+
+class Clock:
+    def __init__(self): self.t = 0.0
+    def __call__(self): return self.t
+    def sleep(self, s): self.t += s
+
+
+C = {"id": "opt1"}
+def mk(held=1):
+    b = FakeBroker(held=held); clk = Clock(); return b, clk, ex.CloseGuard(b, C, sleep=clk.sleep)
+
+# ---- preflight ----
+def test_preflight_refuses_live_mismatch():
+    ok, why = ex.preflight_exit_path(NS(live=True), FakeBroker(live=False)); assert not ok and "LIVE mismatch" in why
+def test_preflight_refuses_dry_run_both():
+    ok, why = ex.preflight_exit_path(NS(live=False), FakeBroker(live=False)); assert not ok and "LIVE=0" in why
+def test_preflight_refuses_other_instance():
+    b = FakeBroker(); ok, why = ex.preflight_exit_path(b.cfg, b, entry_broker=FakeBroker()); assert not ok and "instance" in why
+def test_preflight_refuses_no_session():
+    b = FakeBroker(ready=False); ok, why = ex.preflight_exit_path(b.cfg, b); assert not ok and "session" in why
+def test_preflight_refuses_missing_exit_fn():
+    b = FakeBroker(); b.sell = None; ok, why = ex.preflight_exit_path(b.cfg, b); assert not ok and "sell" in why
+def test_preflight_ok_same_mode():
+    b = FakeBroker(); assert ex.preflight_exit_path(b.cfg, b)[0]
+def test_flags_default_off(monkeypatch):
+    monkeypatch.delenv("EXIT_SAFE", raising=False); monkeypatch.delenv("EXIT_SAFE_RESTING_STOP", raising=False)
+    assert not ex.enabled() and not ex.resting_stop_enabled()
+    monkeypatch.setenv("EXIT_SAFE", "1"); assert ex.enabled() and not ex.resting_stop_enabled()   # (1) resting stop stays off
+
+# ---- single close ----
+def test_single_close_invariant_blocks_second_send():
+    b, clk, g = mk(); g.place_resting_stop(1, 1.20)
+    with pytest.raises(ex.ExitPathRefused): g.send("ladder", b.sell, C, 1, 1.0)
+    assert len(b.working()) == 1
+def test_stop_limit_price_offset():
+    assert ex.stop_limit_price(1.20) == 1.02 and ex.stop_limit_price(0.20) == 0.15
+
+# ---- resting stop cancel on other exit ----
+def test_ladder_cancels_resting_stop_first():
+    b, clk, g = mk(); g.place_resting_stop(1, 1.20); b.fills["o2"] = (1, 1, False)
+    st, rungs = ex.run_ladder(g, 1, lambda: 1.47, clock=clk, sleep=clk.sleep)
+    assert b.log[1] == ("cancel", "o1") and b.log[2][1] == "sell"
+    assert st == "filled" and b.working() == [] and b.held == 0
+def test_resting_stop_already_filled_no_second_sell():
+    b, clk, g = mk(); g.place_resting_stop(1, 1.20); b.states["o1"] = "filled"; b.held = 0
+    st, _ = ex.run_ladder(g, 1, lambda: 1.0, clock=clk, sleep=clk.sleep)
+    assert st == "closed_by_stop" and not b.sends("sell")
+    with pytest.raises(ex.ExitPathRefused): g.send("ladder", b.sell, C, 1, 1.0)
+
+# ---- ladder timing / reprice / cross ----
+def test_ladder_reprices_then_crosses():
+    b, clk, g = mk(); bids = iter([1.47, 1.40, 1.30, 1.20, 1.14, 1.10]); b.fills["o4"] = (0, 1, False)
+    st, rungs = ex.run_ladder(g, 1, lambda: next(bids), clock=clk, sleep=clk.sleep)
+    assert st == "filled" and [r[1] for r in rungs] == [1.47, 1.40, 1.30, 1.19]
+    assert [r[2] for r in rungs] == [False, False, False, True]
+    ts = [r[0] for r in rungs]
+    assert all(2.0 <= y - x <= 3.0 for x, y in zip(ts, ts[1:])) and ts[2] < 6 <= ts[-1]
+    sends = [i for i, l in enumerate(b.log) if l[0] == "send"]
+    for i in sends[1:]: assert b.log[i - 1][0] == "cancel"
