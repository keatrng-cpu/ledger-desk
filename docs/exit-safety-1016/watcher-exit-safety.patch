+# ---- (2) timeout re-protects ----
+def test_ladder_timeout_reprotects_and_leaves_one_close():
+    b, clk, g = mk(held=2); prot = []
+    def reprotect(rem): prot.append(rem); g.place_resting_stop(rem, 1.0)
+    st, _ = ex.run_ladder(g, 2, lambda: 1.0, clock=clk, sleep=clk.sleep, reprotect=reprotect)
+    assert st == "timeout" and prot == [2]
+    assert [b.orders[o][0] for o in b.working()] == ["stop"]       # exactly one working close: the new stop
+def test_ladder_timeout_without_reprotect_flags_unprotected():
+    b, clk, g = mk(); st, _ = ex.run_ladder(g, 1, lambda: 1.0, clock=clk, sleep=clk.sleep)
+    assert st == "timeout" and b.working() == []
