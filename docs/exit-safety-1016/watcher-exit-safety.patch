index 0000000..abb8277
--- /dev/null
+++ b/watcher/exitsafe.py
@@ -0,0 +1,259 @@
+"""Exit safety (Keaton 2026-10-16, after the QQQ put: entry went out LIVE, exit script ran LIVE=0, -$30 stop became -$96).
+
+Three pieces, all behind EXIT_SAFE=1 (default OFF -> behaviour unchanged, desk rules hash unchanged):
+  0. preflight_exit_path(): refuse ANY entry unless the exit path is live in the SAME mode as the entry.
+  1. resting broker stop (stop-limit sell-to-close) placed after a fill; cancelled + confirmed before any other close.
+  2. exit ladder: limit at bid, re-price to fresh bid every ~2.5 s, cross to marketable after ~6 s, one working close max.
+Single-close invariant: CloseGuard is the ONLY way a close order is sent; it never allows two working closes.
+Pure logic is injectable (clock/sleep/broker) so it is unit-tested without RH.
+"""
+import os, time
+
+PARAMS = {  # mirrored in ledger-desk shared/exit-safe.json (NOT desk-rules.json -> RULES_HASH unchanged)
+    "reprice_s": 2.5, "cross_after_s": 6.0, "max_ladder_s": 20.0, "tick": 0.01,
+    "stop_limit_offset_pct": 0.15, "stop_limit_offset_min": 0.05, "flat_confirm_tries": 5,
+}
+
+def enabled():
+    return os.environ.get("EXIT_SAFE", "0").strip().lower() in ("1", "true", "yes", "on")
+
+def resting_stop_enabled():
+    return enabled() and os.environ.get("EXIT_SAFE_RESTING_STOP", "0").strip().lower() in ("1", "true", "yes", "on")
+
+
+class ExitPathRefused(Exception):
+    pass
+
+
+class NoOrderId(ExitPathRefused):
+    """Broker returned no order id: the order MAY be live at RH. Never re-send; stop + alert (manual)."""
+
+
+def preflight_exit_path(cfg, broker, entry_broker=None):
+    """(ok, reason). Entry is allowed only if the exit path would go out in the same mode as the entry."""
+    eb = entry_broker if entry_broker is not None else broker
+    if eb is not broker:
+        return False, "exit broker instance differs from entry broker instance"
+    bl = getattr(getattr(broker, "cfg", cfg), "live", None)
+    if bool(bl) != bool(cfg.live):
+        return False, f"LIVE mismatch: entry cfg.live={cfg.live} exit broker.cfg.live={bl}"
+    if not cfg.live:
+        return False, "LIVE=0: exit path is dry-run -> refuse entry"
+    for fn in ("sell", "cancel", "order_state", "position_qty"):
+        if not callable(getattr(broker, fn, None)):
+            return False, f"exit function broker.{fn} not callable"
+    if not getattr(broker, "ready", False) or getattr(broker, "rs", None) is None:
+        return False, "broker session not ready (not logged in)"
+    try:
+        guard = getattr(broker, "_guard", None)
+        if callable(guard):
+            guard()          # same STOP / LIVE / account guard the sell will hit
+    except Exception as e:
+        return False, f"exit guard would refuse: {e}"
+    chk = getattr(broker, "session_valid", None)
+    if callable(chk):
+        try:
+            if not chk():
+                return False, "broker session invalid"
+        except Exception as e:
+            return False, f"session check failed: {e}"
+    if resting_stop_enabled() and not callable(getattr(broker, "place_stop_limit_close", None)):
+        return False, "resting stop enabled but broker.place_stop_limit_close missing"
+    return True, "exit path live, same mode/instance as entry"
+
+
+def stop_limit_price(stop, p=PARAMS):
+    off = max(p["stop_limit_offset_min"], round(stop * p["stop_limit_offset_pct"], 2))
+    return round(max(0.01, stop - off), 2)
+
+
+def _oid(res):
+    return res.get("id") if isinstance(res, dict) else None
+
+
+TERMINAL = {"filled", "cancelled", "canceled", "rejected", "failed", "expired"}
+
+
+class CloseGuard:
+    """Owns every close order for one position. At most ONE working close order at any time
+    (resting stop counts as a working close)."""
+
+    def __init__(self, broker, contract, log=lambda *a, **k: None, sleep=time.sleep):
+        self.b, self.c, self.log, self.sleep = broker, contract, log, sleep
+        self.working = None          # (kind, order_id)
+        self.closed = False
+        self.history = []            # every (kind, order_id) this guard sent: fills are booked per ORDER (filled qty / avg)
+
+    def _wait_terminal(self, oid, tries=10):
+        st = None
+        for _ in range(tries):
+            st = self.b.order_state(oid)
+            if st in TERMINAL:
+                return st
+            self.sleep(0.3)
+        return st
+
+    def clear(self):
+        """Cancel the working close (stop or ladder rung) and CONFIRM it is terminal before anything else is sent.
+        Returns the terminal state; 'filled' means the position closed via that order."""
+        if not self.working:
+            return None
+        kind, oid = self.working
+        st = self.b.order_state(oid) if oid else "cancelled"
+        if st not in TERMINAL:
+            self.b.cancel(oid)
+            st = self._wait_terminal(oid)
+        if st not in TERMINAL:
+            raise ExitPathRefused(f"working {kind} {oid} not confirmed terminal ({st}); refusing a second close")
+        self.working = None
+        if st == "filled":
+            self.closed = True
+        self.log("close_cleared", kind=kind, order_id=oid, state=st)
+        return st
+
+    def send(self, kind, fn, *a):
+        if self.closed:
+            raise ExitPathRefused("position already closed; no further close orders")
+        if self.working:
+            raise ExitPathRefused(f"single-close invariant: {self.working[0]} already working")
+        res = fn(*a)
+        oid = _oid(res)
+        if not oid:
+            raise NoOrderId(f"{kind} returned no order id ({str(res)[:120]}); not re-sending — manage manually")
+        self.working = (kind, oid)
+        self.history.append((kind, oid))
+        return res
+
+    def place_resting_stop(self, qty, stop):
+        lim = stop_limit_price(stop)
+        res = self.send("stop", self.b.place_stop_limit_close, self.c, qty, round(stop, 2), lim)
+        self.log("resting_stop_placed", stop=round(stop, 2), limit=lim, order_id=_oid(res))
+        return res
+
+
+def run_ladder(guard, qty, fresh_bid, clock=time.monotonic, sleep=time.sleep, p=PARAMS, log=lambda *a, **k: None,
+               reprotect=None, wall=time.time, stopped=lambda: False):
+    """Sell-to-close ladder. Cancels any resting stop first (exactly one working close). Returns (status, rungs).
+    rungs: list of (t, price, crossed, qty). Cross after cross_after_s = bid - tick.
+    * position_qty is re-read before EVERY rung; each rung sells only the remaining qty (target = start_qty - qty).
+    * A fill during any cancel (incl. the final one) counts as filled.
+    * Hard deadline: max_ladder_s on the monotonic clock AND max_ladder_s + 3 s wall clock, checked in both loops.
+    * STOP file checked every iteration: ladder halts, sends nothing more ("kill_switch"; cancel is also refused by
+      the broker guard under STOP -> manual).
+    * Never raises. Statuses and protection:
+        filled / filled_not_flat / closed_by_stop / already_closed  -> done
+        timeout / error (working close confirmed gone)              -> reprotect(remaining) (resting stop or alert)
+        no_order_id  (sell returned no id; it may be live)          -> NO re-send, NO reprotect (would risk 2 closes); alert
+        stuck_working (a close would not confirm cancelled)         -> NO new order; alert
+        kill_switch                                                 -> nothing sent; alert
+    BLOCKS the caller up to ~max_ladder_s + 3 s (20 s default); the daemon loop pauses meanwhile."""
+    rungs = []
+    pid = guard.c.get("id")
+    st_ = {"remaining": qty}
+
+    def held():
+        q, _a = guard.b.position_qty(pid); return int(q or 0)
+
+    def protect(status, remaining):
+        if remaining > 0 and reprotect is not None:
+            try: reprotect(remaining)
+            except Exception as e: log("reprotect_failed", reason=str(e))
+        return status, rungs
+
+    try:
+        start = held()
+        target = max(0, start - qty)
+        def remaining():
+            r = max(0, held() - target); st_["remaining"] = r; return r
+        t0, w0 = clock(), wall()
+        expired = lambda: clock() - t0 > p["max_ladder_s"] or wall() - w0 > p["max_ladder_s"] + 3
+        st = guard.clear()
+        if st == "filled" or guard.closed:
+            if remaining() <= 0: return ("closed_by_stop" if st == "filled" else "already_closed"), rungs
+            guard.closed = False             # stop partially filled: ladder the rest
+        while True:
+            if stopped():
+                log("ladder_kill_switch", working=guard.working); return "kill_switch", rungs
+            t = clock() - t0
+            if expired():
+                st = guard.clear()
+                rem = remaining()
+                if st == "filled" or rem <= 0:
+                    guard.closed = True; return "filled", rungs
+                return protect("timeout", rem)
+            bid = fresh_bid()
+            if not bid or bid <= 0:
+                sleep(0.5); continue
+            if guard.working:
+                guard.clear()
+            rem = remaining()                # fresh RH position before every rung
+            if rem <= 0:
+                guard.closed = True
+                return ("filled" if confirm_flat_target(guard.b, pid, target, sleep=sleep, p=p) else "filled_not_flat"), rungs
+            guard.closed = False
+            crossed = t >= p["cross_after_s"]
+            px = round(max(0.01, bid - p["tick"]) if crossed else bid, 2)
+            guard.send("ladder", guard.b.sell, guard.c, rem, px)
+            rungs.append((round(t, 2), px, crossed, rem))
+            log("ladder_rung", t=round(t, 2), px=px, crossed=crossed, qty=rem)
+            nxt = clock() + p["reprice_s"]
+            while clock() < nxt and not expired():
+                if stopped(): break
+                oid = guard.working[1] if guard.working else None
+                if oid and guard.b.order_state(oid) == "filled":
+                    guard.working = None
+                    if remaining() <= 0:
+                        guard.closed = True
+                        return ("filled" if confirm_flat_target(guard.b, pid, target, sleep=sleep, p=p) else "filled_not_flat"), rungs
+                    break
+                sleep(0.25)
+    except NoOrderId as e:
+        log("ladder_no_order_id", reason=str(e)); return "no_order_id", rungs
+    except Exception as e:
+        log("ladder_error", reason=str(e))
+        if guard.working:
+            try: guard.clear()
+            except Exception as e2:
+                log("ladder_stuck", reason=str(e2)); return "stuck_working", rungs
+        try: rem = remaining()
+        except Exception: rem = st_["remaining"]
+        if guard.closed and rem <= 0: return "filled", rungs
+        return protect("error", rem)
+
+
+def confirm_flat_target(broker, pid, target, sleep=time.sleep, p=PARAMS):
+    for _ in range(p["flat_confirm_tries"]):
+        q, _avg = broker.position_qty(pid)
+        if int(q or 0) <= target:
+            return True
+        sleep(0.4)
+    return False
+
+
+def confirm_flat(broker, contract, sleep=time.sleep, p=PARAMS):
+    for _ in range(p["flat_confirm_tries"]):
+        q, _avg = broker.position_qty(contract["id"])
+        if q == 0:
+            return True
+        sleep(0.4)
+    return False
+
+
+def fills_vwap(broker, oids):
+    """(filled_qty, vwap) over the given close orders, read from each ORDER (not the lagged RH position).
+    Accuracy should-fix 10/16: booking every ladder fill at the LAST rung price undercounted a trim whose early rungs
+    filled higher. Orders whose fill cannot be read are skipped (qty 0). Never raises."""
+    tq, tv = 0, 0.0
+    for oid in oids:
+        try: q, avg = broker.order_fill(oid)
+        except Exception: continue
+        if q and avg: tq += int(q); tv += int(q) * float(avg)
+    return tq, (round(tv / tq, 4) if tq else None)
+
+
+def clamp_stop_below_bid(stop, bid, p=PARAMS):
+    """A re-placed sell stop at/above the current bid triggers (or is rejected) on arrival. Clamp it one tick under the
+    bid so a re-place never becomes an instant market-out; returns (stop, clamped)."""
+    if bid and bid > 0 and stop >= bid:
+        return round(max(0.01, bid - p["tick"]), 2), True
+    return round(stop, 2), False
