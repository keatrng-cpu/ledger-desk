+    if isinstance(feat.get("v2"), dict) and isinstance(feat.get("gbm"), dict): partial = partial_label(feat["v2"], feat["gbm"])
+    elif "partial" in c: partial = c.get("partial")
+    else: partial = "partial: unknown (no feature vector)"
