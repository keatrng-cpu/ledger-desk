+"""combo1016: watcher half of the SMC research best combo (TS twin src/lib/smc/combo1016.ts, rules combo1016 + score1016.v2).
+SHADOW ONLY: rows are logged as shadow:combo1016:<item> with status True, so they never gate. Nothing here changes a fire or a size.
+
+- read:        re-computes S2 (score1016.v2) and gbmP from the card's feature vector and flags drift vs the desk's own numbers.
+- would_fire:  S2 >= fireS2 AND gbmP >= gbm.thr (IS 90th pct). a_plus: S2 >= aPlusS2, logged only (aPlusSizing false).
+- ledger:      shadow day ledger in state_day["combo1016"]: caps 3/day, 2/symbol; halt after the first loss; a setup id seals
+               its entry once (never re-priced); a re-arm needs a NEW setup id. Outcomes resolve from the tape price
+               (stop before T1 = loss; T1 then BE stop = scratch; T2 = win)."""
+import json, math, os, hashlib
+from .gates import RULES
+
+CB = RULES.get("combo1016") or {}
+V2 = (RULES.get("score1016") or {}).get("v2") or {}
+_GP = os.path.join(os.path.dirname(__file__), "combo1016-gbm.json")
+_RAW = open(_GP, "rb").read()
+GBM = json.loads(_RAW)
+GBM_SHA_OK = hashlib.sha256(_RAW).hexdigest()[:16] == ((CB.get("gbm") or {}).get("sha256_16"))
+THR = float((CB.get("gbm") or {}).get("thr", GBM["thr_is_p90"]))
+FIRE_S2 = float(CB.get("fireS2", 75)); APLUS_S2 = float(CB.get("aPlusS2", 90))
+LAYERS = {"context": ["ctx_htf4", "ctx_lowvol", "ctx_pd"], "liquidity": ["liq_tier", "liq_n", "liq_smt"], "displacement": ["disp", "mss", "ifvg"],
+          "entry": ["ent_tight", "ent_nochase", "ent_arr_fvg"], "timing": ["tim_early", "tim_rng30"]}
+
+def mode(k=None):
+    blk = CB if k is None else (CB.get(k) or {})
+    return "live" if blk.get("mode") == "live" else "shadow"
+
+def _f(v):
+    try: v = float(v)
+    except (TypeError, ValueError): return None
+    return v if math.isfinite(v) else None
+
+def _cl(x): return max(0.0, min(1.0, x))
+
+def subfactors(x):
+    g = lambda k: _f(x.get(k)); b = lambda k: None if x.get(k) is None else (1.0 if x.get(k) else 0.0)
+    t4, ap, pd, wt, nk, ds, ra, ch, ai, tm, rg = (g(k) for k in ("tr4h_with", "atrpct", "pd", "wtmax", "nk", "disp", "risk_atr", "chaseR", "arr_ifvg", "tmin", "rng30"))
+    return {"ctx_htf4": None if t4 is None else (1.0 if t4 > 0 else 0.0), "ctx_lowvol": 1 - (ap if ap is not None else 0.5), "ctx_pd": None if pd is None else 1 - _cl(pd),
+            "liq_tier": wt, "liq_n": None if nk is None else _cl((nk - 1) / 3), "liq_smt": b("smt"),
+            "disp": None if ds is None else _cl(ds / 3), "mss": b("mss"), "ifvg": b("ifvg"),
+            "ent_tight": None if ra is None else 1 - _cl(ra / 3), "ent_nochase": 1 - _cl(ch if ch is not None else 1), "ent_arr_fvg": None if ai is None else 1 - ai,
+            "tim_early": None if tm is None else 1 - _cl((tm - 510) / 360), "tim_rng30": None if rg is None else _cl(rg / 8)}
+
+def _interp(z, X, Y):
+    if z <= X[0]: return Y[0]
+    if z >= X[-1]: return Y[-1]
+    lo, hi = 0, len(X) - 1
+    while hi - lo > 1:
+        m = (lo + hi) // 2
+        if X[m] <= z: lo = m
+        else: hi = m
+    return Y[hi] if X[hi] == X[lo] else Y[lo] + (Y[hi] - Y[lo]) * (z - X[lo]) / (X[hi] - X[lo])
+
+def score_v2(x):
+    sf = subfactors(x); z = V2["intercept"]
+    for ks in LAYERS.values():
+        for k in ks:
+            v = sf[k]
+            z += V2["coef"][k] * (V2["medians"][k] if v is None else v)
+    return 100 * _cl((z - V2["lo"]) / (V2["hi"] - V2["lo"])), _interp(z, V2["isoX"], V2["isoY"])
+
+def _leaf(n, x):
+    while "v" not in n:
+        v = x[n["f"]]; nan = v is None
+        if n["m"] == 2 and nan: left = n["d"] == 1
+        elif n["m"] == 1 and (nan or v == 0): left = n["d"] == 1
+        else: left = (0.0 if nan else v) <= n["t"]
+        n = n["l"] if left else n["r"]
+    return n["v"]
+
+def gbm_p(feat):
+    x = [_f((feat or {}).get(k)) for k in GBM["features"]]
+    return 1 / (1 + math.exp(-sum(_leaf(t, x) for t in GBM["trees"])))
+
+def admit(day, symbol, setup_id, plan, side, now_ms):
+    ents = day.setdefault("entries", [])
+    prev = next((e for e in ents if e.get("setupId") == setup_id), None)
+    if prev: return False, f"setup {setup_id} already sealed at {prev.get('entry')} (no re-price; re-arm needs a new setup id)", prev
+    caps = CB.get("caps") or {}
+    losses = sum(1 for e in ents if e.get("result") == "loss")
+    if losses >= int(caps.get("haltAfterLosses", 1)): return False, f"halted for the day after {losses} loss", None
+    n = len(ents); ns = sum(1 for e in ents if e.get("symbol") == symbol)
+    if n >= int(caps.get("perDay", 3)): return False, f"day cap {n}/{caps.get('perDay', 3)}", None
+    if ns >= int(caps.get("perSymbol", 2)): return False, f"{symbol} cap {ns}/{caps.get('perSymbol', 2)}", None
+    e = {"setupId": setup_id, "symbol": symbol, "side": side, "kind": plan.get("kind"), "entry": plan.get("entry"), "stop": plan.get("stop"),
+         "t1": plan.get("t1"), "t2": plan.get("t2"), "sealedAt": now_ms, "t1hit": False, "result": None}
+    ents.append(e)
+    return True, f"slot {n + 1}/{caps.get('perDay', 3)}, {symbol} {ns + 1}/{caps.get('perSymbol', 2)}", e
+
+def resolve(day, prices):
+    """Advance open shadow entries on the tape price (limit entries count only once price trades through the edge)."""
+    out = []
+    for e in day.get("entries", []):
+        if e.get("result") is not None: continue
+        px = _f((prices or {}).get(e.get("symbol"))); s = 1 if e.get("side") == "long" else -1
+        if px is None or e.get("entry") is None: continue
+        if e.get("kind") == "limit" and not e.get("filled"):
+            if s * (px - e["entry"]) <= 0: e["filled"] = True
+            else: continue
+        stop = e["entry"] if e.get("t1hit") and (CB.get("exit") or {}).get("beAfterT1", True) else e["stop"]
+        if s * (px - stop) <= 0: e["result"] = "be" if e.get("t1hit") else "loss"
+        elif s * (px - e["t2"]) >= 0: e["result"] = "win"
+        elif not e.get("t1hit") and s * (px - e["t1"]) >= 0: e["t1hit"] = True
+        if e.get("result"): out.append(e)
+    return out
+
+def shadow_rows(snap, state_day=None, now_ms=0):
+    c = snap.get("combo1016") or {}
+    if not isinstance(c, dict) or "S2" not in c: return []
+    rows = []; feat = c.get("feat") or {}
+    head = f"S2 {c.get('S2')} p {c.get('p')} gbmP {c.get('gbmP')}/{c.get('thr')} grade {c.get('grade')} src {c.get('src')}"
+    if isinstance(feat.get("v2"), dict) and isinstance(feat.get("gbm"), dict):
+        s2, _ = score_v2(feat["v2"]); g = gbm_p(feat["gbm"])
+        fire_w = s2 >= FIRE_S2 and g >= THR
+        drift = abs(s2 - float(c.get("S2") or 0)) > 0.06 or abs(g - float(c.get("gbmP") or 0)) > 1e-4 or fire_w != bool(c.get("fire"))
+        head += f" | watcher S2 {s2:.1f} gbmP {g:.4f}{' DRIFT' if drift else ''}{'' if GBM_SHA_OK else ' GBM-SHA-MISMATCH'}"
+    plan = c.get("plan") or {}
+    if c.get("wouldFire"):
+        rows.append(("shadow:combo1016:would_fire", True, f"WOULD FIRE {snap.get('symbol')} {snap.get('side')} {plan.get('kind')} {plan.get('entry')} stop {plan.get('stop')} "
+                     f"T1 {plan.get('t1')} ({plan.get('partialFrac')}) -> BE -> T2 {plan.get('t2')} setup {c.get('setupId')} | {head}"))
+        if c.get("aPlus"): rows.append(("shadow:combo1016:a_plus", True, f"A+ (S2 >= {APLUS_S2:g}) logged only, no sizing change | {head}"))
+        if state_day is not None and c.get("setupId"):
+            day = state_day.setdefault("combo1016", {})
+            ok, why, _ = admit(day, snap.get("symbol"), c.get("setupId"), plan, snap.get("side"), now_ms)
+            rows.append(("shadow:combo1016:ledger", True, ("ADMIT " if ok else "BLOCK ") + why))
+    else:
+        rows.append(("shadow:combo1016:read", True, head))
+    if state_day is not None and (state_day.get("combo1016") or {}).get("entries"):
+        for e in resolve(state_day["combo1016"], snap.get("tape_prices")):
+            rows.append(("shadow:combo1016:result", True, f"{e['setupId']} {e['result']} (entry {e['entry']} stop {e['stop']} T1 {e['t1']} T2 {e['t2']})"))
+    return rows
