+        tier = "A+" if s2 >= APLUS_S2 else "base"
+        why = None if f else ("hard_veto" if vetoed else "below_s2" if s2 < float(ARMS[k]["fireS2"]) else "below_gbm")
+        o = rd.get("opt") or {}
