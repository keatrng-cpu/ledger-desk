+"""combo1016 arms: SMC pnl-push finalists config1_trail/config2_e75/config3_e75_s65/config2_e75_tier200_400 (shadow only). Twin of src/lib/smc/combo1016-arms.ts.
+Logs shadow:combo1016:<arm>:read / would_fire / would_fire_partial / a_plus / ledger / result rows (status True, never gates).
+Fire is recomputed from the card's S2/gbmP against the shared rules; the shadow day ledger lives in state_day["combo1016_arms"][arm]."""
+import datetime as _dt, hashlib, json, math, os
+from .combo1016 import RULES, LAYERS, subfactors, _leaf
+
+AB0 = RULES.get("combo1016Arms") or {}
+_AP = os.path.join(os.path.dirname(__file__), "combo1016-arms-gbm.json")
+_ARAW = open(_AP, "rb").read()
+AGBM = json.loads(_ARAW)
+AGBM_SHA_OK = hashlib.sha256(_ARAW).hexdigest()[:16] == (AB0.get("gbm") or {}).get("sha256_16")
+THR = float((AB0.get("gbm") or {}).get("thr", AGBM["thr_q90"]))
+S2P = AB0.get("s2") or {}
+
+def arms_s2(x):
+    """SMC walk-forward S2 (rules combo1016Arms.s2) on the score1016.v2 subfactors; missing subfactors take the window medians."""
+    sf = subfactors(x or {}); z = S2P["intercept"]
+    for ks in LAYERS.values():
+        for k in ks:
+            v = sf[k]
+            if k == "ctx_htf4" and (x or {}).get("tr4h_with") is None: v = 0.0   # research: (NaN > 0) = False -> 0, not the median
+            z += S2P["coef"][k] * (S2P["medians"][k] if v is None else v)
+    return 100 * max(0.0, min(1.0, (z - S2P["lo"]) / (S2P["hi"] - S2P["lo"])))
+
+def arms_gbm_p(feat):
+    def f(v):
+        try: v = float(v)
+        except (TypeError, ValueError): return None
+        return v if math.isfinite(v) else None
+    x = [f((feat or {}).get(k)) for k in AGBM["features"]]
+    return 1 / (1 + math.exp(-sum(_leaf(t, x) for t in AGBM["trees"])))
+
+AB = RULES.get("combo1016Arms") or {}
+ARMS = AB.get("arms") or {}
+CAPS = AB.get("caps") or {}
+ENT = AB.get("entry") or {}
+APLUS_S2 = float(AB.get("aPlusS2", 85))
+try:
+    from zoneinfo import ZoneInfo
+    _CT = ZoneInfo("America/Chicago")
+except Exception:  # pragma: no cover
+    _CT = None
+
+def _f(v):
+    try:
+        x = float(v)
+        return x if x == x and abs(x) != float("inf") else None
+    except (TypeError, ValueError):
+        return None
+
+def flat_min():
+    h, m = str(CAPS.get("flatByCt", "14:55")).split(":"); return int(h) * 60 + int(m)
+
+def ct_min(now_ms):
+    d = _dt.datetime.fromtimestamp(now_ms / 1000, _CT) if _CT else _dt.datetime.utcfromtimestamp(now_ms / 1000 - 5 * 3600)
+    return d.hour * 60 + d.minute
+
+def fire(key, s2, gbmp, vetoed=False):
+    a = ARMS[key]; f = (not vetoed) and s2 >= float(a["fireS2"]) and gbmp >= THR
+    ap = f and s2 >= APLUS_S2
+    return f, ap, float(a["sizing"]["aPlusUsdPerR" if ap else "baseUsdPerR"])
+
+def plan(key, side, price, edge, stop):
+    a = ARMS[key]; ex = a["exit"]; S = side == "short"; d = -1 if S else 1
+    rm = abs(stop - price)   # research chaseR denominator: the MARKET anchor's risk (eng.py), not riskEdge
+    if not rm > 0 or (stop <= price if S else stop >= price) or (stop <= edge if S else stop >= edge): return None
+    chase = abs(price - edge) / rm
+    mkt = chase <= float(ENT.get("marketWithinR", 1.0)); e = price if mkt else edge; r = abs(stop - e)
+    legs = [{"frac": ex["t1PartialFrac"], "R": ex["t1R"], "px": e + d * ex["t1R"] * r}]
+    if ex["mode"] == "E75": legs.append({"frac": 1 - ex["t1PartialFrac"], "R": ex["t2R"], "px": e + d * ex["t2R"] * r})
+    return {"arm": key, "mode": ex["mode"], "kind": "market" if mkt else "limit", "entry": e, "stop": stop, "risk": r, "chaseR": round(chase, 3), "legs": legs,
+            "trailR": ex.get("trailR", 1.0) if ex["mode"] == "TR" else None, "limitValidMin": None if mkt else ENT.get("limitValidMin", 20),
+            "cancelPx": None if mkt else e + d * float(ENT.get("cancelAtR", 0.75)) * r}
+
+def _trades(ents): return [e for e in ents if e.get("result") not in ("cancel", "expired")]
+
+def admit(key, day, symbol, setup_id, p, side, usd, now_ms):
+    ents = day.setdefault("entries", [])
+    prev = next((e for e in ents if e.get("setupId") == setup_id), None)
+    if prev: return False, f"{key}: setup {setup_id} already sealed at {prev.get('entry')} (re-arm needs a new setup id)", prev
+    tr = _trades(ents); losses = sum(1 for e in tr if e.get("result") == "loss")
+    if losses >= int(CAPS.get("haltAfterLosses", 1)): return False, f"{key}: halted for the day after {losses} loss", None
+    n = len(tr); ns = sum(1 for e in tr if e.get("symbol") == symbol); op = sum(1 for e in tr if e.get("symbol") == symbol and e.get("open"))
+    if n >= int(CAPS.get("perDay", 5)): return False, f"{key}: day cap {n}/{CAPS.get('perDay', 5)}", None
+    if ns >= int(CAPS.get("perSymbol", 3)): return False, f"{key}: {symbol} cap {ns}/{CAPS.get('perSymbol', 3)}", None
+    if op >= int(CAPS.get("openPerSymbol", 1)): return False, f"{key}: {symbol} already has {op} open", None
+    e = {"setupId": setup_id, "symbol": symbol, "side": side, "mode": p.get("mode") or ARMS[key]["exit"]["mode"], "kind": p.get("kind", "market"), "entry": p["entry"], "stop": p["stop"], "risk": p["risk"] or abs(p["entry"] - p["stop"]),
+         "legs": p["legs"], "trailR": p.get("trailR"), "cancelPx": p.get("cancelPx"), "usdPerR": usd, "sealedAt": now_ms, "open": True, "filled": p["kind"] == "market",
+         "t1hit": False, "mfeR": 0.0, "R": 0.0, "rem": 1.0, "result": None}
+    ents.append(e)
+    return True, f"{key}: slot {n + 1}/{CAPS.get('perDay', 5)}, {symbol} {ns + 1}/{CAPS.get('perSymbol', 3)}", e
+
+TICK = 0.25   # ES, MES, NQ, MNQ
+def _net(e): return e["R"] - float(AB.get("costTicks", 2)) * TICK / e["risk"]
+
+def resolve(day, prices, now_ms):
+    """Advance open entries on the tape price per poll. Returns (event, entry, extra) tuples:
+    fill (limit traded), leg (target hit), close (stop / runner / 14:55 flat; netR after 2 ticks), skip played_out (+0.75R before the fill) / no_fill (20 min)."""
+    ev = []; late = ct_min(now_ms) >= flat_min()
+    for e in day.get("entries", []):
+        if not e.get("open"): continue
+        px = _f((prices or {}).get(e.get("symbol"))); s = 1 if e["side"] == "long" else -1
+        if px is None: continue
+        en, r = e["entry"], e["risk"]
+        if not e.get("filled"):
+            if s * (px - en) <= 0: e["filled"] = True; ev.append(("fill", e, {}))
+            elif e.get("cancelPx") is not None and s * (px - e["cancelPx"]) >= 0: e.update(open=False, result="cancel"); ev.append(("skip", e, {"skipWhy": "played_out"})); continue
+            elif now_ms - e["sealedAt"] >= float(ENT.get("limitValidMin", 20)) * 60000 or late: e.update(open=False, result="expired"); ev.append(("skip", e, {"skipWhy": "no_fill"})); continue
+            else: continue
+        if s * (px - e["stop"]) <= 0:
+            e["R"] += e["rem"] * (e["stop"] - en) * s / r; e["rem"] = 0.0
+        else:
+            adv = s * (px - en) / r; e["mfeR"] = max(e["mfeR"], adv)
+            if e["mode"] == "TR":
+                L = e["legs"][0]
+                if not e["t1hit"] and adv >= L["R"]:
+                    e["t1hit"] = True; e["R"] += L["frac"] * L["R"]; e["rem"] = 1 - L["frac"]; e["stop"] = en; ev.append(("leg", e, {"leg": {"frac": L["frac"], "px": L["px"], "R": L["R"]}}))
+                if e["t1hit"]: e["stop"] = en + s * max(0.0, e["mfeR"] - float(e.get("trailR") or 1.0)) * r
+            else:
+                for j, L in enumerate(e["legs"]):
+                    if L.get("hit") or s * (px - L["px"]) < 0: continue
+                    L["hit"] = True; e["R"] += L["frac"] * L["R"]; e["rem"] -= L["frac"]; ev.append(("leg", e, {"leg": {"frac": L["frac"], "px": L["px"], "R": L["R"]}}))
+                    if j == 0: e["t1hit"] = True; e["stop"] = en
+            if e["rem"] > 1e-9 and late: e["R"] += e["rem"] * (px - en) * s / r; e["rem"] = 0.0; e["flat"] = True
+        if e["rem"] <= 1e-9:
+            e["open"] = False; n = _net(e)
+            e["result"] = "loss" if n < 0 else "win"   # research run(): a day-loss is net R < 0 (a BE scratch after costs halts the day)
+            ev.append(("close", e, {"netR": round(n, 4), "exit": "flat_1455" if e.get("flat") else "stop_or_target"}))
+    return ev
+
+_SKIP = (("halted", "daily_halt"), ("day cap", "cap_day"), ("open", "position_open"), ("cap", "cap_sym"), ("already sealed", "setup_spent"))
+def _skip_why(why): return next((v for k, v in _SKIP if k in why), "cap_sym")
+_BOOK = {"MNQ": "NQ", "NQ": "NQ", "MES": "ES", "ES": "ES"}
+
+def _row(key, event, base, **extra):
+    from .gates import RULES_HASH
+    d = dict(base); d.update(tag=f"shadow:combo1016:{key}", v=1, rulesHash=RULES_HASH, event=event, arm=ARMS[key]["name"]); d.update({k: v for k, v in extra.items() if v is not None})
+    return (f"shadow:combo1016:{key}", True, json.dumps(d, separators=(",", ":"), default=str))
+
+def shadow_rows(snap, state_day=None, now_ms=0):
+    """One row per decision and per ledger state change, tag shadow:combo1016:<config> (SMC integration log schema, JSON payload).
+    label keeps the partial labelling: would_fire_partial / would_fire / read — never a clean would_fire while any input is defaulted or missing."""
+    c = snap.get("combo1016") or {}
