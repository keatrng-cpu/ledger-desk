@@ -0,0 +1,74 @@
+"""combo1016 watcher half: parity with the research on the 553 v1-parity candidates; shadow rows never gate; shadow day ledger."""
+import json, os
+from watcher import combo1016 as C, gates
+
+FIX = json.load(open(os.path.join(os.path.dirname(__file__), "fixtures", "combo1016-parity.json")))
+
+def test_shadow_and_model_sha():
+    assert C.mode() == "shadow" and all(C.mode(k) == "shadow" for k in ("entry", "exit", "caps", "rearm"))
+    assert C.GBM_SHA_OK and abs(C.THR - FIX["thr"]) < 1e-15 and C.CB["aPlusSizing"] is False
+
+def test_parity_553_fire_matches():
+    assert len(FIX["rows"]) == 553
+    for r in FIX["rows"]:
+        s2, p = C.score_v2(r["raw"]); g = C.gbm_p(r["x"])
+        assert abs(s2 - r["S2"]) < 1e-6 and abs(p - r["p"]) < 1e-9 and abs(g - r["gbmP"]) < 1e-9, r["t"]
+        assert (s2 >= 75 and g >= C.THR) == r["fire"], r["t"]
+
+def _snap(**kw):
+    c = {"S2": 91.2, "p": 0.64, "gbmP": 0.65, "thr": 0.604, "grade": "A+", "fire": True, "aPlus": True, "wouldFire": True, "setupId": "MNQ|short|30100|1",
+         "plan": {"kind": "market", "entry": 100.0, "stop": 102.0, "t1": 98.0, "t2": 96.0, "partialFrac": 0.5}, "src": "ltfArm 1m PDH", "partial": None}
+    c.update(kw); return {"symbol": "MNQ", "side": "short", "combo1016": c, "tape_prices": {"MNQ": 100.0}}
+
+def test_rows_shadow_never_gate_and_ledger():
+    day = {}
+    rows = C.shadow_rows(_snap(), day, 1)
+    names = [r[0] for r in rows]
+    assert names[:3] == ["shadow:combo1016:would_fire", "shadow:combo1016:a_plus", "shadow:combo1016:ledger"] and "ADMIT" in rows[2][2]
+    assert gates.all_pass([("x", True, "")] + rows)
+    again = C.shadow_rows(_snap(plan={"kind": "market", "entry": 99.0, "stop": 102.0, "t1": 98, "t2": 96}), day, 2)
+    assert "already sealed at 100.0" in [r for r in again if r[0] == "shadow:combo1016:ledger"][0][2] and day["combo1016"]["entries"][0]["entry"] == 100.0
+    s = _snap(); s["tape_prices"] = {"MNQ": 102.5}
+    res = [r for r in C.shadow_rows(s, day, 3) if r[0] == "shadow:combo1016:result"]
+    assert res and "loss" in res[0][2]
+    blk = [r for r in C.shadow_rows(_snap(setupId="MNQ|short|30120|9"), day, 4) if r[0] == "shadow:combo1016:ledger"][0]
+    assert "halted" in blk[2]
+    assert C.shadow_rows({}) == [] and C.shadow_rows({"combo1016": {"error": "x"}}) == []
+
+def test_caps_3_2_and_be_after_t1():
+    day = {}
+    mk = lambda sid, sym, e: {"kind": "market", "entry": e, "stop": e - 2, "t1": e + 2, "t2": e + 4}
+    assert C.admit(day, "MNQ", "a", mk("a", "MNQ", 10), "long", 0)[0]
+    assert C.admit(day, "MNQ", "b", mk("b", "MNQ", 10), "long", 0)[0]
+    assert "MNQ cap 2/2" in C.admit(day, "MNQ", "c", mk("c", "MNQ", 10), "long", 0)[1]
+    assert C.admit(day, "MES", "d", mk("d", "MES", 10), "long", 0)[0]
+    assert "day cap 3/3" in C.admit(day, "MES", "e", mk("e", "MES", 10), "long", 0)[1]
+    C.resolve(day, {"MNQ": 12.1}); e = day["entries"][0]; assert e["t1hit"] and e["result"] is None
+    C.resolve(day, {"MNQ": 9.9}); assert e["result"] == "be"
+
+def test_drift_flag_when_desk_numbers_disagree():
+    r = FIX["rows"][0]
+    s = _snap(feat={"v2": r["raw"], "gbm": r["x"]}, S2=r["S2"], gbmP=round(r["gbmP"], 4), fire=r["fire"], wouldFire=False)
+    assert "DRIFT" not in C.shadow_rows(s)[0][2]
+    s = _snap(feat={"v2": r["raw"], "gbm": r["x"]}, S2=r["S2"] + 5, gbmP=r["gbmP"], fire=r["fire"], wouldFire=False)
+    assert "DRIFT" in C.shadow_rows(s)[0][2]
+
+def test_partial_never_clean_would_fire():
+    r = FIX["rows"][0]
+    v2 = dict(r["raw"]); v2["atrpct"] = None; v2["chaseR"] = None; v2["rng30"] = None
+    gb = dict(r["x"]); gb["b1"] = None
+    assert C.filled_inputs(v2)[:0] == [] and {"ctx_lowvol", "ent_nochase", "tim_rng30"} <= set(C.filled_inputs(v2))
+    s = _snap(feat={"v2": v2, "gbm": gb})
+    rows = C.shadow_rows(s)
+    assert rows[0][0] == "shadow:combo1016:would_fire_partial" and "PARTIAL" in rows[0][2] and "GBM missing" in rows[0][2]
+    assert all(r[0] != "shadow:combo1016:would_fire" for r in rows) and gates.all_pass(rows)
+    assert C.shadow_rows(_snap(partial="partial: 3/14 S2 filled, 11/27 GBM missing"))[0][0] == "shadow:combo1016:would_fire_partial"
+    nofeat = _snap(); del nofeat["combo1016"]["partial"]
+    assert C.shadow_rows(nofeat)[0][0] == "shadow:combo1016:would_fire_partial"
+    rd = C.shadow_rows(_snap(wouldFire=False, feat={"v2": v2, "gbm": gb}))
+    assert rd[0][0] == "shadow:combo1016:read" and "partial:" in rd[0][2]
+
+def test_combo_import_inside_try():
+    src = open(gates.__file__).read()
+    i = src.index("from . import combo1016 as _c16")
+    assert src[:i].rstrip().endswith("try:")   # a corrupt GBM file fails closed for combo only, the poll keeps its other rows
diff --git a/tests/test_combo1016_arms.py b/tests/test_combo1016_arms.py
new file mode 100644
index 0000000..0e525bb
--- /dev/null
+++ b/tests/test_combo1016_arms.py
@@ -0,0 +1,95 @@
+"""combo1016 arms (pnl-push finalists): shadow rows, own ledger, exits; parity of fire/plan with the TS twin via shared rules."""
+import json, os
+from watcher import combo1016_arms as A, gates
+
+FX = json.load(open(os.path.join(os.path.dirname(__file__), "fixtures", "combo1016-arms-parity.json")))
+T0 = 1792170000000  # 2026-10-16 ~09:00 CT
+
+def _snap(S2=88.0, g=0.7, partial=None, arms=True):
+    c = {"S2": S2, "gbmP": g, "grade": "A", "setupId": "MNQ|long|100|1", "partial": partial, "filled": [], "gbmMissing": []}
+    if arms:
+        c["arms"] = {"reads": [{"arm": k, "S2": S2, "gbmP": g, "fire": True, "plan": A.plan(k, "long", 100.5, 100.0, 98.0), "opt": {"contracts": 3, "etf": "QQQ", "strike": 488, "premium": 1.2, "legs": [{"usd": 10}]}} for k in A.ARMS],
+                     "pd": {"pd_cur": -0.5, "pd_ent": 0.5}}
+    return {"symbol": "MNQ", "side": "long", "combo1016": c, "tape_prices": {"MNQ": 100.5}}
+
+def test_rules_shadow_and_specs():
+    assert A.AB["mode"] == "shadow" and list(A.ARMS) == ["config1_trail", "config2_e75", "config3_e75_s65", "config2_e75_tier200_400"]
+    assert [A.ARMS[k]["fireS2"] for k in A.ARMS] == [70, 70, 65, 70]
+    assert A.CAPS["perDay"] == 5 and A.CAPS["perSymbol"] == 3 and A.CAPS["openPerSymbol"] == 1 and A.CAPS["haltAfterLosses"] == 1
+    assert gates.RULES["combo1016"]["fireS2"] == 75 and gates.RULES["brainPd"]["mode"] == "shadow"
+
+def _j(rows): return [(t, json.loads(w)) for t, _, w in rows]
+
+def test_rows_tagged_and_never_gate():
+    sd = {}
+    rows = A.shadow_rows(_snap(), sd, T0)
+    J = _j(rows)
+    assert {t for t, _ in J} == {f"shadow:combo1016:{k}" for k in A.ARMS}
+    for k in A.ARMS:
+        ev = [d["event"] for t, d in J if t == f"shadow:combo1016:{k}"]
+        assert ev[:2] == ["decision", "fill"], (k, ev)
+    d0 = J[0][1]
+    assert d0["v"] == 1 and d0["rulesHash"] == gates.RULES_HASH and d0["label"] == "would_fire" and d0["fires"] and d0["tier"] == "A+"
+    assert d0["brain"]["pd_cur_legacy"] == -0.5 and d0["brain"]["pd_ent"] == 0.5 and d0["brain"]["step8Delta"] == 0.1
+    assert d0["option"]["contracts"] == 3 and d0["entry"]["trailR"] == 1.0 and d0["gbm_q90"] == A.THR
+    assert all(r[1] is True for r in rows) and gates.all_pass(rows)
+    assert set(sd["combo1016_arms"]) == set(A.ARMS) and "combo1016" not in sd   # own ledger; existing combo ledger untouched
+
+def test_partial_and_s2_65():
+    J = _j(A.shadow_rows(_snap(S2=67.0, g=0.7, partial="partial: 3/14 S2 filled, 11/27 GBM missing")))
+    lab = {t.split(":")[-1]: d for t, d in J}
+    assert lab["config3_e75_s65"]["label"] == "would_fire_partial" and lab["config3_e75_s65"]["partial"].startswith("partial:")
+    assert lab["config1_trail"]["label"] == "read" and lab["config1_trail"]["skipWhy"] == "below_s2"
+    assert not any(d["label"] == "would_fire" for _, d in J)
+
+def test_ledger_and_exits():
+    p = A.plan("config2_e75", "long", 100.0, 100.0, 98.0); d = {}
+    ok, _, e = A.admit("config2_e75", d, "MNQ", "a", p, "long", 300, T0); assert ok
+    assert "already has 1 open" in A.admit("config2_e75", d, "MNQ", "b", p, "long", 300, T0)[1]
+    A.resolve(d, {"MNQ": 101.6}, T0 + 60000); assert e["t1hit"] and e["stop"] == 100.0
+    out = A.resolve(d, {"MNQ": 100.0}, T0 + 120000); assert out[-1][0] == "close" and e["result"] == "win" and abs(e["R"] - 0.375) < 1e-9
+    assert abs(out[-1][2]["netR"] - (0.375 - 0.5 / 2)) < 1e-9
+    pt = A.plan("config1_trail", "long", 100.0, 100.0, 98.0); d2 = {}
+    _, _, t = A.admit("config1_trail", d2, "ES", "x", pt, "long", 250, T0)
+    for px in (102.0, 106.0, 104.0): A.resolve(d2, {"ES": px}, T0 + 60000)
+    assert t["result"] == "win" and abs(t["R"] - (0.5 + 0.5 * 2.0)) < 1e-9   # trail MFE 3R - 1R = 2R
+    d3 = {}; _, _, l = A.admit("config1_trail", d3, "ES", "y", pt, "long", 250, T0); A.resolve(d3, {"ES": 97.9}, T0 + 60000)
+    assert l["result"] == "loss" and "halted" in A.admit("config1_trail", d3, "NQ", "z", pt, "long", 250, T0)[1]
+    d4 = {}; _, _, b = A.admit("config2_e75", d4, "ES", "be", A.plan("config2_e75", "long", 100.0, 100.0, 98.0), "long", 300, T0)
+    A.resolve(d4, {"ES": 98.0}, T0 + 60000); assert b["result"] == "loss"   # a stop-out is a loss; research halts on net R < 0
+
+def test_limit_cancel_expiry_flat():
+    assert A.plan("config2_e75", "long", 103.0, 100.0, 98.0)["kind"] == "market"   # research chaseR: 3/5 over market risk
+    pl = A.plan("config2_e75", "long", 98.8, 100.0, 98.0); assert pl["kind"] == "limit" and pl["chaseR"] == 1.5 and pl["cancelPx"] == 101.5
+    d = {}; _, _, e = A.admit("config2_e75", d, "MNQ", "L", pl, "long", 300, T0); ev = A.resolve(d, {"MNQ": 101.6}, T0 + 1000); assert e["result"] == "cancel" and ev[0][2]["skipWhy"] == "played_out"
+    d = {}; _, _, e = A.admit("config2_e75", d, "MNQ", "L2", dict(pl, cancelPx=None), "long", 300, T0); A.resolve(d, {"MNQ": 101.0}, T0 + 21 * 60000); assert e["result"] == "expired"
+    flat = 1792184400000 + 55 * 60000   # >= 14:55 CT
+    d = {}; _, _, e = A.admit("config2_e75", d, "MNQ", "F", A.plan("config2_e75", "long", 100.0, 100.0, 98.0), "long", 300, T0)
+    ev = A.resolve(d, {"MNQ": 100.5}, flat); assert e.get("flat") and abs(e["R"] - 0.25) < 1e-9 and ev[-1][2]["exit"] == "flat_1455"
+
+def test_parity_fire_vs_research_selection_inputs():
+    # research fire rule (S2 >= arm thr AND pgr >= 1) on the VAL candidate stream: the watcher fire() agrees row by row when gbmP is mapped to pgr*THR
+    S = FX["select"]
+    for k in A.ARMS:
+        for s2, pgr in zip(S["S2"], S["pgr"]):
+            assert A.fire(k, s2, pgr * A.THR)[0] == (s2 >= A.ARMS[k]["fireS2"] and pgr >= 1)
+
+def test_golden_arms_models_match_smc_integration():
+    G = json.load(open(os.path.join(os.path.dirname(__file__), "fixtures", "combo1016-arms-golden.json")))
+    assert A.AGBM_SHA_OK and A.THR == G["fixtures"][0]["gbm_q90"]
+    ws = wg = 0.0; ok = n = 0
+    for f in G["fixtures"]:
+        x = f["features"]; v2 = dict(x); v2.update(smt=None if x["smt"] is None else bool(x["smt"]), mss=None if x["mss"] is None else bool(x["mss"]), ifvg=None if x["ifvg"] is None else bool(x["ifvg"]))
+        s2 = A.arms_s2(v2); g = A.arms_gbm_p(x); ws = max(ws, abs(s2 - f["S2"])); wg = max(wg, abs(g - f["gbm_p"]))
+        for k, cfg in (("config1_trail", "config1_trail"), ("config2_e75", "config2_e75"), ("config3_e75_s65", "config3_e75_s65")):
+            n += 1; ok += A.fire(k, s2, g)[0] == f["configs"][cfg]["fires"]
+    assert ws < 1e-9 and wg < 1e-12 and ok == n
+
+def test_rows_recompute_from_feat_with_wf_models():
+    G = json.load(open(os.path.join(os.path.dirname(__file__), "fixtures", "combo1016-arms-golden.json")))
+    f = next(f for f in G["fixtures"] if f["configs"]["config3_e75_s65"]["fires"])
+    sn = _snap(S2=1.0, g=0.0); x = f["features"]
+    sn["combo1016"]["feat"] = {"v2": dict(x, smt=bool(x["smt"]), mss=bool(x["mss"]), ifvg=bool(x["ifvg"])), "gbm": x}
+    J = _j(A.shadow_rows(sn))
+    d3 = next(d for t, d in J if t == "shadow:combo1016:config3_e75_s65")
+    assert d3["fires"] and d3["label"].startswith("would_fire") and d3["S2"] == round(f["S2"], 1) and abs(d3["gbm_p"] - round(f["gbm_p"], 4)) < 1e-12
