+    # the arms carry their own research-exact candidate inputs (desk arms.feat); the legacy combo1016 feat is the fallback
+    feat = arms.get("feat") if isinstance(arms.get("feat"), dict) else (c.get("feat") or {})
+    if isinstance(feat.get("v2"), dict) and isinstance(feat.get("gbm"), dict): s2, g = round(arms_s2(feat["v2"]), 1), round(arms_gbm_p(feat["gbm"]), 4)
+    else:
+        r0 = next((r for r in (arms.get("reads") or []) if isinstance(r, dict)), {})
+        s2, g = _f(r0.get("S2")), _f(r0.get("gbmP"))
