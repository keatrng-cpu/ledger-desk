+    if partial is None and "partial" not in arms and (c.get("filled") or c.get("gbmMissing")): partial = f"partial: {len(c.get('filled') or [])}/14 S2 filled, {len(c.get('gbmMissing') or [])}/27 GBM missing"
+    vetoed = c.get("grade") == "skip"
