+                    brain={"pd_cur_legacy": pd.get("pd_cur"), "pd_ent_pdleg": pd.get("zoneEnt"), "pd_ent": pd.get("pd_ent"), "step8Delta": 0.1 if (pd.get("pd_ent") or 0) > 0 else 0.0})
+        if f and p:
