+"""combo1016 watcher half: parity with the research on the 553 v1-parity candidates; shadow rows never gate; shadow day ledger."""
+import json, os
+from watcher import combo1016 as C, gates
+
+FIX = json.load(open(os.path.join(os.path.dirname(__file__), "fixtures", "combo1016-parity.json")))
+
+def test_shadow_and_model_sha():
+    assert C.mode() == "shadow" and all(C.mode(k) == "shadow" for k in ("entry", "exit", "caps", "rearm"))
+    assert C.GBM_SHA_OK and abs(C.THR - FIX["thr"]) < 1e-15 and C.CB["aPlusSizing"] is False
+
+def test_parity_553_fire_matches():
+    assert len(FIX["rows"]) == 553
+    for r in FIX["rows"]:
+        s2, p = C.score_v2(r["raw"]); g = C.gbm_p(r["x"])
+        assert abs(s2 - r["S2"]) < 1e-6 and abs(p - r["p"]) < 1e-9 and abs(g - r["gbmP"]) < 1e-9, r["t"]
+        assert (s2 >= 75 and g >= C.THR) == r["fire"], r["t"]
+
+def _snap(**kw):
+    c = {"S2": 91.2, "p": 0.64, "gbmP": 0.65, "thr": 0.604, "grade": "A+", "fire": True, "aPlus": True, "wouldFire": True, "setupId": "MNQ|short|30100|1",
+         "plan": {"kind": "market", "entry": 100.0, "stop": 102.0, "t1": 98.0, "t2": 96.0, "partialFrac": 0.5}, "src": "ltfArm 1m PDH"}
+    c.update(kw); return {"symbol": "MNQ", "side": "short", "combo1016": c, "tape_prices": {"MNQ": 100.0}}
+
+def test_rows_shadow_never_gate_and_ledger():
+    day = {}
+    rows = C.shadow_rows(_snap(), day, 1)
+    names = [r[0] for r in rows]
+    assert names[:3] == ["shadow:combo1016:would_fire", "shadow:combo1016:a_plus", "shadow:combo1016:ledger"] and "ADMIT" in rows[2][2]
+    assert gates.all_pass([("x", True, "")] + rows)
+    again = C.shadow_rows(_snap(plan={"kind": "market", "entry": 99.0, "stop": 102.0, "t1": 98, "t2": 96}), day, 2)
+    assert "already sealed at 100.0" in [r for r in again if r[0] == "shadow:combo1016:ledger"][0][2] and day["combo1016"]["entries"][0]["entry"] == 100.0
+    s = _snap(); s["tape_prices"] = {"MNQ": 102.5}
+    res = [r for r in C.shadow_rows(s, day, 3) if r[0] == "shadow:combo1016:result"]
+    assert res and "loss" in res[0][2]
+    blk = [r for r in C.shadow_rows(_snap(setupId="MNQ|short|30120|9"), day, 4) if r[0] == "shadow:combo1016:ledger"][0]
+    assert "halted" in blk[2]
+    assert C.shadow_rows({}) == [] and C.shadow_rows({"combo1016": {"error": "x"}}) == []
+
+def test_caps_3_2_and_be_after_t1():
+    day = {}
+    mk = lambda sid, sym, e: {"kind": "market", "entry": e, "stop": e - 2, "t1": e + 2, "t2": e + 4}
+    assert C.admit(day, "MNQ", "a", mk("a", "MNQ", 10), "long", 0)[0]
+    assert C.admit(day, "MNQ", "b", mk("b", "MNQ", 10), "long", 0)[0]
+    assert "MNQ cap 2/2" in C.admit(day, "MNQ", "c", mk("c", "MNQ", 10), "long", 0)[1]
+    assert C.admit(day, "MES", "d", mk("d", "MES", 10), "long", 0)[0]
+    assert "day cap 3/3" in C.admit(day, "MES", "e", mk("e", "MES", 10), "long", 0)[1]
+    C.resolve(day, {"MNQ": 12.1}); e = day["entries"][0]; assert e["t1hit"] and e["result"] is None
+    C.resolve(day, {"MNQ": 9.9}); assert e["result"] == "be"
+
+def test_drift_flag_when_desk_numbers_disagree():
+    r = FIX["rows"][0]
+    s = _snap(feat={"v2": r["raw"], "gbm": r["x"]}, S2=r["S2"], gbmP=round(r["gbmP"], 4), fire=r["fire"], wouldFire=False)
+    assert "DRIFT" not in C.shadow_rows(s)[0][2]
+    s = _snap(feat={"v2": r["raw"], "gbm": r["x"]}, S2=r["S2"] + 5, gbmP=r["gbmP"], fire=r["fire"], wouldFire=False)
+    assert "DRIFT" in C.shadow_rows(s)[0][2]
