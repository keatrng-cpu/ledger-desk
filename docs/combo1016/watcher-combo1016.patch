+            entry = {"type": p.get("kind"), "price": p.get("entry"), "stop": p.get("stop"), "riskPts": p.get("risk"), "legs": p.get("legs"), "trailR": p.get("trailR"), "cancelIfTouches": p.get("cancelPx"), "validMin": p.get("limitValidMin")}
