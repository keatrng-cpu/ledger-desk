+RH_CONNECT_TIMEOUT_S = 10.0
+RH_READ_TIMEOUT_S = 10.0
+
+def install_timeouts(session, connect=RH_CONNECT_TIMEOUT_S, read=RH_READ_TIMEOUT_S):
+    """Review 2026-10-15 #1: robin_stocks calls SESSION.get(url) with timeout=None, so one stalled RH read hung the
+    broker_health thread forever. Wrap session.request so every call without an explicit timeout gets (connect, read).
+    Idempotent; never touches credentials or the session pickle."""
+    if session is None or getattr(session, "_ld_timeouts", None) == (connect, read): return session
+    orig = getattr(session, "_ld_orig_request", None) or session.request
+    def request(method, url, **kw):
+        if kw.get("timeout") is None: kw["timeout"] = (connect, read)
+        return orig(method, url, **kw)
+    session._ld_orig_request = orig
+    session.request = request
+    session._ld_timeouts = (connect, read)
+    return session
+
