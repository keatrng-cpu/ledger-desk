+"""Review 2026-10-15 item 1: RH read timeouts + health light recovery (no network, no login)."""
+import time, threading
+from watcher import broker, daemon
+from tests.test_daemon import mk
+
+class FakeSess:
+    def __init__(self): self.calls = []
+    def request(self, method, url, **kw): self.calls.append(kw.get("timeout")); return kw
+
+def test_every_rh_read_gets_timeout():
+    s = broker.install_timeouts(FakeSess())
+    s.request("GET", "u"); s.request("GET", "u", timeout=None); s.request("GET", "u", timeout=3)
+    assert s.calls == [(10.0, 10.0), (10.0, 10.0), 3]
+    broker.install_timeouts(s); s.request("GET", "u"); assert s.calls[-1] == (10.0, 10.0)  # idempotent, no double wrap
+
+def test_robin_stocks_global_session_patched():
+    from robin_stocks.robinhood import globals as g
+    b = broker.Broker(type("C", (), {"account": "x"})(), print); b._timeouts()
+    assert g.SESSION._ld_timeouts == (10.0, 10.0)
+
+def test_hung_health_goes_red_then_recovers(tmp_path, monkeypatch):
+    w = mk(tmp_path, monkeypatch, "card_live_watch.json")
+    ev = threading.Event()
+    w._health_thread = threading.Thread(target=ev.wait, daemon=True); w._health_thread.start()
+    w._health_started = time.time() - 120
+    calls = []
+    monkeypatch.setattr(w, "broker_health", lambda *a, **k: calls.append(1) or w.state.__setitem__("broker_health", {"ok": True}))
+    assert w.broker_health_bg() is True
+    w._health_thread.join(2); ev.set()
+    assert calls and w.state["broker_health"]["ok"] is True
+
+def test_not_hung_yet_does_not_restart(tmp_path, monkeypatch):
+    w = mk(tmp_path, monkeypatch, "card_live_watch.json")
+    ev = threading.Event(); w._health_thread = threading.Thread(target=ev.wait, daemon=True); w._health_thread.start()
+    w._health_started = time.time()
+    assert w.broker_health_bg() is False; ev.set()
+
+def test_red_light_retries_in_60s(tmp_path, monkeypatch):
+    from datetime import datetime
+    from watcher import gates
+    w = mk(tmp_path, monkeypatch, "card_live_watch.json")
+    class B: ready = True
+    def health(self): return {"account": w.cfg.account, "open_option_positions": 0, "working_orders": 0}
+    w.broker = B(); B.health = health
+    et = datetime(2026, 10, 15, 10, 0, tzinfo=gates.ET)
+    w.state["broker_health"] = {"ok": False}; w.state["broker_health_at"] = 1000
+    assert w.broker_health(now=1061, et=et)["ok"] is True
+    assert w.broker_health(now=1100, et=et) is None   # green again: back to 5-min cadence
