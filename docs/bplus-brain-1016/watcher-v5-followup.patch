+from watcher import daemon, gates
+
+def test_bplus_limits_read_shared_rules():
+    r = gates.RULES["fire"]["bplusBrainTake"]
+    assert daemon.Watcher.BPLUS_Q_MIN == r["hard"]["minQ"] == 0.60
+    assert daemon.Watcher.BPLUS_MAX_PER_DAY == r["hard"]["maxPerDay"] == 1
+    assert daemon.Watcher.BPLUS_NONE_AFTER_LOSS is True and r["hard"]["dayUnknownFailsClosed"] is True
+    assert r["mode"] == "live" and r["htfCappedFrom"] == ["A-"] and r["hard"]["noBrainOverride"] and r["hard"]["noBrainWouldBlock"]
+    assert "bplus_brain_agree" in gates.RULES["fastChain"]["hard"]
