+B_EDGE = RULES["bandEdges"]["B+"]
+
+def smoothed_band(snap):
+    """(ok, why): B+ for the fire band check when >= B+ on minOf of the last `polls` real polls (this one included),
+    or q within edgeEps of the B+ edge and rising vs the previous poll. Edges are never lowered."""
+    gs = _sub("gradeSmoothing"); h = list(snap.get("band_hist") or [])[-gs.get("polls", 3):]
+    good = sum(1 for _, _, bb in h if BAND_RANK.get(bb) is not None and BAND_RANK[bb] >= BAND_RANK[FC["minBand"]])
+    if len(h) >= gs.get("minOf", 2) and good >= gs.get("minOf", 2):
+        return True, f"{good} of last {len(h)} polls >= {FC['minBand']}"
+    q = _num(snap.get("q")); qs = [_num(x[1]) for x in h[:-1] if _num(x[1]) is not None]
+    if q is not None and qs and B_EDGE - gs.get("edgeEps", 0.01) - 1e-9 <= q < B_EDGE and q > qs[-1]:
+        return True, f"q {q} within {gs.get('edgeEps', 0.01)} of the {FC['minBand']} edge {B_EDGE} and rising (prev {qs[-1]})"
+    return False, f"{good} of last {len(h)} polls >= {FC['minBand']} (need {gs.get('minOf', 2)}); q {q} not edge+rising"
+
+def promote_smoothed(snap):
+    """Daemon hook: a card below minBand that passes gradeSmoothing is treated as minBand (B+) for this poll (gates + sizing on the B+ rung).
+    Returns the note or None. The raw band is kept in snap['band_raw']."""
+    if not (live() and smoothing_live()): return None
+    r = BAND_RANK.get(snap.get("band"))
+    if r is not None and r >= BAND_RANK[FC["minBand"]]: return None
+    ok, why = smoothed_band(snap)
+    if not ok: return None
+    snap["band_raw"] = snap.get("band"); snap["band"] = FC["minBand"]; snap["fast_band_smoothed"] = True
+    return f"band {snap['band_raw']} counted as {FC['minBand']} (gradeSmoothing: {why})"
+
+def hist_next(prev_hist, snap):
