+"""watcher/notify.py + watcher/monitoring.py: no-op without env, dedupe, rate limit, scrubbing, record mapping."""
+from watcher import notify, monitoring
+
+class Clock:
+    def __init__(self): self.t = 1000.0
+    def __call__(self): return self.t
+
+def mk(**kw):
+    sent = []
+    c = Clock()
+    n = notify.Notifier(webhook_url="https://hooks.slack.com/services/T/B/x", post=lambda url, body: sent.append(body) or True, clock=c, **kw)
+    return n, sent, c
+
+FIRE = dict(type="card_fire", grade="A", symbol="ES", side="long", entry=7782.63, stop=7775.0, t1=7792.25, signal="sig-1")
+
+def test_noop_when_unset(monkeypatch):
+    monkeypatch.delenv("SLACK_DESK_WEBHOOK_URL", raising=False)
+    n = notify.Notifier()
+    assert not n.enabled and n.notify(FIRE) == (False, "disabled")
+    assert notify.on_record({"kind": "stop"}, n) == []
+
+def test_format_and_dedupe():
+    n, sent, c = mk()
+    assert n.notify(FIRE) == (True, None)
+    assert sent[0]["text"] == ":rotating_light: FIRE A ES long · entry 7782.63 · stop 7775 · T1 7792.25"
+    assert n.notify(FIRE) == (False, "duplicate")
+    c.t += notify.DEDUPE_S + 1
+    assert n.notify(FIRE)[0] is True
+
+def test_rate_limit_counts_suppressed():
+    n, sent, c = mk(rate_max=2, window_s=60)
+    for i in range(4): n.notify(dict(FIRE, signal=f"s{i}"))
+    assert len(sent) == 2
+    c.t += 61
+    n.notify(dict(FIRE, signal="s9"))
+    assert "+2 suppressed" in sent[-1]["text"]
+
+def test_scrub_secrets_and_account(monkeypatch):
+    monkeypatch.setenv("DATABENTO_API_KEY", "db-ABCDEFGHIJKLMNOPQRSTUVWXYZ")
+    monkeypatch.setenv("SUPABASE_SERVICE_ROLE_KEY", "supersecretservicerolevalue")
+    s = notify.scrub_text("acct 995386158 key db-ABCDEFGHIJKLMNOPQRSTUVWXYZ svc supersecretservicerolevalue Bearer abc.def.ghijklmnop "
+                          "hook https://hooks.slack.com/services/T0/B0/zzz token=abc123456 px 7782.63 jwt eyJhbGciOiJIUzI1.eyJyb2xlIjoic2Vy.c2lnbmF0dXJl")
+    for bad in ("995386158", "db-ABC", "supersecret", "abc.def", "hooks.slack.com", "abc123456", "eyJhbGci"): assert bad not in s
+    assert "7782.63" in s
+
+def test_rejected_send_never_raises():
+    n = notify.Notifier(webhook_url="https://x.invalid", post=lambda *a: (_ for _ in ()).throw(RuntimeError("boom")))
+    assert n.notify(FIRE) == (False, "error")
+
+def test_events_from_records():
+    ev = notify.events_from_record
+    f = ev({"ts": "2026-10-15T14:02:04-04:00", "kind": "alert", "text": "FIRE B+ ES long q=0.6499 entry=7782.63 stop=7775.0 tgt=7792.25 rr=1.26"})
+    assert f[0]["type"] == "card_fire" and f[0]["t1"] == 7792.25 and f[0]["grade"] == "B+"
+    assert ev({"ts": "x", "kind": "alert", "text": "FILLED 1 @ 2.96 (filled)"})[0] == dict(type="order_filled", qty=1, price=2.96, signal=None)
+    arm = ev({"ts": "x", "kind": "alert", "text": "DESK A- ES short q=0.67", "signal": "sig-2", "snap": {"actionable": True, "entry": 7770.0, "strategy_stop": 7780.0, "targets": [7750.0]}})
+    assert arm[0]["type"] == "card_arm" and arm[0]["t1"] == 7750.0
+    assert ev({"ts": "x", "kind": "alert", "text": "DESK A- ES short", "snap": {"actionable": False}}) == []
+    assert ev({"kind": "fire_blocked", "ts": "x", "reason": "RH refused"})[0]["type"] == "order_rejected"
+    r = ev({"ts": "2026-10-15T10:00:00-04:00", "kind": "fire_refused_desk", "failing": [["day_loss", "day -300"], ["weekly_lock", "week locked"], ["rules_parity", "card rules aaa vs watcher bbb — MISMATCH, fail closed"]]})
+    assert [e["type"] for e in r] == ["daily_stop", "weekly_lock", "rules_hash_mismatch"] and r[2]["expected"] == "aaa"
+    r1 = ev({"ts": "2026-10-16T08:35:00-05:00", "kind": "rule1_would_fire", "symbol": "MNQ", "side": "long", "entry": 1.0, "stop": 0.5, "target": 2.0})
+    assert r1[0]["type"] == "rule1_shadow" and r1[0]["day"] == "2026-10-16"
+    assert ev({"kind": "stop", "ts": "x"})[0]["type"] == "watcher_down"
+    assert ev({"kind": "tick", "ts": "x"}) == []
+
+def test_preopen_and_mismatch_format():
+    assert "FAIL" in notify.format_event(dict(type="preopen_check", ok=False, day="2026-10-16", failures=["stale"]))
+    assert "MISMATCH" in notify.format_event(dict(type="rules_hash_mismatch", expected="a", got="b"))
+
+class FakeSdk:
+    def __init__(self): self.kw = None; self.caught = []
+    def init(self, **kw): self.kw = kw
+    def capture_exception(self, e): self.caught.append(e)
+
+def test_sentry_noop_without_dsn(monkeypatch):
+    monkeypatch.delenv("SENTRY_DSN", raising=False); monkeypatch.setattr(monitoring, "_on", False)
+    sdk = FakeSdk()
+    assert monitoring.init(sdk) is False and sdk.kw is None
+    assert monitoring.capture(RuntimeError("x"), sdk) is False
+
+def test_sentry_init_and_scrub(monkeypatch):
+    monkeypatch.setenv("SENTRY_DSN", "https://pub@o1.ingest.sentry.io/1")
+    monkeypatch.setenv("RH_PASSWORD", "hunter2hunter2")
+    sdk = FakeSdk()
+    assert monitoring.init(sdk) is True and sdk.kw["send_default_pii"] is False
+    ev = sdk.kw["before_send"]({"message": "login failed pw hunter2hunter2 acct 995386158", "extra": {"account_number": "995386158", "DATABENTO_API_KEY": "x"},
+                                "request": {"headers": {"Authorization": "Bearer zzzzzzzzzz"}, "url": "u"}})
+    assert "hunter2" not in str(ev) and "995386158" not in str(ev) and "headers" not in ev["request"]
+    assert monitoring.capture(RuntimeError("boom"), sdk) is True and sdk.caught
+    monkeypatch.setattr(monitoring, "_on", False)
