+def soft_review_pick(reads, now_ms, soft_s, quote_ok):
+    """reads: [(read_ms, quote)] from the retry rounds (fresh RH re-reads only, oldest first). Returns (quote, ok, why).
+    Pass only if: the youngest re-read is <= soft_s old NOW and passes quote_ok (ask > 0, not crossed, not future-stamped),
+    AND the feed is not frozen: >= 2 re-reads each <= soft_s old when read, and the asOfMs stamp MOVED between the first and
+    the last of them (a frozen stamp ages with the wall clock and would otherwise slip through a short window).
+    Anything else fails closed."""
+    if soft_s <= 0: return None, False, "soft review off"
+    good = [(t, q) for t, q in reads if q and quote_ok(q, t, soft_s * 1000)[0]]
+    if len(good) < 2: return None, False, f"soft review: {len(good)} re-read(s) <= {soft_s:g}s old (need 2) — fail closed"
+    (t1, q1), (t2, q2) = good[-2], good[-1]
+    young = max(good, key=lambda x: x[1].get("asOfMs") or 0)[1]
+    ok, why = quote_ok(young, now_ms, soft_s * 1000)
+    if not ok: return young, False, f"soft review: youngest re-read {why} — fail closed"
+    if not (_num(good[-1][1].get("asOfMs")) or 0) > (_num(good[0][1].get("asOfMs")) or 0):
