diff --git a/tools/replay_every_tf.py b/tools/replay_every_tf.py
new file mode 100644
index 0000000..31311f9
--- /dev/null
+++ b/tools/replay_every_tf.py
@@ -0,0 +1,44 @@
+"""Every-TF closes live + LTF inversion proof (2026-10-17): replay cards.log through the watcher gates of TWO trees
+(master vs this patch) with tools/replay_fix1016.py's dump, then diff with the new rows (ltf_arm_validated, every_tf)
+reported apart. --inject-armed puts ltfArmed=true + a desk ltfArmGate(ok=false) on every card: every card must then refuse.
+usage: python tools/replay_every_tf.py dump <tree> <cards.log> <out.jsonl> [--inject-armed]
+       python tools/replay_every_tf.py diff <base.jsonl> <new.jsonl>"""
+import json, os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import replay_fix1016 as R
+
+def dump(tree, cards, out, armed=False):
+    if not armed: return R.dump(tree, cards, out)
+    sys.path.insert(0, tree); os.chdir(tree)
+    import tests.conftest as C
+    orig = C._raw_snapshot
+    def inj(card):
+        s = orig(card); s["ltf_armed"] = True; s["ltf_arm_gate"] = {"ok": False, "why": "replay inject", "validated": 0, "setupId": None}; return s
+    C._raw_snapshot = inj
+    return R.dump(tree, cards, out)
+
+NEW_ROWS = ("ltf_arm_validated", "every_tf")
+_old_new = R.NEW
+R.NEW = lambda r: _old_new(r) or r[0] in NEW_ROWS
+
+def diff2(a, b):
+    """Rows present in BOTH trees must be identical (hash text normalised); the new rows are counted apart; a new row may only refuse."""
+    A = [json.loads(l) for l in open(a)]; B = [json.loads(l) for l in open(b)]
+    assert len(A) == len(B), (len(A), len(B))
+    keep = lambda rows: R._norm([r for r in rows if r[0] not in NEW_ROWS])
+    changed = sum(keep(x["rows"]) != keep(y["rows"]) for x, y in zip(A, B))
+    dry = lambda rows: not any(r[1] is False for r in rows if not str(r[0]).startswith("shadow:"))
+    newc = {}
+    for y in B:
+        for r in y["rows"]:
+            if r[0] in NEW_ROWS: newc[f"{r[0]}={r[1]}"] = newc.get(f"{r[0]}={r[1]}", 0) + 1
+    loosened = sum((not dry(x["rows"])) and dry(y["rows"]) for x, y in zip(A, B))
+    rep = {"cards": len(A), "shared_rows_changed": changed, "dry_pass_base": sum(dry(x["rows"]) for x in A), "dry_pass_new": sum(dry(y["rows"]) for y in B),
+           "refused_base_but_pass_new (must be 0)": loosened, "new_rows": newc}
+    print(json.dumps(rep, indent=1)); return rep
+
+if __name__ == "__main__":
+    if sys.argv[1] == "diff2": r = diff2(*sys.argv[2:4]); sys.exit(1 if r["shared_rows_changed"] or r["refused_base_but_pass_new (must be 0)"] else 0)
+    elif sys.argv[1] == "dump": dump(*sys.argv[2:5], armed="--inject-armed" in sys.argv)
+    else:
+        r = R.diff(*sys.argv[2:4]); sys.exit(1 if r["v5_rows_changed"] else 0)
