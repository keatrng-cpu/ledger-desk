diff --git a/tests/test_every_tf_ltf_arm.py b/tests/test_every_tf_ltf_arm.py
new file mode 100644
index 0000000..70562f2
--- /dev/null
+++ b/tests/test_every_tf_ltf_arm.py
@@ -0,0 +1,154 @@
+"""2026-10-17 Every-TF closes live + LTF inversion (paired with ledger-desk grok/every-tf-ltf-inversion).
+- ltf_arm_validated: HARD row, appended after the fast chain (never softened); empty mtfInversion.validated refuses every LTF-armed card.
+- every_tf: info row carrying the desk's closed-bar body/wick read per rung.
+- order-review soft path: a moving <= softMaxAgeS quote seen on >= 2 re-reads passes; frozen / too old / crossed fail closed."""
+import os, shutil, time
+from watcher import daemon, gates, fix1016 as F
+from watcher.config import Config
+
+def test_rules_pair_and_hash():
+    assert gates.RULES["ltfArm"]["mode"] == "shadow" and gates.RULES["ltfArm"]["allTfKills"]["mode"] == "shadow" and gates.RULES["ltfArm"]["validatedOnly"] is True
+    assert gates.RULES["ltfArm"]["tfs"][-1] == "1D" and gates.RULES["everyTf"]["tfs"] == ["1m", "2m", "3m", "4m", "5m", "15m", "30m", "1h", "4h", "1D"]
+    assert gates.MTF_VALIDATED == ()
+    assert gates.RULES_HASH == "0a692dc19944a8df"
+    assert F.review_soft_max_age_s() == 3.0 and gates.RULES["fire"]["orderReviewMaxAgeS"] == 1
+
+def test_ltf_armed_card_refused_when_nothing_validated():
+    n, ok, why = gates.ltf_arm_validated_row({"ltf_armed": True, "ltf_arm_gate": {"ok": False, "why": "x", "validated": 0}})
+    assert n == "ltf_arm_validated" and ok is False and "validated empty" in why
+
+def test_ltf_armed_without_desk_verdict_fails_closed():
+    assert gates.ltf_arm_validated_row({"ltf_armed": True})[1] is False
+
+def test_desk_ok_alone_is_not_enough(monkeypatch):
+    monkeypatch.setattr(gates, "MTF_VALIDATED", ("S1",))
+    assert gates.ltf_arm_validated_row({"ltf_armed": True, "ltf_arm_gate": {"ok": True, "setupId": "S2"}})[1] is False
+    assert gates.ltf_arm_validated_row({"ltf_armed": True, "ltf_arm_gate": {"ok": False, "setupId": "S1"}})[1] is False
+    assert gates.ltf_arm_validated_row({"ltf_armed": True, "ltf_arm_gate": {"ok": True, "setupId": "S1"}})[1] is True
+
+def test_not_armed_card_passes_and_names_refused_arm():
+    n, ok, why = gates.ltf_arm_validated_row({"ltf_armed": False, "ltf_arm_gate": {"ok": True, "armRefused": "no setup passed"}})
+    assert ok is True and "arm refused" in why
+
+def test_snap_reads_every_tf_and_arm_fields():
+    src = open(os.path.join(os.path.dirname(__file__), "..", "watcher", "gates.py")).read()
+    for k in ('"every_tf": strat.get("everyTf")', '"ltf_armed": strat.get("ltfArmed") is True', '"ltf_arm_gate": strat.get("ltfArmGate")'):
+        assert k in src
+
+def test_row_is_appended_after_fast_chain_and_never_soft():
+    src = open(os.path.join(os.path.dirname(__file__), "..", "watcher", "gates.py")).read()
+    i = src.index("def evaluate_fire("); j = src.index("def _evaluate_fire_v5(")
+    assert "ltf_arm_validated_row(snap)" in src[i:j]
+    k = src.index("def _evaluate_fire_core("); assert "ltf_arm_validated_row(snap)" not in src[k:]
+
+def test_every_tf_info_row():
+    e = {"closes": [{"tf": "5m", "bodyPct": 0.8, "upperPct": 0.1, "lowerPct": 0.1, "closeLoc": 0.9}], "newest": {"tf": "5m"}, "evidence": [{"tf": "5m", "parts": ["disp", "ifvg:body/wick"]}]}
+    n, ok, why = gates.every_tf_row({"every_tf": e})
+    assert n == "every_tf" and ok is True and "5m body0.8 uw0.1 lw0.1 cl0.9" in why and "ifvg:body/wick" in why
+    assert gates.every_tf_row({}) is None
+
+# ---- order review soft path ----
+def _w(monkeypatch, tmp_path, quotes):
+    monkeypatch.setenv("WATCHER_DIR", str(tmp_path)); monkeypatch.delenv("LIVE", raising=False)
+    (tmp_path / "data").mkdir(exist_ok=True)
+    shutil.copy(os.path.join(os.path.dirname(os.path.dirname(__file__)), "data/news-calendar.json"), tmp_path / "data")
+    w = daemon.Watcher(Config()); calls = []; logs = []
+    class B:
+        def quote(self, oid):
+            calls.append(oid); f = quotes.pop(0) if quotes else None
+            return f() if callable(f) else f
+    w.broker = B(); w.REVIEW_QUOTE_RETRY_S = 0; w.log = lambda ev, **k: logs.append((ev, k))
+    monkeypatch.setitem(F.FX, "reviewQuoteRetry", {**F.FX["reviewQuoteRetry"], "roundDelayMs": 0})
+    return w, calls, logs
+
+now = lambda: time.time() * 1000
+_seq = iter(range(10**6))
+def lag(s):   # a LIVE but lagging RH quote: stamp moves every read, always ~s old
+    return lambda: {"bid": 1.0, "ask": 1.1, "asOfMs": now() - s * 1000 + next(_seq) * 1e-3}
+
+def _shadow(logs):
+    ev = [k for e, k in logs if e == "review_quote_retry_shadow"]; assert len(ev) == 1; return ev[0]
+
+def test_1016_case_lagging_live_quote_shadow_logs_pass_but_refuses(monkeypatch, tmp_path):
+    # rules as shipped: reviewQuoteRetry SHADOW pending Keaton -> the live strict 1 s refusal stands
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 10)
+    assert F.mode("reviewQuoteRetry") == "shadow"
+    q, ok, why = w._review_quote({"id": "OPT1"}, None)
+    assert not ok and "old" in why and len(calls) == 3 + 4
+    v = _shadow(logs); assert v["would_pass"] is True and v["verdict"] == "pass" and "soft review pass" in v["why"]
+    assert len(v["ages_s"]["tries"]) == 3 and len(v["ages_s"]["retry"]) == 4 and all(1.7 <= a <= 1.9 for a in v["ages_s"]["retry"])
+
+def test_1016_case_soft_pass_only_when_live(monkeypatch, tmp_path):
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 10)
+    monkeypatch.setitem(F.FX, "reviewQuoteRetry", {**F.FX["reviewQuoteRetry"], "mode": "live", "roundDelayMs": 0})
+    q, ok, why = w._review_quote({"id": "OPT1"}, None)
+    assert ok and "soft review pass" in why and q["ask"] == 1.1
+
+def test_shadow_two_lagging_reads_then_rh_500_x5_refuses(monkeypatch, tmp_path):
+    # Accuracy Review #52: two 1.8 s reads, then RH 500 x5 -> shadow verdict refuse (and the live refusal stands)
+    def e500(): raise RuntimeError("RH 500 Internal Server Error")
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 2 + [e500] * 5)
+    q, ok, why = w._review_quote({"id": "OPT1"}, None)
+    assert not ok and len(calls) == 7
+    v = _shadow(logs); assert v["would_pass"] is False and v["verdict"] == "refuse" and v["ages_s"]["errors"] == 5
+    assert sum(1 for e, k in logs if e == "review_quote_error") == 5
+
+def test_shadow_rh_error_inside_window_refuses_even_if_soft_would_pass(monkeypatch, tmp_path):
+    # 3 lagging tries, then retry rounds: 2 good lagging re-reads (soft alone would pass), then RH 500 x2 -> refuse
+    def e500(): raise RuntimeError("RH 500")
+    for mode in ("shadow", "live"):
+        w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 5 + [e500] * 2)
+        monkeypatch.setitem(F.FX, "reviewQuoteRetry", {**F.FX["reviewQuoteRetry"], "mode": mode, "roundDelayMs": 0})
+        q, ok, why = w._review_quote({"id": "OPT1"}, None)
+        assert not ok, mode
+        if mode == "shadow": v = _shadow(logs); assert v["verdict"] == "refuse" and "RH error" in v["why"]
+        else: assert "RH error" in why
+    # an empty RH read counts as an error too
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 5 + [None] * 2)
+    monkeypatch.setitem(F.FX, "reviewQuoteRetry", {**F.FX["reviewQuoteRetry"], "mode": "shadow", "roundDelayMs": 0})
+    w._review_quote({"id": "OPT1"}, None); assert _shadow(logs)["verdict"] == "refuse"
+
+def test_frozen_stamp_fails_closed(monkeypatch, tmp_path):
+    t = now() - 1500
+    w, calls, logs = _w(monkeypatch, tmp_path, [lambda: {"bid": 1.0, "ask": 1.1, "asOfMs": t}] * 10)
+    q, ok, why = w._review_quote({"id": "OPT1"}, None)
+    assert not ok and _shadow(logs)["verdict"] == "refuse" and "frozen" in _shadow(logs)["why"]
+
+def test_truly_stale_fails_closed(monkeypatch, tmp_path):
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(4.0)] * 10)
+    q, ok, why = w._review_quote({"id": "OPT1"}, None)
+    assert not ok and "old" in why
+
+def test_crossed_never_soft(monkeypatch, tmp_path):
+    w, calls, logs = _w(monkeypatch, tmp_path, [lambda: {"bid": 1.2, "ask": 1.1, "asOfMs": now() - 1500 + next(_seq)}] * 10)
+    assert not w._review_quote({"id": "OPT1"}, None)[1]
+
+def test_one_reread_not_enough(monkeypatch, tmp_path):
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 4 + [None] * 10)
+    assert not w._review_quote({"id": "OPT1"}, None)[1]
+
+def test_shadow_mode_keeps_refusal(monkeypatch, tmp_path):
+    w, calls, logs = _w(monkeypatch, tmp_path, [lag(1.8)] * 10)
+    monkeypatch.setitem(F.FX, "reviewQuoteRetry", {**F.FX["reviewQuoteRetry"], "mode": "shadow", "roundDelayMs": 0})
+    assert not w._review_quote({"id": "OPT1"}, None)[1]
+
+def test_soft_age_capped_by_quote_max_age(monkeypatch):
+    monkeypatch.setitem(F.FX, "reviewQuoteRetry", {**F.FX["reviewQuoteRetry"], "softMaxAgeS": 30})
+    assert F.review_soft_max_age_s() == float(gates.RULES["fire"]["quoteMaxAgeS"])
+
+# ---- pre-buy quote-age re-check (Accuracy Review #52; mirrors the desk's mayPlaceAfterReview) ----
+def test_prebuy_recheck_uses_live_1s(monkeypatch, tmp_path):
+    w, calls, logs = _w(monkeypatch, tmp_path, [lambda: {"bid": 1.0, "ask": 1.1, "asOfMs": now()}])
+    assert w.cfg.order_review_max_age_ms == gates.RULES["fire"]["orderReviewMaxAgeS"] * 1000 == 1000
+    q, ok, why = w._review_quote({"id": "OPT1"}, None); assert ok
+    assert w._prebuy_quote_ok(q)[0]
+    t = daemon.now_ms() + 1500   # 1.5 s spent between review and send (exit preflight, sizing) -> refuse
+    monkeypatch.setattr(daemon, "now_ms", lambda: t)
+    ok2, why2 = w._prebuy_quote_ok(q); assert not ok2 and "before send" in why2
+    assert not w._prebuy_quote_ok({"bid": 1.0, "ask": 1.1, "asOfMs": now()})[0]   # not the reviewed read -> refuse
+
+def test_prebuy_recheck_blocks_fire_live_before_buy(monkeypatch, tmp_path):
+    src = open(daemon.__file__).read(); i = src.index("def fire_live("); j = src.index("self.broker.buy(c, n, lim)", i)
+    body = src[i:j]
+    assert "self._prebuy_quote_ok(q)" in body and body.index("self._prebuy_quote_ok(q)") > body.index("exitsafe.preflight_exit_path")
+    assert body.index("self._prebuy_quote_ok(q)") < body.index('sig["fired"] = time.time()')   # a refusal never burns the setup
