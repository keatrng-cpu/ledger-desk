+"""chatSweep twin: same fixture as ledger-desk scripts/chat-sweep.test.mjs (scripts/fixtures/chat-sweep-cases.json)."""
+import json, os, pytest
+from watcher import chat_sweep as cs, gates
+from watcher.config import Config
+
+CASES = json.load(open(os.path.join(os.path.dirname(__file__), "fixtures", "chat-sweep-cases.json")))
+
+def test_fixture_cases_match_desk():
+    for k in CASES:
+        r = cs.read(k["symbol"], k["minute"], k["partner"], k["nowMs"])
+        for side in ("long", "short"):
+            e, p = k["expect"][side], r[side]
+            if e is None: assert p is None, (k["name"], side); continue
+            assert p, (k["name"], side)
+            assert (p["stop"], p["entry"], p["t1"]) == (e["stop"], e["entry"], e["t1"]), (k["name"], p)
+
+def test_no_lookahead():
+    k = CASES[0]; fut = dict(k["minute"][-1]); fut.update(t=fut["t"] + 60_000, l=700, c=700.5)
+    assert cs.read("QQQ", k["minute"] + [fut], k["partner"], k["nowMs"])["long"] == cs.read("QQQ", k["minute"], k["partner"], k["nowMs"])["long"]
+
+def test_rules_live_and_values():
+    R = gates.RULES["chatSweep"]
+    assert R["mode"] == "live" and R["minContracts"] == 2 and R["stopPadPts"] == 0.10 and R["maxStopPts"] == 1.30 and R["beTriggerPts"] == 0.35
+
+def _snap(**kw):
+    p = dict(entry=712.95, stop=711.65, t1=713.8, unit=1.0)
+    s = dict(side="long", stop_px=711.65, chat_sweep=dict(mode="live", printed=True, print=p, refused=[]))
+    s.update(kw); return s
+
+def test_gate_row():
+    assert cs.gate_row(_snap())[1] is True
+    assert cs.gate_row(_snap(chat_sweep=None))[1] is False
+    assert cs.gate_row(_snap(chat_sweep=dict(printed=False, print=None, refused=["x"])))[1] is False
+    assert cs.gate_row(_snap(stop_px=709.0))[1] is False
+    assert cs.gate_row(_snap(side="short"))[1] is False   # stop below entry on a short
+
+def test_min_two_contracts():
+    assert cs.size_ok(1)[0] is False and cs.size_ok(2)[0] is True and cs.size_ok(None)[0] is False
+
+def _pos(**kw):
+    p = dict(fut_side="long", fut_ref=712.95, fut_stop=711.65, fut_t1=713.8, qty=3, chat_sweep=dict(t1=713.8, beTrigger=0.35))
+    p.update(kw); return p
+
+def test_one_contract_t1_never_trims_to_zero():
+    pos = _pos(qty=1)
+    a = cs.manage(pos, 713.8)
+    assert a[0] == "hold" and a[1] == 0 and pos["chat_be_request"] and not pos.get("chat_trim_pending")
+    assert pos["fut_stop"] == 711.65   # stop only REQUESTED; the daemon moves the broker stop
+
+def test_be_only_after_trim_fill_confirmed():
+    pos = _pos(qty=3)
+    assert cs.manage(pos, 713.8)[:2] == ("trim", 1)
+    assert {k: pos["chat_trim_pending"][k] for k in ("qty", "target_qty", "start_qty")} == {"qty": 1, "target_qty": 2, "start_qty": 3} and not pos.get("chat_be_request") and pos["fut_stop"] == 711.65
+    a = cs.manage(pos, 713.9)            # broker still shows 3 held: not filled
+    assert a[0] == "hold" and "pending" in a[2] and not pos.get("chat_be_request")
+    pos["qty"] = 2                       # broker qty dropped -> fill confirmed
+    a = cs.manage(pos, 713.9)
+    assert a[0] == "hold" and pos["chat_be_request"] and pos["chat_trim_pending"] is None and pos["trimmed"]
+
+def test_pending_trim_blocks_be_exit_no_oversell():
+    pos = _pos(qty=3, chat_be_done=True, chat_trim_pending={"qty": 1, "target_qty": 2})
+    a = cs.manage(pos, 712.0)            # through break-even while the trim is still working
+    assert a[0] == "hold" and a[1] == 0
+
+def test_be_exit_sells_only_remaining_filled_qty():
+    pos = _pos(qty=2, chat_t1=True, trimmed=True, chat_be_request=True, chat_be_done=True)
+    assert cs.manage(pos, 712.9) == ("exit", 2, "break-even stop 712.95 hit (px 712.9); selling the 2 filled contract(s) left")
+
+def test_failclosed_exits_remaining():
+    pos = _pos(qty=2, chat_be_request=True, chat_be_failclosed="broker resting stop disabled")
+    a = cs.manage(pos, 713.0); assert a[0] == "exit" and a[1] == 2
+
+def test_loss_early_no_zero_risk_after_be():
+    from datetime import datetime
+    from watcher.config import Config
+    pos = _pos(qty=1, entry=2.0, contract={"id": "x", "exp": "2026-10-23"}, fut_stop=712.95, fut_stop_orig=711.65,
+               chat_be_done=True, be_moved=True, opened_ms=0, chat_t1=True, chat_be_request=True)
+    et = datetime(2026, 10, 22, 10, 30, tzinfo=gates.ET)
+    act, q, why = gates.manage_action(pos, 2.1, Config(), et, 713.0)   # must not raise / divide by zero / early-cut
+    assert "early" not in why
+    pos2 = _pos(qty=1, entry=2.0, contract={"id": "x", "exp": "2026-10-23"}, fut_stop=712.95, opened_ms=0, chat_sweep=None, be_moved=True)
+    gates.manage_action(pos2, 2.1, Config(), et, 713.0)                 # risk 0 (stop == ref): skipped, no ZeroDivisionError
+
+def test_min_contracts_is_one_config_value(monkeypatch):
+    assert cs.min_contracts() == gates.RULES["chatSweep"]["minContracts"]
+    monkeypatch.setitem(cs.CS, "minContracts", 1)
+    assert cs.size_ok(1)[0] is True
+
+# ---- daemon break-even: REAL broker stop replace via a FAKE broker (no real orders) ----
+def _dm(monkeypatch, held=2, resting=True):
+    from tests.test_exitsafe import FakeBroker, _daemon_stub
+    b = FakeBroker(held=held); dm, me, alerts, logs = _daemon_stub(b, monkeypatch)
+    if not resting: monkeypatch.setenv("EXIT_SAFE_RESTING_STOP", "0")
+    b.mark = lambda _id: (2.5, {"bid_price": "2.5"})
+    from watcher import exitsafe as ex
+    monkeypatch.setattr(ex.time, "sleep", lambda s: None)
+    return dm, me, b, alerts, logs
+
+def test_daemon_be_replaces_broker_stop(monkeypatch):
+    dm, me, b, alerts, logs = _dm(monkeypatch)
+    pos = {"contract": {"id": "opt1"}, "qty": 2, "entry": 2.0}
+    me._place_resting_stop(pos); old = pos["resting_stop_id"]; assert b.orders[old][2][0] == 1.0
+    ok, why = dm.Watcher._chat_be_move(me, pos, None)
+    assert ok, why
+    assert b.states[old] == "cancelled" and pos["resting_stop_id"] != old
+    k, q, args = b.orders[pos["resting_stop_id"]]; assert k == "stop" and q == 2 and args[0] == 2.0   # stop at entry premium
+
+def test_daemon_be_fails_closed_without_broker_stop(monkeypatch):
+    dm, me, b, alerts, logs = _dm(monkeypatch, resting=False)
+    pos = {"contract": {"id": "opt1"}, "qty": 2, "entry": 2.0}
+    ok, why = dm.Watcher._chat_be_move(me, pos, None)
+    assert not ok and "disabled" in why and not b.sends()
+
+
+# ---- Accuracy 10/23: pending-trim timeout / terminal states ----
+def test_partial_trim_clears_marker_and_requests_be():
+    pos = _pos(qty=4); assert cs.manage(pos, 713.8)[:2] == ("trim", 2)
+    pos["qty"] = 3; pos["chat_trim_pending"]["state"] = "partially_filled"     # 1 of 2 filled, order terminal
+    a = cs.manage(pos, 713.9)
+    assert pos["chat_trim_pending"] is None and pos["trimmed"] and pos["chat_be_request"] and "partial" in pos["chat_trim_note"]
+    assert a is None or a[0] != "trim"                                             # never re-trims
+
+@pytest.mark.parametrize("st", ["cancelled", "rejected"])
+def test_cancelled_or_rejected_trim_falls_back(st):
+    pos = _pos(qty=2); assert cs.manage(pos, 713.8)[:2] == ("trim", 1)
+    pos["chat_trim_pending"]["state"] = st                                          # nothing filled
+    a = cs.manage(pos, 713.9)
+    assert pos["chat_trim_pending"] is None and pos["chat_t1"] and not pos.get("trimmed") and st in pos["chat_trim_note"]
+    assert a is None or a[0] != "trim"
+
+def test_pending_trim_times_out_and_older_rules_run(monkeypatch):
+    pos = _pos(qty=2); assert cs.manage(pos, 713.8)[:2] == ("trim", 1)
+    assert cs.manage(pos, 713.8)[0] == "hold"                                        # still pending
+    t0 = pos["chat_trim_pending"]["at"]; monkeypatch.setattr(cs.time, "time", lambda: t0 + cs.TRIM_PENDING_S + 1)
+    a = cs.manage(pos, 713.8)
+    assert pos["chat_trim_pending"] is None and "timeout" in pos["chat_trim_note"] and a[0] != "trim"
+    assert cs.manage(pos, 713.8) is None                                             # next pass: falls through to the legacy rules
+
+# ---- Accuracy 10/23: break-even failure exits inline, never double-closes (FakeBroker, no real orders) ----
+def _dm2(monkeypatch, held=2):
+    dm, me, b, alerts, logs = _dm(monkeypatch, held=held)
+    from watcher import exitsafe as ex
+    me._ladder_close = lambda pos, qty, md, act: dm.Watcher._ladder_close(me, pos, qty, md, act)
+    me._chat_be_move = lambda pos, et: dm.Watcher._chat_be_move(me, pos, et)
+    monkeypatch.setattr(ex, "run_ladder", lambda g, qty, fb, **k: _fake_ladder(b, g, qty))
+    return dm, me, b, alerts, logs
+
+def _fake_ladder(b, g, qty):
+    g.clear(); r = g.send("ladder", b.sell, g.c, qty, 2.4); oid = r["id"]
+    b._fill(oid, qty); b.states[oid] = "filled"; return "filled", [(0, 2.4, False, qty)]
+
+def _run_be(dm, me, pos):
+    from datetime import datetime
+    et = datetime(2026, 10, 22, 10, 30, tzinfo=gates.ET)
+    ok, why = dm.Watcher._chat_be_move(me, pos, et)
+    return ok, why, (None if ok else dm.Watcher._chat_be_failclose(me, pos, et, why))
+
+def test_failed_replace_exits_inline_and_rolls_back(monkeypatch):
+    dm, me, b, alerts, logs = _dm2(monkeypatch)
+    pos = {"contract": {"id": "opt1"}, "qty": 2, "entry": 2.0, "opt_stop": 1.0}
+    me._place_resting_stop(pos); old = pos["resting_stop_id"]
+    b.place_stop_limit_close = lambda *a: {"id": None}                              # replacement back with NO order id
+    ok, why, r = _run_be(dm, me, pos)
+    assert not ok and pos["opt_stop"] == 1.0 and b.states[old] == "cancelled"        # option stop rolled back
+    # an id-less stop may be live at RH: a market exit could double-close -> no sell, alert manual
+    assert r == "uncertain" and not b.sends("sell") and any("NOT selling" in x for x in alerts)
+
+def test_replace_raises_exits_inline_same_call(monkeypatch):
+    dm, me, b, alerts, logs = _dm2(monkeypatch)
+    pos = {"contract": {"id": "opt1"}, "qty": 2, "entry": 2.0, "opt_stop": 1.0}
+    me._place_resting_stop(pos); old = pos["resting_stop_id"]
+    def boom(*a): raise RuntimeError("RH 503")
+    b.place_stop_limit_close = boom
+    ok, why, r = _run_be(dm, me, pos)
+    assert not ok and r == "exited" and pos["opt_stop"] == 1.0
+    sells = b.sends("sell"); assert len(sells) == 1 and sells[0][3] == 2 and b.held == 0   # one close, the full held qty
+    assert b.states[old] == "cancelled" and not b.working()
+
+def test_old_stop_fills_mid_replace_no_sell(monkeypatch):
+    dm, me, b, alerts, logs = _dm2(monkeypatch)
+    me.state = {"days": {}, "position": None}
+    pos = {"contract": {"id": "opt1"}, "qty": 2, "entry": 2.0, "opt_stop": 1.0}
+    me._place_resting_stop(pos); old = pos["resting_stop_id"]
+    b.order_fill = lambda oid: (2, 1.0)
+    b.fill_on_cancel.add(old)                                                       # the stop fills as we cancel it
+    me.state["position"] = pos
+    ok, why, r = _run_be(dm, me, pos)
+    assert not ok and r == "closed_by_stop" and not b.sends("sell") and me.state["position"] is None
+    assert pos["opt_stop"] == 1.0
+
+def test_cancel_throws_stop_still_resting_no_market_exit(monkeypatch):
+    dm, me, b, alerts, logs = _dm2(monkeypatch)
+    pos = {"contract": {"id": "opt1"}, "qty": 2, "entry": 2.0, "opt_stop": 1.0}
+    me._place_resting_stop(pos); old = pos["resting_stop_id"]
+    def bad_cancel(oid): b.log.append(("cancel", oid)); raise RuntimeError("timeout")
+    b.cancel = bad_cancel
+    ok, why, r = _run_be(dm, me, pos)
+    assert not ok and r == "stop_resting" and not b.sends("sell") and b.states[old] == "queued"
+    assert pos["resting_stop_id"] == old and pos["opt_stop"] == 1.0 and len(b.sends("stop")) == 1
+
+
+@pytest.mark.parametrize("final,filled,expect", [("partially_filled", 1, "partial"), ("cancelled", 0, "cancelled"), ("rejected", 0, "rejected")])
+def test_daemon_trim_order_state_feeds_marker(monkeypatch, final, filled, expect):
+    dm, me, b, alerts, logs = _dm(monkeypatch, held=4)
+    pos = _pos(qty=4); assert cs.manage(pos, 713.8)[:2] == ("trim", 2)
+    r = b.sell({"id": "opt1"}, 2, 2.6); oid = r["id"]; pos["chat_trim_pending"]["order_id"] = oid
+    dm.Watcher._chat_trim_poll(me, pos); assert pos["chat_trim_pending"]["state"] == "queued"
+    assert cs.manage(pos, 713.9)[0] == "hold"                                        # still working
+    if filled: b._fill(oid, filled)
+    b.states[oid] = final; pos["qty"] = b.held
+    dm.Watcher._chat_trim_poll(me, pos); assert pos["chat_trim_pending"]["state"] == final
+    a = cs.manage(pos, 713.9)
+    assert pos["chat_trim_pending"] is None and expect in pos["chat_trim_note"] and (a is None or a[0] != "trim")
+    assert len(b.sends("sell")) == 1                                                  # nothing re-sent
+
+
+# ---- Accuracy round 3: no-sell outcomes never set the chat exit flag; the NEXT pass re-checks and sells only if unprotected ----
+def _dm3(monkeypatch, held=2):
+    dm, me, b, alerts, logs = _dm2(monkeypatch, held=held)
+    me.state = {"days": {}, "position": None}
+    me._chat_be_failclose = lambda pos, et, why, recheck=False: dm.Watcher._chat_be_failclose(me, pos, et, why, recheck)
+    pos = {"contract": {"id": "opt1"}, "qty": held, "entry": 2.0, "opt_stop": 1.0, "chat_be_request": True}
+    me._place_resting_stop(pos); me.state["position"] = pos
+    return dm, me, b, alerts, logs, pos
+
+def _et():
+    from datetime import datetime
+    return datetime(2026, 10, 22, 10, 30, tzinfo=gates.ET)
+
+def _chat_exit_flag_off(pos):
+    p = _pos(qty=pos["qty"], **{k: v for k, v in pos.items() if k.startswith("chat_be")})
+    a = cs.manage(p, 713.0)
+    return not pos.get("chat_be_failclosed") and (a is None or a[0] != "exit")
+
+def test_next_pass_stop_resting_kept_no_sell(monkeypatch):
+    dm, me, b, alerts, logs, pos = _dm3(monkeypatch); old = pos["resting_stop_id"]
+    def bad_cancel(oid): raise RuntimeError("timeout")
+    b.cancel = bad_cancel
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is False                     # stop_resting: protected, manage continues
+    assert pos["chat_be_recheck"]["outcome"] == "stop_resting" and _chat_exit_flag_off(pos)
+    assert any("ORIGINAL stop" in a and "not break-even" in a for a in alerts)    # truthful alert
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is False                     # NEXT pass: still resting
+    assert pos["chat_be_kept_old_stop"] == old and not pos.get("chat_be_recheck") and not b.sends("sell")
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is False and not b.sends("sell") and len(b.sends("stop")) == 1   # no retry loop
+
+def test_next_pass_stop_resting_then_gone_sells_once(monkeypatch):
+    dm, me, b, alerts, logs, pos = _dm3(monkeypatch); old = pos["resting_stop_id"]
+    b.cancel = lambda oid: (_ for _ in ()).throw(RuntimeError("timeout"))
+    dm.Watcher._chat_be_step(me, pos, _et()); assert not b.sends("sell")
+    b.states[old] = "cancelled"                                                   # the stop is gone by the next pass
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True
+    assert len(b.sends("sell")) == 1 and b.sends("sell")[0][3] == 2 and b.held == 0
+
+def test_next_pass_uncertain_never_sells(monkeypatch):
+    dm, me, b, alerts, logs, pos = _dm3(monkeypatch)
+    b.place_stop_limit_close = lambda *a: {"id": None}
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True
+    assert pos["chat_be_recheck"]["outcome"] == "uncertain" and _chat_exit_flag_off(pos)
+    n_alerts = len(alerts)
+    for _ in range(3): assert dm.Watcher._chat_be_step(me, pos, _et()) is True
+    assert not b.sends("sell") and len(alerts) == n_alerts                         # no sell, no alert spam
+
+def test_next_pass_unknown_then_unprotected_sells(monkeypatch):
+    dm, me, b, alerts, logs, pos = _dm3(monkeypatch)
+    b.place_stop_limit_close = lambda *a: (_ for _ in ()).throw(RuntimeError("RH 503"))
+    real = b.position_qty; flaky = {"n": 0}
+    def pq(i):
+        flaky["n"] += 1
+        if flaky["n"] == 1: raise RuntimeError("RH down")
+        return real(i)
+    b.position_qty = pq
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True
+    assert pos["chat_be_recheck"]["outcome"] == "unknown" and _chat_exit_flag_off(pos) and not b.sends("sell")
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True                       # NEXT pass: re-read ok, old stop cancelled
+    assert len(b.sends("sell")) == 1 and b.held == 0
+
+def test_next_pass_kill_switch(monkeypatch):
+    dm, me, b, alerts, logs, pos = _dm3(monkeypatch)
+    b.place_stop_limit_close = lambda *a: (_ for _ in ()).throw(RuntimeError("RH 503"))
+    stop = {"on": False}; me.stopped = lambda: stop["on"]
+    orig_cancel = b.cancel
+    def cancel_then_stop(oid): orig_cancel(oid); stop["on"] = True               # STOP file appears mid-replace
+    b.cancel = cancel_then_stop
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True
+    assert pos["chat_be_recheck"]["outcome"] == "kill_switch" and _chat_exit_flag_off(pos)
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True and not b.sends("sell")   # NEXT pass, STOP still there
+    stop["on"] = False
+    assert dm.Watcher._chat_be_step(me, pos, _et()) is True and len(b.sends("sell")) == 1   # STOP removed, provably unprotected
