diff -ruN a/watcher/chat_sweep.py b/watcher/chat_sweep.py
--- a/watcher/chat_sweep.py	1969-12-31 18:00:00.000000000 -0600
+++ b/watcher/chat_sweep.py	2026-10-23 00:46:41.371671500 -0500
@@ -0,0 +1,171 @@
+"""Chat sweep (Keaton 2026-10-22 21:56 CT, "Make the desk trade like chat"; shared rules `chatSweep`).
+
+Twin of ledger-desk src/lib/smc/chat-sweep.ts and of live-tape armed_s.py (setup) / armed_r.py (last-6-bar stop).
+Setup: the session high/low (set before the last 3 closed 1m bars) wick-swept within the last 3 closed 1m bars,
+then the newest closed 1m bar closes back inside and beyond the prior 2 bars' extreme, body >= 0.8 x avg range,
+partner book same colour, newest closed 5m not against. Both sides scored; a side arms only when it prints.
+Stop = sweep wick or last-6-bar extreme (further one) +/- 0.10, max 1.30 from entry. Min 2 contracts, half off at
+T1, stop to break-even at T1 / +0.35. Closed bars only; every timeframe cut at the same now (no lookahead).
+"""
+from datetime import datetime
+from zoneinfo import ZoneInfo
+import time
+from . import gates as _g
+
+CS = _g.RULES["chatSweep"]
+ET = ZoneInfo("America/New_York")
+
+# watcher-local safety constant (not a shared rule; RULES_HASH unchanged): a pending T1 trim marker older than this is
+# dropped and normal management resumes, so a lost/stuck trim can never hold the older exit rules off indefinitely.
+TRIM_PENDING_S = 90
+TRIM_TERMINAL = {"filled", "partially_filled", "cancelled", "canceled", "rejected", "failed", "expired", "done"}
+
+def live():
+    return CS.get("mode") == "live"
+
+def unit(symbol, px, R=CS):
+    return 1.0 if str(symbol).upper() in R["etfSymbols"] else px / R["unitRefPx"]
+
+def _r2(x):  # JS Math.round(x*100)/100 parity (half up)
+    import math
+    return math.floor(x * 100 + 0.5) / 100
+
+def _hm(s): return int(s[:2]) * 60 + int(s[3:5])
+def _et(ms): return datetime.fromtimestamp(ms / 1000, ET)
+
+def closed5m(b1, now_ms):
+    m = {}
+    for b in b1:
+        if b["t"] + 60_000 > now_ms: continue
+        k = (b["t"] // 300_000) * 300_000; d = m.get(k)
+        if d is None: m[k] = dict(t=k, o=b["o"], h=b["h"], l=b["l"], c=b["c"])
+        else: d["h"] = max(d["h"], b["h"]); d["l"] = min(d["l"], b["l"]); d["c"] = b["c"]
+    return [m[k] for k in sorted(m) if k + 300_000 <= now_ms]
+
+def read(symbol, minute, partner, now_ms, R=CS):
+    out = dict(long=None, short=None, refused=[], barT=None, sessionHigh=None, sessionLow=None, inWindow=False)
+    closed = lambda xs: sorted([b for b in xs if b["t"] + 60_000 <= now_ms], key=lambda b: b["t"])
+    allb = closed(minute)
+    if not allb: return out
+    n = _et(now_ms); day = n.date(); s0 = _hm(R["sessionStartEt"])
+    in_sess = lambda b: _et(b["t"]).date() == day and _et(b["t"]).hour * 60 + _et(b["t"]).minute >= s0
+    q1 = [b for b in allb if in_sess(b)]; p1 = [b for b in closed(partner) if in_sess(b)]
+    q5 = [b for b in closed5m(minute, now_ms) if in_sess(b)]
+    nm = n.hour * 60 + n.minute
+    out["inWindow"] = s0 <= nm < _hm(R["entryEndEt"])
+    if len(q1) < R["minBars"] or not p1 or not q5: return out
+    b = q1[-1]; out["barT"] = b["t"]; pb = p1[-1]; p5 = q5[-1]
+    if pb["t"] != b["t"]:
+        out["refused"] += [dict(side="long", why="partner 1m bar not aligned"), dict(side="short", why="partner 1m bar not aligned")]; return out
+    idx = allb.index(b); prev = allb[max(0, idx - R["avgRangeBars"]):idx]
+    if not prev: return out
+    ar = sum(x["h"] - x["l"] for x in prev) / len(prev)
+    prior = q1[:-R["sweepBars"]]; rec = q1[-R["sweepBars"]:]
+    shi = max(x["h"] for x in prior); slo = min(x["l"] for x in prior); out["sessionHigh"] = shi; out["sessionLow"] = slo
+    whi = max(x["h"] for x in rec); wlo = min(x["l"] for x in rec)
+    pr = q1[-1 - R["priorBars"]:-1]; lo2 = min(x["l"] for x in pr); hi2 = max(x["h"] for x in pr)
+    ext = q1[-R["stopExtremeBars"]:]
+    u = unit(symbol, b["c"], R); pc = pb["c"] - pb["o"]; body = abs(b["c"] - b["o"]); tol = R["fiveMinTolPts"] * u
+    def mk(side, level, wick):
+        L = side == "long"; pad = R["stopPadPts"] * u
+        extreme = min(x["l"] for x in ext) if L else max(x["h"] for x in ext)
+        base = min(wick, extreme) if L else max(wick, extreme)
+        stop = _r2(base - pad if L else base + pad); entry = b["c"]; risk = _r2(abs(entry - stop))
+        if risk > R["maxStopPts"] * u + 1e-9:
+            out["refused"].append(dict(side=side, why=f"stop {stop} is {risk} from {entry} (max {_r2(R['maxStopPts'] * u)})")); return None
+        if not out["inWindow"]:
+            out["refused"].append(dict(side=side, why=f"outside {R['sessionStartEt']}-{R['entryEndEt']} ET")); return None
+        d = 1 if L else -1
+        return dict(side=side, printed=True, t=b["t"], level=level, wick=wick, entry=entry, stop=stop, risk=risk,
+                    t1=_r2(entry + d * R["t1Pts"] * u), runner=_r2(entry + d * R["runnerPts"] * u), beTrigger=_r2(R["beTriggerPts"] * u),
+                    minContracts=R["minContracts"], unit=u)
+    disp = body >= R["dispBodyAvg"] * ar
+    if whi > shi and b["c"] < shi and b["c"] < b["o"] and b["c"] < lo2 and disp and pc < 0 and p5["c"] <= p5["o"] + tol: out["short"] = mk("short", shi, whi)
+    if wlo < slo and b["c"] > slo and b["c"] > b["o"] and b["c"] > hi2 and disp and pc > 0 and p5["c"] >= p5["o"] - tol: out["long"] = mk("long", slo, wlo)
+    return out
+
+def gate_row(snap):
+    """Fire gate: live -> the desk's chatSweep verdict for the card side must say printed, its stop past entry within
+    maxStopPts (scaled), and the card's stop must be that stop. Missing verdict fails closed."""
+    if not live(): return ("chat_sweep", True, "chatSweep shadow")
+    cs = snap.get("chat_sweep")
+    if not isinstance(cs, dict): return ("chat_sweep", False, "no desk chatSweep verdict on the card — refuse (fail closed)")
+    p = cs.get("print")
+    if cs.get("printed") is not True or not isinstance(p, dict):
+        return ("chat_sweep", False, "chat sweep not printed on this side" + (f" ({'; '.join(cs.get('refused') or [])})" if cs.get("refused") else ""))
+    try:
+        entry, stop, u = float(p["entry"]), float(p["stop"]), float(p.get("unit") or 1)
+    except (KeyError, TypeError, ValueError):
+        return ("chat_sweep", False, "chatSweep print missing entry/stop — refuse")
+    L = snap.get("side") == "long"
+    if (L and not stop < entry) or (not L and not stop > entry): return ("chat_sweep", False, f"chat stop {stop} on the wrong side of {entry}")
+    if abs(entry - stop) > CS["maxStopPts"] * u + 1e-6: return ("chat_sweep", False, f"chat stop {stop} > max {CS['maxStopPts']}x{u:.2f} from {entry}")
+    sp = snap.get("stop_px") if snap.get("stop_px") is not None else snap.get("strategy_stop")
+    try: sp = float(sp) if sp is not None else None
+    except (TypeError, ValueError): sp = None
+    if sp is not None and abs(sp - stop) > 0.5 * u:   # desk seal rounds to tick; anything else is a different plan
+        return ("chat_sweep", False, f"card stop {sp} is not the chat stop {stop}")
+    return ("chat_sweep", True, f"chat sweep {snap.get('side')} printed: entry {entry} stop {stop} T1 {p.get('t1')}")
+
+def min_contracts():
+    """ONE config value (shared rules chatSweep.minContracts). Keaton is deciding min 2 vs the B+ 1-contract rung:
+    either answer is a one-line change to shared/desk-rules.json (+ the watcher copy)."""
+    return int(CS["minContracts"])
+
+def size_ok(nct):
+    """Min contracts for a chat-sweep fire (armed_s/armed_r: 'ABORT 2x not affordable')."""
+    if nct is None: return False, "no size"
+    m = min_contracts()
+    return (nct >= m, f"{nct}ct (chatSweep min {m})")
+
+def manage(pos, px):
+    """Pure state machine (no broker calls). Returns (action, qty, why) or None (fall through to the legacy rules).
+    - T1: qty >= 2 -> trim floor(qty * t1Frac) (>= 1, never 0) and wait for the fill; qty < 2 -> no trim, stop move only.
+    - Break-even is REQUESTED (pos['chat_be_request']) only after the trim fill is confirmed (broker qty dropped to the
+      target) or at +beTrigger in favour. The daemon moves the BROKER stop (cancel-confirm-replace) and only then sets
+      chat_be_done / fut_stop = ref; if it cannot and the position is PROVEN unprotected, it sets chat_be_failclosed (and has already sold inline); no-sell outcomes use chat_be_recheck instead.
+    - While a trim is pending (<= TRIM_PENDING_S) profit-taking rules are held; loss/stop exits still run (gates.manage_action, trim cancelled first); the break-even exit sells only pos['qty'] (filled, held)."""
+    cs = pos.get("chat_sweep")
+    if not live() or not isinstance(cs, dict) or pos.get("fut_ref") is None: return None
+    q = int(pos.get("qty") or 0)
+    if q <= 0: return ("hold", 0, "no filled qty")
+    pend = pos.get("chat_trim_pending")
+    if pend:
