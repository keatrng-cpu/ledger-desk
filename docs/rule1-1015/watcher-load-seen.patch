diff --git a/tests/test_rule1_shadow.py b/tests/test_rule1_shadow.py
index 9afdbb0..fc1acfc 100644
--- a/tests/test_rule1_shadow.py
+++ b/tests/test_rule1_shadow.py
@@ -70,3 +70,18 @@ def test_load_seen_skips_non_dict_lines_and_survives_os_errors(tmp_path):
     assert rule1_shadow.load_seen(str(tmp_path), DAY_MS) == {("ES", "long", "09:00")}
     d = tmp_path / "isdir"; d.mkdir(); (d / rule1_shadow.FILE).mkdir()          # IsADirectoryError is an OSError, not FileNotFoundError
     assert rule1_shadow.load_seen(str(d), DAY_MS) == set()
+
+def test_load_seen_tolerates_undecodable_bytes(tmp_path):
+    good = {"kind": "rule1_would_fire", "ts": DAY_MS, "symbol": "MNQ", "side": "short", "at": "09:05"}
+    (tmp_path / rule1_shadow.FILE).write_bytes(b"\xff\xfe\x80 not utf-8\n" + json.dumps(good).encode() + b"\n\xc3\x28{\"kind\"\n")
+    assert rule1_shadow.load_seen(str(tmp_path), DAY_MS) == {("MNQ", "short", "09:05")}
+
+def test_load_seen_catches_valueerror_from_the_reader(tmp_path, monkeypatch):
+    (tmp_path / rule1_shadow.FILE).write_text("{}\n")
+    import builtins
+    real = builtins.open
+    def bad_open(*a, **k):
+        if str(a[0]).endswith(rule1_shadow.FILE): raise ValueError("boom")
+        return real(*a, **k)
+    monkeypatch.setattr(builtins, "open", bad_open)
+    assert rule1_shadow.load_seen(str(tmp_path), DAY_MS) == set()
