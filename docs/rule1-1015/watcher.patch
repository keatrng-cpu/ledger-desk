new file mode 100644
index 0000000..18e7c23
--- /dev/null
+++ b/tests/test_rule1_shadow.py
@@ -0,0 +1,23 @@
+import json
+from watcher import rule1_shadow
+
+TK = {"mode": "shadow", "symbol": "MNQ", "side": "long", "at": 1, "swept": "ONL", "bonus": True, "entry": 30758.0, "stop": 30590.72,
+      "target": 31259.83, "runner": 30906.0, "option": {"underlier": "QQQ", "right": "call", "strike": 753, "delta": 0.6, "contracts": 3, "premium": 1.98, "dte": 0}}
+
+
+def test_logs_would_fire_once_and_never_orders(tmp_path):
+    seen = set()
+    rows = rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, seen, 5)
+    assert len(rows) == 1 and rows[0]["broker"] is False and rows[0]["orders"] == 0 and rows[0]["delta_ok"]
+    assert rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, seen, 6) == []
+    assert len(open(tmp_path / "rule1_shadow.jsonl").read().splitlines()) == 1
+
+
+def test_ignores_non_shadow_and_missing(tmp_path):
+    assert rule1_shadow.log(str(tmp_path), {"rule1": [dict(TK, mode="live")]}, set()) == []
+    assert rule1_shadow.log(str(tmp_path), {}, set()) == []
+
+
+def test_module_has_no_broker_import():
+    src = open(rule1_shadow.__file__).read()
+    assert "broker" not in src.split('"""')[2].replace('"broker": False', "")
