+import json
+from watcher import rule1_shadow
+
+TK = {"mode": "shadow", "symbol": "MNQ", "side": "long", "at": 1, "swept": "ONL", "bonus": True, "entry": 30758.0, "stop": 30590.72,
+      "target": 31259.83, "runner": 30906.0, "option": {"underlier": "QQQ", "right": "call", "strike": 753, "delta": 0.6, "contracts": 3, "premium": 1.98, "dte": 0}}
+
+
+def test_logs_would_fire_once_and_never_orders(tmp_path):
+    seen = set()
+    rows = rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, seen, 5)
+    assert len(rows) == 1 and rows[0]["broker"] is False and rows[0]["orders"] == 0 and rows[0]["delta_ok"]
+    assert rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, seen, 6) == []
+    assert len(open(tmp_path / "rule1_shadow.jsonl").read().splitlines()) == 1
+
+
+def test_ignores_non_shadow_and_missing(tmp_path):
+    assert rule1_shadow.log(str(tmp_path), {"rule1": [dict(TK, mode="live")]}, set()) == []
+    assert rule1_shadow.log(str(tmp_path), {}, set()) == []
+
+
+def test_module_has_no_broker_import():
+    src = open(rule1_shadow.__file__).read()
+    assert "broker" not in src.split('"""')[2].replace('"broker": False', "")
+
+
+DAY_MS = 1792076400000          # 2026-10-15 10:00 CT
+NEXT_DAY_MS = DAY_MS + 86_400_000
+
+
+def test_dedupe_survives_restart(tmp_path):
+    first = rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, rule1_shadow.load_seen(str(tmp_path), DAY_MS), DAY_MS)
+    assert len(first) == 1
+    # restart: fresh process, seen rebuilt from today's rows in rule1_shadow.jsonl
+    seen = rule1_shadow.load_seen(str(tmp_path), DAY_MS + 60_000)
+    assert ("MNQ", "long", 1) in seen
+    assert rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, seen, DAY_MS + 60_000) == []
+    assert len(open(tmp_path / "rule1_shadow.jsonl").read().splitlines()) == 1
+
+
+def test_load_seen_only_today_and_tolerates_junk(tmp_path):
+    rule1_shadow.log(str(tmp_path), {"rule1": [TK]}, set(), DAY_MS)
+    with open(tmp_path / "rule1_shadow.jsonl", "a") as f:
+        f.write("not json\n")
+    assert rule1_shadow.load_seen(str(tmp_path), NEXT_DAY_MS) == set()
+    assert rule1_shadow.load_seen(str(tmp_path / "missing"), DAY_MS) == set()
+
+
+def test_daemon_seeds_seen_on_first_poll(tmp_path):
+    from watcher import daemon
+
+    class Cfg:
+        def path(self, p):
+            return str(tmp_path / p) if p else str(tmp_path)
+
+    logged = []
+
+    def mk():
+        w = daemon.Watcher.__new__(daemon.Watcher)
+        w.cfg = Cfg(); w.log = lambda kind, **kw: logged.append(kind)
+        return w
+
+    mk()._rule1_shadow({"rule1": [TK]}, DAY_MS)
+    mk()._rule1_shadow({"rule1": [TK]}, DAY_MS + 120_000)   # new Watcher = restart
+    assert logged.count("rule1_would_fire") == 1 and "rule1_shadow_error" not in logged
+    assert len(open(tmp_path / "rule1_shadow.jsonl").read().splitlines()) == 1
+
+def test_load_seen_skips_non_dict_lines_and_survives_os_errors(tmp_path):
+    good = {"kind": "rule1_would_fire", "ts": DAY_MS, "symbol": "ES", "side": "long", "at": "09:00"}
+    (tmp_path / rule1_shadow.FILE).write_text("\n".join([json.dumps([1, 2]), "7", "null", '"str"', json.dumps(good)]) + "\n")
+    assert rule1_shadow.load_seen(str(tmp_path), DAY_MS) == {("ES", "long", "09:00")}
+    d = tmp_path / "isdir"; d.mkdir(); (d / rule1_shadow.FILE).mkdir()          # IsADirectoryError is an OSError, not FileNotFoundError
+    assert rule1_shadow.load_seen(str(d), DAY_MS) == set()
