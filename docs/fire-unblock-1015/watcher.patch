+def plan_pick(pinned, cand):
+    """Plan hysteresis twin of src/lib/execution/plan-pin.ts choosePlan. Plans: dict(symbol, side, entry, stop, t1, q, rr,
+    fvg_failed, minute). Returns (plan, why). A failed-FVG plan is dropped; a different side/symbol replaces; the pinned
