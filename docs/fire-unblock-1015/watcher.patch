 def test_card_t1_rr_under_one_refused(cfg):     # 13:01 CT ES case (risk 10.88pt, T1 0.52R)
     c = load("card_aplus_armed.json"); c["wire"]["strategy"]["rr1"] = 0.52
     assert "t1_rr" in fails(gates.evaluate_fire(gates.snapshot(c), cfg, NOW, {"entries": 0}, broker(), CAL))
+
+@pytest.mark.fast
+def test_soft_velocity_cut_reaches_the_sizing_row(cfg):
+    """fire-unblock review F2: the soft-velocity one-step cut is applied BEFORE size_contracts, so the sizing row
+    (which daemon.fire_live reads for n) carries the cut contract count."""
+    def sizing(exp):
+        c = load("card_aplus_armed.json"); c["wire"]["strategy"]["loss"] = {"velocity": {"expMin": exp}}
+        (c["wire"]["floor"].get("ticket") or {})["contracts"] = 20
+        s = gates.snapshot(c); g = gates.evaluate_fire(s, cfg, NOW, {"entries": 0}, broker(quote={"ask": 1.00, "bid": 0.98, "asOfMs": NOW - 2000, "delta": -0.5}), CAL)
+        row = [w for n, ok, w in g if n == "sizing"][0]
+        return int(row.split("ct")[0].split("->")[-1].strip()), [n for n, _, _ in g]
+    fast_n, names_fast = sizing(10); slow_n, names_slow = sizing(90)
+    vc = lambda ns: any(n.endswith("fast:velocity_cut") for n in ns)
+    assert vc(names_slow) and not vc(names_fast)
+    assert slow_n < fast_n, (slow_n, fast_n)
