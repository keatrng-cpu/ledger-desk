diff -ruN b2/tests/test_fire_unblock.py n2/tests/test_fire_unblock.py
--- a/tests/test_fire_unblock.py	1969-12-31 18:00:00.000000000 -0600
+++ b/tests/test_fire_unblock.py	2026-10-15 10:55:50.276926632 -0500
@@ -0,0 +1,130 @@
+"""Fire unblock 2026-10-15 (audits/strictness-1015): persist 20s keyed per symbol:side that survives flips / failed rows,
+soft velocity, failed-FVG plans dropped, plan hysteresis. Twin of ledger-desk scripts/fire-unblock.test.mjs."""
+import pytest
+from watcher import fastchain as fc, gates
+pytestmark = pytest.mark.fast
+
+def mnq_0940(**kw):
+    # today's 09:40 CT MNQ short B+ (q 0.6499 card; qRaw 0.858): entry 29877.38 stop 29924.24 T1 29748.42, 1h+4h bear
+    s = {"ok": True, "at": "09:40:00", "band": "B+", "q": 0.6499, "symbol": "MNQ", "side": "short", "entry": 29877.38, "stop_px": 29924.24,
+         "first_target": 29748.42, "tape_prices": {"MNQ": 29876.0}, "atr": 40.0, "brain_word": "STAND", "brain_symbol": "MNQ", "brain_side": "short",
+         "brain_missing": "POI in correct half", "htf_bias": [("1h", "bear"), ("4h", "bear")], "loss": {"velocity": {"expMin": 46}}}
+    s.update(kw); return s
+
+def rows(s): return dict((n, ok) for n, ok, _ in fc.setup_rows(s))
+
+def poll(st, t_from, t_to, step=2_000, **kw):
+    for t in range(t_from, t_to + 1, step): st = fc.streak_next(st, mnq_0940(at=f"t{t}", **kw), t)
+    return st
+
+@pytest.mark.shipped_mode
+def test_rules_fire_unblock():
+    assert fc.FC["mode"] == "shadow" and not fc.live() and fc.shadow()
+    assert fc.FC["minHoldS"] == 20 and fc.FC["velocityMode"] == "soft" and "fast:velocity" not in fc.FC["hard"]
+    assert fc.FC["persistDip"] == {"_doc": fc.FC["persistDip"]["_doc"], "maxCards": 1, "maxS": 5}
+    assert fc.FC["targetLadder"]["t1RrMin"] == 0.6 and fc.FC["targetLadder"]["evOn"] == "t1"
+    for h in ("fast:plan", "fast:geometry", "fast:entry", "fast:agree", "fast:persist", "band"): assert h in fc.FC["hard"], h
+    for k, v in {"A+": 0.75, "A": 0.68, "A-": 0.65, "B+": 0.60}.items(): assert gates.RULES["bandEdges"][k] == v
+
+def test_velocity_soft_rows_and_cut_flag():
+    s = mnq_0940(); assert "fast:velocity" not in rows(s) and all(rows(s).values())
+    assert fc.velocity_cut(s) is True and fc.velocity_cut(mnq_0940(loss={"velocity": {"expMin": 12}})) is False
+    s["fast_streak"] = poll(None, 0, 20_000); d = dict((n, ok) for n, ok, _ in fc.apply([], s, 20_000))
+    assert d["soft:fast:velocity"] is True and d["fast:persist"] is True
+
+def test_persist_needs_continuous_qualifying_conditions():
+    st = poll(None, 0, 10_000)
+    st = fc.streak_next(st, mnq_0940(at="dip", band="B", q=0.5999), 12_000)          # 1 dip card, 2s: tolerated
+    assert st["since_ms"] == 0 and st["dips"] == 1
+    st = fc.streak_next(st, mnq_0940(at="back"), 14_000); assert st["since_ms"] == 0 and st["dips"] == 0
+    st = fc.streak_next(st, mnq_0940(at="c", tape_prices={"MNQ": 29910.0}), 16_000)  # fast:entry fail is not a dip
+    st = fc.streak_next(st, mnq_0940(at="d", entry=29880.0, plan_id="p2"), 18_000)  # plan swap, same side
+    assert st["since_ms"] == 0 and st["dips"] == 0
+    two = fc.streak_next(fc.streak_next(st, mnq_0940(at="e", band="B"), 19_000), mnq_0940(at="f", band="B"), 20_000)
+    assert two["since_ms"] is None                                                  # 2 consecutive dips: reset
+    slow = fc.streak_next(st, mnq_0940(at="g", band="B"), 24_500); assert slow["since_ms"] is None   # one dip but > 5s since last qualifying
+    assert fc.streak_next(st, mnq_0940(strategy_invalidated=True), 19_000)["since_ms"] is None     # PR #19 strategy.invalidated
+    assert fc.streak_next(st, mnq_0940(tape_prices={"MNQ": 29930.0}), 19_000)["since_ms"] is None  # through the stop
+    assert fc.streak_next(st, mnq_0940(tape_prices={"MNQ": 29740.0}), 19_000)["since_ms"] is None  # T1 traded
+
+def test_thirty_minutes_of_b_then_b_plus_does_not_pass_instantly():
+    st = poll(None, 0, 2_000)                                       # one good card at t=0..2s
+    st = poll(st, 4_000, 1_800_000, step=3_000, band="B", q=0.55)   # 30 min of B
+    st = fc.streak_next(st, mnq_0940(at="bplus"), 1_803_000)
+    assert st["since_ms"] == 1_803_000
+    g = dict((n, ok) for n, ok, _ in fc.apply([], dict(mnq_0940(), fast_streak=st), 1_803_000)); assert g["fast:persist"] is False
+    st = poll(st, 1_805_000, 1_823_000)
+    g = dict((n, ok) for n, ok, _ in fc.apply([], dict(mnq_0940(), fast_streak=st), 1_823_000)); assert g["fast:persist"] is True
+
+def test_replay_0940_mnq_short_fires_after_20s():
+    st = poll(None, 0, 21_000, step=3_000)
+    g = fc.apply([("brain", False, "STAND POI in correct half"), ("weekly_lock", True, "ok"), ("daily_cap", True, "ok")], dict(mnq_0940(), fast_streak=st), 21_000)
+    bad = [n for n, ok, _ in g if ok is False]; assert bad == [], bad
+
+@pytest.mark.parametrize("sym,e,st,t1,px,atr", [
+    ("MNQ", 30569.0, 30653.0, 30420.0, 30580.0, 60.0),    # 10/14 08:30-08:50 CE short
+    ("MNQ", 30483.0, 30540.0, 30380.0, 30483.0, 60.0),    # 10/14 09:00
+    ("ES", 7806.0, 7816.5, 7790.0, 7806.0, 8.0),          # 10/14 09:17
+    ("MNQ", 30300.0, 30345.0, 30220.0, 30300.0, 50.0),    # 10/14 11:41 (T1 46 min away: velocity now soft)
+    ("MNQ", 30179.0, 30249.5, 30080.0, 30179.0, 50.0),    # 10/14 12:30
+])
+def test_replay_1014_aligned_shorts_pass(sym, e, st, t1, px, atr):
+    s = mnq_0940(symbol=sym, entry=e, stop_px=st, first_target=t1, tape_prices={sym: px}, atr=atr, brain_symbol=sym, loss={"velocity": {"expMin": 46}})
+    assert all(rows(s).values()), rows(s)
+
+def test_0945_counter_bias_a_minus_long_stays_blocked():
+    s = mnq_0940(side="long", band="A-", q=0.66, entry=29860.0, stop_px=29820.0, first_target=29940.0, tape_prices={"MNQ": 29862.0}, brain_side="short")
+    r = rows(s); assert r["fast:agree"] is False                   # 1h + 4h both bear against a long (and brain on the short)
+
+def test_rr_below_one_and_stop_side_stay_hard():
+    assert rows(mnq_0940(first_target=29850.0))["fast:plan"] is False   # R:R < 1
+    assert rows(mnq_0940(tape_prices={"MNQ": 29925.0}))["fast:entry"] is False
+
+def test_failed_fvg_plan_dropped():
+    assert rows(mnq_0940(plan_fvg_failed=True, plan_id="x"))["fast:plan"] is False
+
+def P(**kw):
+    d = {"symbol": "MNQ", "side": "short", "entry": 29877.38, "stop": 29924.24, "t1": 29748.42, "q": 0.65, "rr": 2.75, "fvg_failed": False, "minute": 1}
+    d.update(kw); return d
+
+def test_plan_hysteresis():
+    a = P(); b = P(entry=29890.0, stop=29930.0, q=0.67, rr=2.8, minute=2)
+    assert fc.plan_pick(a, b)[0] is a                                   # +0.02 q: not clearly better
+    c = P(entry=29890.0, q=0.71, minute=2); assert fc.plan_pick(a, c)[0] is c
+    d = P(entry=29890.0, rr=3.1, minute=2); assert fc.plan_pick(a, d)[0] is d
+    assert fc.plan_pick(a, P(entry=1.0, q=0.9, minute=1))[0] is a       # same build minute never swaps
+    assert fc.plan_pick(P(fvg_failed=True), b)[0] is b                  # pinned plan's FVG failed -> dropped
+    assert fc.plan_pick(a, P(entry=1.0, q=0.99, fvg_failed=True, minute=2))[0] is a
+    assert fc.plan_pick(a, P(side="long", minute=2))[1] == "book/side change"
+
+def test_persist_accumulates_across_polls_live_1002_es_long():
+    """Live 10:02 CT ES B+ long (entry 7757.75): every refusal read 'held None over 0 cards' because fast:entry failed on the
+    poll. Entry distance is a fire-time check now; the hold accumulates across polls and passes at 20s."""
+    base = dict(symbol="ES", side="long", band="B+", q=0.61, entry=7757.75, stop_px=7750.04, first_target=7773.0, atr=15.41,
+                brain_symbol="ES", brain_side="long", htf_bias=[("1h", "bull"), ("4h", "bull")], loss={"velocity": {"expMin": 30.8}})
+    st = None
+    for i, t in enumerate(range(0, 24_000, 3_000)):
+        px = 7771.0 if i % 2 == 0 else 7760.0
+        st = fc.streak_next(st, mnq_0940(at=f"p{i}", tape_prices={"ES": px}, **base), t)
+        assert st["since_ms"] == 0, (i, st)
+    g = dict((n, ok) for n, ok, _ in fc.apply([], dict(mnq_0940(tape_prices={"ES": 7760.0}, **base), fast_streak=st), 21_000))
+    assert g["fast:persist"] is True and g["fast:entry"] is True
+    g = dict((n, ok) for n, ok, _ in fc.apply([], dict(mnq_0940(tape_prices={"ES": 7771.0}, **base), fast_streak=st), 21_000))
+    assert g["fast:persist"] is True and g["fast:entry"] is False
+
+def test_target_ladder_0959_es_long():
+    """Keaton 09:59 CT ES long 7757.13 / stop 7743.25: T1 7772.75 R:R 1.13 -> gate on T2 7780.25 (R:R 1.67); T1 stays first scale-out."""
+    s = mnq_0940(symbol="ES", side="long", entry=7757.13, stop_px=7743.25, first_target=7772.75, t2=7780.25, tape_prices={"ES": 7758.0}, atr=15.0,
+                 brain_symbol="ES", brain_side="long", htf_bias=[("1h", "bull"), ("4h", "bull")])
+    t, which, rr = fc.gate_target(s); assert which == "t2" and t == 7780.25 and rr >= 1.5
+    assert all(rows(s).values())
+    assert fc.gate_target(dict(s, t2=7775.0))[1] == "t1"                 # next pool R:R < 1.5: stay on T1
+    assert fc.gate_target(dict(s, first_target=7775.0))[1] == "t1"       # T1 R:R >= 1.2: no ladder
+    assert rows(dict(s, first_target=7760.0, t2=7765.0))["fast:plan"] is False
+    assert fc.gate_target(dict(s, first_target=7758.5, t2=7790.0))[1] == "t1"     # T1 at 0.1R: no ladder (t1RrMin 0.6)
+    assert rows(dict(s, first_target=7758.5, t2=7790.0))["fast:plan"] is False
+
+def test_ladder_ev_stays_on_t1_and_shadow_keeps_live_chain_on_t1(monkeypatch):
+    s = mnq_0940(symbol="ES", side="long", entry=7757.13, stop_px=7743.25, first_target=7772.75, t2=7780.25)
+    assert gates.gate_tgt(s) == 7780.25                                          # fast tests run live
+    monkeypatch.setitem(fc.FC, "mode", "shadow"); assert gates.gate_tgt(s) == 7772.75
