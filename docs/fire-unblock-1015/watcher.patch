+def gate_target(snap):
+    """Target ladder twin of fast-chain.ts gateTarget: (target, 't1'|'t2', rr). T1 stays the first scale-out."""
+    L = FC.get("targetLadder"); side = snap.get("side")
+    e, st, t1, t2 = (_num(snap.get(k)) for k in ("entry", "stop_px", "first_target", "t2"))
+    def rr_of(t):
+        if None in (e, st, t) or e == st: return None
+        return ((e - t) if side == "short" else (t - e)) / abs(e - st)
+    r1 = rr_of(t1)
+    if L and r1 is not None and r1 < L["t1RrBelow"] and t2 is not None and t1 is not None and ((t2 < t1) if side == "short" else (t2 > t1)):
+        r2 = rr_of(t2)
+        if r2 is not None and r2 >= L["nextRrMin"]: return t2, "t2", r2
+    return t1, "t1", r1
+
+def velocity_soft():
