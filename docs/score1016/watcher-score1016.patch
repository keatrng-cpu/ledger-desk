diff --git a/run.sh b/run.sh
index cafde79..a709c6d 100755
--- a/run.sh
+++ b/run.sh
@@ -3,7 +3,21 @@
 cd "$(dirname "$0")"
 set -a; [ -f .env ] && . ./.env; set +a
 export LIVE="${LIVE:-0}"
+# resilience: a missing venv used to loop silently every 5 s with nothing polling. Alert (log + alerts.log + webhooks) and stop.
+alert_novenv() {
+  MSG="$(date -Is) desk-watcher: .venv/bin/python missing — daemon NOT running (rebuild: python3 -m venv .venv && .venv/bin/pip install -r requirements.lock)" python3 - <<'PY' || echo "$(date -Is) desk-watcher: .venv missing (alert helper failed)" >> daemon.out
+import json, os, urllib.request
+m = os.environ["MSG"]
+open("daemon.out", "a").write(m + "\n")
+open("alerts.log", "a").write(json.dumps({"kind": "alert", "text": m}) + "\n")
+for url, body in ((os.environ.get("ALERT_WEBHOOK"), {"text": m, "content": m}), (os.environ.get("SLACK_DESK_WEBHOOK_URL"), {"text": m})):
+    if url:
+        try: urllib.request.urlopen(urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"}), timeout=5)
+        except Exception: pass
+PY
+}
 while true; do
+  if [ ! -x .venv/bin/python ]; then alert_novenv; exit 3; fi
   .venv/bin/python -m watcher.daemon >> daemon.out 2>&1
   echo "$(date -Is) daemon exited rc=$? — restarting in 5s" >> daemon.out
   [ -f STOP_DAEMON ] && exit 0
