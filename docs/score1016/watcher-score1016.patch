diff --git a/watcher/score1016.py b/watcher/score1016.py
new file mode 100644
index 0000000..e473d7a
--- /dev/null
+++ b/watcher/score1016.py
@@ -0,0 +1,18 @@
+"""score1016 — watcher half of the event-driven five-layer score (TS twin src/lib/smc/score1016.ts, rules block score1016).
+Shadow only: rows are logged as shadow:score1016:<item> (status True, so they never gate); nothing here changes a fire."""
+from .gates import RULES
+
+SC = RULES.get("score1016") or {}
+
+def mode(k):
+    return "live" if (SC.get(k) or {}).get("mode") == "live" else "shadow"
+
+def shadow_rows(snap):
+    s = snap.get("score1016") or {}
+    if not isinstance(s, dict) or "S" not in s: return []
+    e = s.get("entry") or {}; x = s.get("exit") or {}
+    head = f"S {s.get('S')} p {s.get('p')} grade {s.get('grade')} (fire at {s.get('thr')}) layers {s.get('layers')} src {s.get('src')}"
+    if s.get("wouldFire"):
+        return [("shadow:score1016:would_fire", True, f"WOULD FIRE {snap.get('symbol')} {snap.get('side')} {e.get('kind')} {e.get('entry')} stop {e.get('stop')} "
+                 f"T1 {x.get('t1')} ({x.get('partialFrac')}) -> BE -> T2 {x.get('t2')} | {head}")]
+    return [("shadow:score1016:read", True, head)]
