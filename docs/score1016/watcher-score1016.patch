diff --git a/tests/test_score1016.py b/tests/test_score1016.py
new file mode 100644
index 0000000..c64b5d3
--- /dev/null
+++ b/tests/test_score1016.py
@@ -0,0 +1,43 @@
+"""score1016 watcher half: shadow rows never gate; poll-gap alert; run.sh venv guard."""
+import os, subprocess, shutil, json
+from watcher import score1016 as S, gates
+
+def test_every_item_shadow():
+    for k in ("score", "entry", "exit", "caps", "poiHalf", "altEntryIfvgCe", "setupPerSweep", "scopeCaps"):
+        assert S.mode(k) == "shadow", k
+
+def test_would_fire_row_is_shadow_and_true():
+    snap = {"symbol": "MNQ", "side": "short", "score1016": {"S": 89.0, "p": 0.57, "grade": "A", "thr": 83, "layers": {}, "src": "ltfArm 1m PDH",
+            "wouldFire": True, "entry": {"kind": "limit", "entry": 29930.63, "stop": 29944.25}, "exit": {"t1": 29917.0, "t2": 29903.4, "partialFrac": 0.5}}}
+    rows = S.shadow_rows(snap)
+    assert rows and rows[0][0] == "shadow:score1016:would_fire" and rows[0][1] is True and "WOULD FIRE" in rows[0][2]
+    assert S.shadow_rows({}) == [] and S.shadow_rows({"score1016": {"error": "x"}}) == []
+    assert gates.all_pass([("x", True, "")] + rows)
+
+class _W:
+    def __init__(self): self.state = {}; self.alerts = []
+    def alert(self, t, **k): self.alerts.append(t)
+
+def test_poll_gap_alert_over_15s_once():
+    from watcher.daemon import Watcher
+    w = _W(); f = Watcher._poll_gap_check
+    t = f(w, None, "fast", 1000.0); t = f(w, t, "fast", 1010.0); assert w.alerts == []
+    t = f(w, t, "fast", 1026.5); assert len(w.alerts) == 1 and "16.5s" in w.alerts[0]
+    t = f(w, t, "idle", 1100.0); assert len(w.alerts) == 1      # idle polls are 60 s by design
+
+def test_run_sh_alerts_and_exits_when_venv_missing(tmp_path):
+    d = tmp_path / "w"; d.mkdir(); shutil.copy(os.path.join(os.path.dirname(__file__), "..", "run.sh"), d / "run.sh")
+    r = subprocess.run(["bash", str(d / "run.sh")], capture_output=True, timeout=20, env={**os.environ, "ALERT_WEBHOOK": "", "SLACK_DESK_WEBHOOK_URL": ""})
+    assert r.returncode == 3
+    assert "venv/bin/python missing" in (d / "daemon.out").read_text()
+    assert json.loads((d / "alerts.log").read_text().splitlines()[0])["kind"] == "alert"
+
+
+def test_score1016_hook_fails_closed_to_error_row(monkeypatch):
+    """A crash inside score1016.shadow_rows logs shadow:score1016:error (status True) and never breaks evaluate_fire."""
+    from watcher import gates, score1016
+    monkeypatch.setattr(score1016, "shadow_rows", lambda snap: (_ for _ in ()).throw(RuntimeError("boom")))
+    monkeypatch.setattr(gates, "_evaluate_fire_v5", lambda *a, **k: [("x", True, "")])
+    rows = gates.evaluate_fire({}, None, 0, {}, None, ())
+    err = [r for r in rows if r[0] == "shadow:score1016:error"]
+    assert err and err[0][1] is True and "boom" in err[0][2]
