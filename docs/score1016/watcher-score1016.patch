+    # ---- resilience (live: alert only, no strategy change): a poll gap > POLL_GAP_ALERT_S (15 s) in the fast/slow window ----
+    def _poll_gap_check(self, last_ok, mode, now_s):
+        lim = float(os.environ.get("POLL_GAP_ALERT_S", "15"))
+        if mode != "idle" and last_ok is not None and now_s - last_ok > lim:
+            from . import hygiene
+            if hygiene.alert_once(self.state.setdefault("sig", {}), "poll_gap", int(now_s // 60), now_s):
+                self.alert(f"watcher poll gap {now_s - last_ok:.1f}s > {lim:.0f}s in {mode} window — cards were not read in that span")
+        return now_s
+
+    def _poll_gap_check_restart(self):
+        """On start: if the last heartbeat is > POLL_GAP_ALERT_S old and we are inside a polling window, the daemon was down."""
+        try:
+            hb = (self.state.get("heartbeat") or {}).get("ts")
+            if not hb: return
+            gap = (datetime.now(gates.ET) - datetime.fromisoformat(hb)).total_seconds()
+            mode = gates.mode_for(self.cfg, datetime.now(gates.ET))
+            if mode != "idle" and gap > float(os.environ.get("POLL_GAP_ALERT_S", "15")):
+                self.alert(f"watcher restarted after {gap:.0f}s without a poll (last heartbeat {hb}) inside the {mode} window")
+        except Exception as e:
+            self.log("poll_gap_check_error", error=str(e))
+
