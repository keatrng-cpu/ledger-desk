diff --git a/watcher/push_shadow.py b/watcher/push_shadow.py
new file mode 100644
index 0000000..f979c9f
--- /dev/null
+++ b/watcher/push_shadow.py
@@ -0,0 +1,112 @@
+"""Push-path SHADOW for desk-watcher (ledger-desk shared/push-shadow.json, audits/overnight-1016 #3).
+
+OFF unless DESK_PUSH_SHADOW=1. A background thread reads the desk's SSE stream (/api/desk/card-stream) and logs, per new
+card, the bar close -> desk build -> push receipt -> decision latency; the poll path logs the same card's poll receipt.
+push_shadow.jsonl lets the two be compared per card `at`. Rule 1 tickets get `would_decide_s` (bar close -> decision on
+the push path, persist exempt) against the 10 s target. It never imports the order code, never reaches gates or
+firing, and never changes the rules hash. A stream failure only logs and backs off.
+"""
+import json, os, threading, time
+
+FILE = "push_shadow.jsonl"
+TARGET_S = 10.0
+
+
+def enabled(env=None):
+    return (env if env is not None else os.environ).get("DESK_PUSH_SHADOW") == "1"
+
+
+def stream_url(desk_url, env=None):
+    e = env if env is not None else os.environ
+    return e.get("DESK_PUSH_URL") or desk_url.rstrip("/").rsplit("/", 1)[0] + "/card-stream"
+
+
+def parse_sse(lines):
+    """Yield the JSON body of each `card` event from an iterable of decoded SSE lines."""
+    ev, data = None, []
+    for ln in lines:
+        if ln == "":
+            if ev == "card" and data:
+                try:
+                    yield json.loads("\n".join(data))
+                except ValueError:
+                    pass
+            ev, data = None, []
+        elif ln.startswith(":"):
+            continue
+        elif ln.startswith("event:"):
+            ev = ln[6:].strip()
+        elif ln.startswith("data:"):
+            data.append(ln[5:].lstrip())
+
+
+def row(path, at, latency, rule1, recv_ms, decide_ms=None):
+    decide_ms = decide_ms if decide_ms is not None else recv_ms
+    lat = latency if isinstance(latency, dict) else {}
+    bc, built = lat.get("barCloseAt"), lat.get("builtAt")
+    r = {"ts": recv_ms, "kind": f"{path}_card", "path": path, "broker": False, "orders": 0, "live": False, "at": at,
+         "bar_close_ms": bc, "built_ms": built, "recv_ms": recv_ms,
+         "build_s": round((built - bc) / 1000, 2) if isinstance(bc, (int, float)) and isinstance(built, (int, float)) else None,
+         "transit_s": round((recv_ms - built) / 1000, 2) if isinstance(built, (int, float)) else None,
+         "bar_to_decision_s": round((decide_ms - bc) / 1000, 2) if isinstance(bc, (int, float)) else None, "rule1": []}
+    for tk in rule1 or []:
+        if isinstance(tk, dict) and isinstance(tk.get("at"), (int, float)):
+            s = round((decide_ms - tk["at"]) / 1000, 2)
+            r["rule1"].append({"symbol": tk.get("symbol"), "side": tk.get("side"), "at": tk["at"], "would_decide_s": s, "under_target": s <= TARGET_S})
+    r["under_target"] = r["bar_to_decision_s"] is not None and r["bar_to_decision_s"] <= TARGET_S
+    return r
+
+
+class Logger:
+    """Append rows, first sighting per (path, card at) only."""
+    def __init__(self, path_dir):
+        self.path_dir, self.seen, self.lock = path_dir, set(), threading.Lock()
+
+    def note(self, path, at, latency, rule1, recv_ms, decide_ms=None):
+        if not at:
+            return None
+        with self.lock:
+            if (path, at) in self.seen:
+                return None
+            self.seen.add((path, at))
+            if len(self.seen) > 5000:
+                self.seen = set(list(self.seen)[-2000:])
+            r = row(path, at, latency, rule1, recv_ms, decide_ms)
+            with open(os.path.join(self.path_dir, FILE), "a") as f:
+                f.write(json.dumps(r) + "\n")
+            return r
+
+    def note_poll(self, card, recv_ms):
+        c = card or {}
+        w = c.get("wire") or {}
+        return self.note("poll", c.get("at"), w.get("latency"), c.get("rule1") or w.get("rule1"), recv_ms)
+
+
+def listen(session, url, logger, stop, log=lambda *a, **k: None, now_ms=lambda: int(time.time() * 1000)):
+    """Blocking SSE loop (run in a daemon thread). Reconnects with back-off; never raises."""
+    back = 0.5
+    while not stop.is_set():
+        try:
+            with session.get(url, stream=True, timeout=(5, 35), headers={"accept": "text/event-stream", "cache-control": "no-cache"}) as r:
+                if r.status_code != 200:
+                    log("push_shadow_off", status=r.status_code); stop.wait(60); continue
+                back = 0.5
+                for body in parse_sse(r.iter_lines(decode_unicode=True)):
+                    t = now_ms()
+                    logger.note("push", body.get("at"), body.get("latency"), body.get("rule1"), t)
+                    if stop.is_set():
+                        break
+        except Exception as e:   # network / parse: log, back off, retry
+            log("push_shadow_error", error=str(e)[:200])
+            stop.wait(back); back = min(back * 2, 30)
+
+
+def start(cfg, log):
+    """Start the listener thread when DESK_PUSH_SHADOW=1; returns (logger, stop_event) or (None, None)."""
+    if not enabled():
+        return None, None
+    import requests
+    lg, stop = Logger(cfg.path("")), threading.Event()
+    threading.Thread(target=listen, args=(requests.Session(), stream_url(cfg.desk_url), lg, stop, log), daemon=True, name="push-shadow").start()
+    log("push_shadow_start", url=stream_url(cfg.desk_url))
+    return lg, stop
