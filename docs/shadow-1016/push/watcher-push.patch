+import json, threading
+from watcher import push_shadow as P
+
+LAT = {"mode": "shadow", "barCloseAt": 1_000_000, "builtAt": 1_002_900, "buildMs": 2900, "targetS": 10}
+
+
+def test_off_by_default_and_url():
+    assert P.enabled({}) is False and P.enabled({"DESK_PUSH_SHADOW": "0"}) is False and P.enabled({"DESK_PUSH_SHADOW": "1"}) is True
+    assert P.stream_url("https://x.app/api/desk/card", {}) == "https://x.app/api/desk/card-stream"
+    assert P.stream_url("https://x.app/api/desk/card", {"DESK_PUSH_URL": "u"}) == "u"
+
+
+def test_parse_sse_cards_only():
+    body = {"at": "a1", "latency": LAT, "rule1": []}
+    lines = [": hello", "", "retry: 500", "event: card", "id: a1", "data: " + json.dumps(body), "", "event: other", "data: {}", "", "event: card", "data: {bad", ""]
+    assert list(P.parse_sse(lines)) == [body]
+
+
+def test_row_latency_and_rule1_target(tmp_path):
+    lg = P.Logger(str(tmp_path))
+    r = lg.note("push", "a1", LAT, [{"symbol": "ES", "side": "long", "at": 1_000_000}], 1_004_000)
+    assert r["build_s"] == 2.9 and r["transit_s"] == 1.1 and r["bar_to_decision_s"] == 4.0 and r["under_target"]
+    assert r["rule1"][0]["would_decide_s"] == 4.0 and r["rule1"][0]["under_target"]
+    assert r["broker"] is False and r["orders"] == 0 and r["live"] is False
+    assert lg.note("push", "a1", LAT, [], 1_005_000) is None              # first sighting only
+    p = lg.note_poll({"at": "a1", "wire": {"latency": LAT}}, 1_006_000)    # same card on the poll path is its own row
+    assert p["path"] == "poll" and p["bar_to_decision_s"] == 6.0
+    assert len(open(tmp_path / P.FILE).read().splitlines()) == 2
+
+
+def test_listen_logs_push_rows_and_survives_errors(tmp_path):
+    body = {"at": "a2", "latency": LAT, "rule1": []}
+    stop = threading.Event()
+
+    class R:
+        status_code = 200
+        def __enter__(self): return self
+        def __exit__(self, *a): return False
+        def iter_lines(self, decode_unicode=True):
+            yield from ["event: card", "data: " + json.dumps(body), ""]
+            stop.set()
+
+    calls = {"n": 0}
+    class S:
+        def get(self, *a, **k):
+            calls["n"] += 1
+            if calls["n"] == 1: raise OSError("boom")
+            return R()
+    lg = P.Logger(str(tmp_path)); errs = []
+    P.listen(S(), "u", lg, stop, log=lambda ev, **k: errs.append(ev), now_ms=lambda: 1_003_000)
+    assert errs == ["push_shadow_error"]
+    assert json.loads(open(tmp_path / P.FILE).read())["kind"] == "push_card"
+
+
+def test_no_order_code():
+    src = open(P.__file__).read().split('"""')[2]
+    for bad in ("broker.", "import broker", "optexec", "gates", "place_"):
+        assert bad not in src
+
+
+def test_daemon_poll_note_noop_when_off(tmp_path):
+    from watcher import daemon
+    class D: pass
+    d = D(); d.log = lambda *a, **k: None
+    daemon.Watcher._push_note(d, {"at": "x"}, 1)   # no logger -> no file, no error
+    d._push_logger = P.Logger(str(tmp_path))
+    daemon.Watcher._push_note(d, {"at": "x", "wire": {"latency": LAT}}, 1_004_000)
+    assert json.loads(open(tmp_path / P.FILE).read())["path"] == "poll"
