+import json
+from watcher import rule1_lane, fastchain
+
+TK = {"mode": "shadow", "symbol": "MNQ", "side": "long", "at": 1_000_000, "entry": 30758.0, "stop": 30590.72,
+      "lane": {"lane": "rule1", "wouldFire": True, "ageS": 2.9, "persistExempt": True, "live": False, "builtAt": 1_002_900}}
+
+
+def test_would_fire_once_with_latency_and_never_orders(tmp_path):
+    seen = set()
+    rows = rule1_lane.log(str(tmp_path), {"rule1": [TK], "at": "x"}, seen, 1_005_000)
+    r = rows[0]
+    assert r["would_fire"] and r["broker"] is False and r["orders"] == 0 and r["live"] is False
+    assert r["latency_s"] == 5.0 and r["card_build_s"] == 2.9 and r["watcher_recv_s"] == 2.1
+    assert r["legacy_min_latency_s"] == 5.0 + fastchain.PERSIST_HOLD_S and r["legacy_observed_latency_s"] == 101.0
+    assert rule1_lane.log(str(tmp_path), {"rule1": [TK]}, seen, 1_006_000) == []
+    assert len(open(tmp_path / rule1_lane.FILE).read().splitlines()) == 1
+
+
+def test_stale_stop_and_non_shadow(tmp_path):
+    assert rule1_lane.log(str(tmp_path), {"rule1": [TK]}, set(), 1_000_000 + 301_000)[0]["would_fire"] is False
+    assert rule1_lane.log(str(tmp_path), {"rule1": [TK]}, set(), 1_005_000, stop_file=True)[0]["why"] == "STOP file"
+    assert rule1_lane.log(str(tmp_path), {"rule1": [dict(TK, mode="live")]}, set()) == []
+    assert rule1_lane.log(str(tmp_path), {}, set()) == []
+
+
+def test_restart_dedupe(tmp_path):
+    now = 1792076400000
+    tk = dict(TK, at=now - 5000)
+    rule1_lane.log(str(tmp_path), {"rule1": [tk]}, set(), now)
+    assert (tk["symbol"], tk["side"], tk["at"]) in rule1_lane.load_seen(str(tmp_path), now)
+    assert rule1_lane.load_seen(str(tmp_path), now + 86_400_000) == set()
+
+
+def test_no_order_code_imported():
+    src = open(rule1_lane.__file__).read().split('"""')[2]
+    for bad in ("broker.", "import broker", "optexec", "place_", "fire("):
+        assert bad not in src
+
+
+def test_daemon_logs_lane_without_touching_gates(tmp_path, monkeypatch):
+    from watcher import daemon
+    calls = []
+    class D: pass
+    d = D(); d.cfg = type("C", (), {"path": lambda self, x: str(tmp_path / x) if x else str(tmp_path)})()
+    d.log = lambda ev, **k: calls.append(ev); d.stopped = lambda: False
+    daemon.Watcher._rule1_shadow(d, {"rule1": [TK]}, 1_005_000)
+    assert "rule1_lane_would_fire" in calls and "rule1_would_fire" in calls
+
+
+def test_reads_wire_rule1_like_the_live_card(tmp_path):
+    rows = rule1_lane.log(str(tmp_path), {"at": "x", "wire": {"rule1": [TK]}}, set(), 1_005_000)
+    assert len(rows) == 1 and rows[0]["would_fire"]
