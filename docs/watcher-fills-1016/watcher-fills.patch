@@ -0,0 +1,51 @@
+"""watcher/fills_sink.py: payloads from logged records, outbox retry, dry-run/shadow skip."""
+import json
+from types import SimpleNamespace
+from watcher import fills_sink as fs
+
+POS = {"signal": "sig-85e8feddd99efe46", "fut_symbol": "ES", "fut_side": "long", "fut_stop": 7775.0, "fut_t1": 7792.25, "order_id": "6ad1151c-8bc9-4446-a02f-9223be78a8f9",
+       "ordered": 1, "qty": 0, "entry": 2.98, "contract": {"symbol": "SPY", "exp": "2026-10-16", "strike": 770.0, "type": "call"},
+       "card": {"symbol": "ES", "side": "long", "band": "B+", "entry": 7782.63, "stop_px": 7775.0, "first_target": 7792.25}}
+ST = {"position": POS}
+
+def test_payloads_from_records():
+    p = fs.payload_for({"kind": "alert", "text": "FIRE B+ ES long q=0.6 entry=7782.63", "signal": POS["signal"]}, ST)
+    assert p["event"] == "placed" and p["orderId"] == POS["order_id"] and p["plan"] == {"entry": 7782.63, "stop": 7775.0, "t1": 7792.25}
+    assert p["option"] == {"underlier": "SPY", "right": "call", "strike": 770.0, "expiry": "2026-10-16"}
+    f = fs.payload_for({"kind": "alert", "text": "FILLED 1 @ 2.96 (filled)"}, {"position": {**POS, "qty": 1, "entry": 2.96}})
+    assert f["event"] == "filled" and f["fillPx"] == 2.96 and f["qty"] == 1 and f["orderId"] == POS["order_id"]
+    x = fs.payload_for({"kind": "alert", "text": "EXIT 1 @ 2.6: ticket stop 7775.0 hit (px 7775.0)", "result": {"id": "6ad115c6-72e9-4303-ad11-ab83fd3726ba", "account_number": "995386158"}},
+                       {"position": {**POS, "qty": 1, "entry": 2.96}})
+    assert x["event"] == "exit" and x["exitPx"] == 2.6 and x["exitUnderlierPx"] == 7775.0 and x["optionPnl"] == -36.0
+    assert x["orderId"].startswith("6ad115c6") and "995386158" not in json.dumps(x)
+    assert fs.payload_for({"kind": "alert", "text": "DESK A ES long"}, ST) is None
+    assert fs.payload_for({"kind": "alert", "text": "FILLED 1 @ 2.96", "shadow": True}, ST) is None
+    assert fs.payload_for({"kind": "alert", "text": "FILLED 1 @ 2.96"}, {"position": None}) is None
+
+def test_outbox_retry_and_order(tmp_path):
+    status = [503]; seen = []
+    s = fs.Sink(str(tmp_path / "outbox.jsonl"), url="https://desk/api/desk/fills", token="t", post=lambda u, p, t: seen.append(p["event"]) or status[0])
+    s.enqueue({"event": "placed"}); s.enqueue({"event": "filled"})
+    assert s.flush() == 0 and len(s._read()) == 2          # desk down: both kept, order preserved
+    status[0] = 200
+    assert s.flush() == 2 and s._read() == []
+    assert seen == ["placed", "placed", "filled"]
+    status[0] = 422; s.enqueue({"event": "exit"})
+    assert s.flush() == 1 and s._read() == []                # permanently refused rows are dropped, not retried forever
+
+def test_unconfigured_keeps_outbox(tmp_path):
+    s = fs.Sink(str(tmp_path / "o.jsonl"), url="", token="")
+    s.enqueue({"event": "filled"}); assert s.flush() == 0 and len(s._read()) == 1
+
+def test_dry_run_and_fire_disabled_skip(tmp_path):
+    rec = {"kind": "alert", "text": "FILLED 1 @ 2.96"}
+    cfg = SimpleNamespace(live=False, fire_enabled=True, path=lambda n: str(tmp_path / n))
+    assert fs.on_record(rec, ST, cfg) is None
+    cfg.live, cfg.fire_enabled = True, False
+    assert fs.on_record(rec, ST, cfg) is None
+    assert not (tmp_path / "outbox.jsonl").exists()
+
+def test_url_derivation():
+    assert fs.fills_url({"WATCHER_STATUS_URL": "https://x.app/api/desk/watcher"}) == "https://x.app/api/desk/fills"
+    assert fs.fills_url({"WATCHER_FILLS_URL": "https://y/f", "WATCHER_STATUS_URL": "https://x/a/b"}) == "https://y/f"
+    assert fs.fills_url({}) == ""
