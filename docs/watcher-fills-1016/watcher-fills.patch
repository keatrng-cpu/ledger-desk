diff -ruN '--exclude=data' '--exclude=tools' a/watcher/fills_sink.py b/watcher/fills_sink.py
--- a/watcher/fills_sink.py	1969-12-31 18:00:00.000000000 -0600
+++ b/watcher/fills_sink.py	2026-10-16 01:41:01.885196876 -0500
@@ -0,0 +1,216 @@
+"""Live order events -> desk /api/desk/fills (room_orders + desk_trades). Spec: ledger-desk docs/watcher-fills-1016.
+
+Off the order path: on_record() only builds a payload from a record the daemon ALREADY logged plus state["position"],
+appends it to outbox.jsonl and wakes a background thread that POSTs it (WATCHER_STATUS_TOKEN bearer, 5 s timeout).
+Anything not acknowledged stays in the outbox and is retried (at most every RETRY_S). Never raises into the daemon,
+never places/cancels/gates anything. Skipped entirely for dry-run (cfg.live False or fire disabled) and shadow records,
+and a no-op (nothing written) when the URL or WATCHER_STATUS_TOKEN is unset. The sender starts at boot (boot(cfg)).
+URL: WATCHER_FILLS_URL, else WATCHER_STATUS_URL with its last path segment replaced by "fills".
+"""
+import json, os, re, threading, time
+
+RETRY_S = 60
+_FILL = re.compile(r"^FILLED (\d+) @ ([\d.]+)")
+_EXIT = re.compile(r"^EXIT (\d+) @ ([\d.]+)(?::\s*(.*?))?(?:\(px ([\d.]+)\))?\s*$")
+
+def fills_url(env=None):
+    env = os.environ if env is None else env
+    u = (env.get("WATCHER_FILLS_URL") or "").strip()
+    if u: return u
+    s = (env.get("WATCHER_STATUS_URL") or "").strip()
+    return s.rsplit("/", 1)[0] + "/fills" if s else ""
+
+def _plan(pos):
+    card = pos.get("card") or {}
+    entry = card.get("entry"); stop = pos.get("fut_stop") or card.get("stop_px"); t1 = pos.get("fut_t1") or card.get("first_target")
+    if entry is None or stop is None: return None
+    p = {"entry": float(entry), "stop": float(stop)}
+    if t1 is not None:
+        try: p["t1"] = float(t1)
+        except (TypeError, ValueError): pass
+    return p
+
+def _option(pos):
+    c = pos.get("contract") or {}
+    if not c.get("symbol"): return None
+    o = {"underlier": str(c["symbol"]), "right": "call" if str(c.get("type", "")).lower().startswith("c") else "put",
+         "strike": float(c.get("strike") or 0), "expiry": str(c.get("exp") or "")[:10]}
+    return o
+
+def payload_for(rec, state):
+    """-> dict for POST /api/desk/fills, or None. Pure."""
+    if rec.get("shadow") or rec.get("kind") != "alert": return None
+    text = str(rec.get("text", "")); pos = (state or {}).get("position") or {}
+    if not pos.get("signal") or pos.get("fut_symbol") not in ("ES", "MNQ") or pos.get("fut_side") not in ("long", "short"): return None
+    base = {"signal": pos["signal"], "atMs": int(time.time() * 1000), "symbol": pos["fut_symbol"], "side": pos["fut_side"],
+            "band": (pos.get("card") or {}).get("band"), "option": _option(pos), "qty": int(pos.get("qty") or pos.get("ordered") or 1)}
+    if base["option"] is None: base.pop("option")
+    if base["band"] is None: base.pop("band")
+    plan = _plan(pos)
+    if plan is None: return None
+    base["plan"] = plan
+    if text.startswith("FIRE ") and rec.get("signal") == pos["signal"]:      # logged right after PLACED, once pos["card"] exists
+        return {**base, "event": "placed", "orderId": pos.get("order_id")}
+    m = _FILL.match(text)
+    if m: return {**base, "event": "filled", "orderId": pos.get("order_id"), "qty": int(m[1]), "fillPx": float(m[2])}
+    m = _EXIT.match(text)
+    if m:
+        res = rec.get("result") if isinstance(rec.get("result"), dict) else {}
+        out = {**base, "event": "exit", "qty": int(m[1]), "exitPx": float(m[2]), "reason": (m[3] or "exit").strip()[:300]}
+        if res.get("id"): out["orderId"] = str(res["id"])
+        if m[4]: out["exitUnderlierPx"] = float(m[4])
+        try: out["optionPnl"] = round((float(m[2]) - float(pos.get("entry"))) * int(m[1]) * 100, 2)
+        except (TypeError, ValueError): pass
+        return out
+    return None
+
+MAX_OUTBOX_BYTES = 2_000_000   # ~8k fills; past this NEW rows are refused (counted), the oldest are never trimmed
+
+
+class Sink:
+    """Append-only outbox + background sender.
+
+    Locking: `_lock` guards ONLY local file IO (an append, a snapshot read, the post-send rewrite), never a network
+    call. flush() snapshots the rows under the lock, POSTs them with the lock released, then re-reads the file under
+    the lock and drops just the acknowledged prefix, so rows appended while the sends were in flight are kept.
+    A line that does not parse is moved to `<outbox>.bad` (quarantine) and never takes good rows down with it.
+    """
+
+    def __init__(self, outbox_path, url=None, token=None, post=None, clock=time.time, max_bytes=None):
+        self.path = outbox_path; self.bad_path = outbox_path + ".bad"
+        self.url = fills_url() if url is None else url
+        self.token = os.environ.get("WATCHER_STATUS_TOKEN", "") if token is None else token
+        self._post = post; self.clock = clock; self.last_try = 0.0
+        self.max_bytes = MAX_OUTBOX_BYTES if max_bytes is None else max_bytes
+        self.refused = 0; self.quarantined = 0
+        self._lock = threading.Lock(); self._send_lock = threading.Lock(); self._wake = threading.Event(); self._thread = None
+
+    def configured(self):
+        return bool(self.url and self.token)
+
+    def enqueue(self, p):
+        """Append one row. Never touches the network and never waits on a send. False when unconfigured or full."""
+        if not self.configured(): return False
+        line = json.dumps(p, default=str) + "\n"
+        with self._lock:
+            try: size = os.path.getsize(self.path)
+            except OSError: size = 0
+            if size + len(line) > self.max_bytes:
+                self.refused += 1; return False
+            with open(self.path, "a") as f: f.write(line)
+        self._wake.set()
+        return True
+
+    def _lines(self):
+        try:
+            with open(self.path) as f: return [l for l in f.read().split("\n") if l.strip()]
+        except FileNotFoundError: return []
+
+    @staticmethod
+    def _parse(lines):
+        good, bad = [], []
+        for l in lines:
+            try:
+                v = json.loads(l)
+                (good if isinstance(v, dict) else bad).append((l, v) if isinstance(v, dict) else l)
+            except ValueError:
+                bad.append(l)
+        return good, bad
+
+    def _write(self, lines):
+        tmp = self.path + ".tmp"
+        with open(tmp, "w") as f:
+            for l in lines: f.write(l + "\n")
+        os.replace(tmp, self.path)
+
+    def _quarantine(self, bad):
+        if not bad: return
+        with open(self.bad_path, "a") as f:
+            for l in bad: f.write(l + "\n")
+        self.quarantined += len(bad)
+
+    def _read(self):
+        """Parsed good rows, in order (bad lines are skipped here, quarantined by flush). Read-only."""
+        with self._lock: return [v for _, v in self._parse(self._lines())[0]]
+
+    def _snapshot(self):
+        with self._lock:
+            lines = self._lines(); good, bad = self._parse(lines)
+            if bad:   # quarantine first, then rewrite with exactly the good lines (nothing good is ever dropped)
+                self._quarantine(bad); self._write([l for l, _ in good])
+            return good
+
+    def flush(self):
+        """POST outbox rows in order; drop the acknowledged prefix (2xx, or 422 = permanently refused)."""
+        if not self.configured(): return 0
+        if not self._send_lock.acquire(blocking=False): return 0   # one sender at a time; never queue behind it
+        try:
+            snap = self._snapshot(); acked = 0
+            for _, p in snap:   # network: NO file lock held
+                try: status = self._send(p)
+                except Exception: status = None
+                if status is not None and (200 <= status < 300 or status == 422): acked += 1
+                else: break
+            if acked:
+                done = [l for l, _ in snap[:acked]]
+                with self._lock:
+                    cur = self._lines()
+                    if cur[:acked] == done: rest = cur[acked:]
+                    else:   # file changed under us in an unexpected way: remove only the acked lines, one each
+                        rest = list(cur)
+                        for l in done:
+                            if l in rest: rest.remove(l)
+                    self._write(rest)
+            self.last_try = self.clock()
+            return acked
+        finally:
+            self._send_lock.release()
+
+    def _send(self, p):
+        if self._post: return self._post(self.url, p, self.token)
+        import requests
+        return requests.post(self.url, json=p, timeout=5, headers={"authorization": f"Bearer {self.token}"}).status_code
+
+    def start(self):
+        if self._thread or not self.configured(): return
+        def loop():
+            while True:
+                try: self.flush()
+                except Exception: pass
+                self._wake.wait(RETRY_S); self._wake.clear()
+        self._thread = threading.Thread(target=loop, name="fills_sink", daemon=True); self._thread.start()
+
+
+_default = None
+_default_lock = threading.Lock()
+
+def _enabled(cfg):
+    return bool(getattr(cfg, "live", False) and getattr(cfg, "fire_enabled", False))
+
+def sink_for(cfg):
+    """The process sink, created and STARTED once (so an outbox left from a previous run drains)."""
+    global _default
+    with _default_lock:
+        if _default is None:
+            _default = Sink(cfg.path("outbox.jsonl")); _default.start()
+        return _default
+
+def boot(cfg):
+    """Called from Watcher.__init__: start the sender at boot when live + fire enabled + URL/token set. Never raises."""
+    try:
+        if not _enabled(cfg): return None
+        s = sink_for(cfg)
+        return s if s.configured() else None
+    except Exception:
+        return None
+
+def on_record(rec, state, cfg):
+    """Daemon hook (runs inline in Watcher.log). Dry-run / fire-disabled / shadow / unconfigured -> nothing.
+    Cost on the order path: one regex match + one local file append. Never raises, never waits on the network."""
+    try:
+        if not _enabled(cfg): return None
+        p = payload_for(rec, state)
+        if p is None: return None
+        return p if sink_for(cfg).enqueue(p) else None
+    except Exception:
+        return None
