diff -ruN '--exclude=data' '--exclude=tools' a/tests/test_fills_sink.py b/tests/test_fills_sink.py
--- a/tests/test_fills_sink.py	1969-12-31 18:00:00.000000000 -0600
+++ b/tests/test_fills_sink.py	2026-10-16 01:41:58.813196876 -0500
@@ -0,0 +1,116 @@
+"""watcher/fills_sink.py: payloads from logged records, outbox retry, dry-run/shadow skip."""
+import json
+from types import SimpleNamespace
+from watcher import fills_sink as fs
+
+POS = {"signal": "sig-85e8feddd99efe46", "fut_symbol": "ES", "fut_side": "long", "fut_stop": 7775.0, "fut_t1": 7792.25, "order_id": "6ad1151c-8bc9-4446-a02f-9223be78a8f9",
+       "ordered": 1, "qty": 0, "entry": 2.98, "contract": {"symbol": "SPY", "exp": "2026-10-16", "strike": 770.0, "type": "call"},
+       "card": {"symbol": "ES", "side": "long", "band": "B+", "entry": 7782.63, "stop_px": 7775.0, "first_target": 7792.25}}
+ST = {"position": POS}
+
+def test_payloads_from_records():
+    p = fs.payload_for({"kind": "alert", "text": "FIRE B+ ES long q=0.6 entry=7782.63", "signal": POS["signal"]}, ST)
+    assert p["event"] == "placed" and p["orderId"] == POS["order_id"] and p["plan"] == {"entry": 7782.63, "stop": 7775.0, "t1": 7792.25}
+    assert p["option"] == {"underlier": "SPY", "right": "call", "strike": 770.0, "expiry": "2026-10-16"}
+    f = fs.payload_for({"kind": "alert", "text": "FILLED 1 @ 2.96 (filled)"}, {"position": {**POS, "qty": 1, "entry": 2.96}})
+    assert f["event"] == "filled" and f["fillPx"] == 2.96 and f["qty"] == 1 and f["orderId"] == POS["order_id"]
+    x = fs.payload_for({"kind": "alert", "text": "EXIT 1 @ 2.6: ticket stop 7775.0 hit (px 7775.0)", "result": {"id": "6ad115c6-72e9-4303-ad11-ab83fd3726ba", "account_number": "900000001"}},
+                       {"position": {**POS, "qty": 1, "entry": 2.96}})
+    assert x["event"] == "exit" and x["exitPx"] == 2.6 and x["exitUnderlierPx"] == 7775.0 and x["optionPnl"] == -36.0
+    assert x["orderId"].startswith("6ad115c6") and "900000001" not in json.dumps(x)
+    assert fs.payload_for({"kind": "alert", "text": "DESK A ES long"}, ST) is None
+    assert fs.payload_for({"kind": "alert", "text": "FILLED 1 @ 2.96", "shadow": True}, ST) is None
+    assert fs.payload_for({"kind": "alert", "text": "FILLED 1 @ 2.96"}, {"position": None}) is None
+
+def test_outbox_retry_and_order(tmp_path):
+    status = [503]; seen = []
+    s = fs.Sink(str(tmp_path / "outbox.jsonl"), url="https://desk/api/desk/fills", token="t", post=lambda u, p, t: seen.append(p["event"]) or status[0])
+    s.enqueue({"event": "placed"}); s.enqueue({"event": "filled"})
+    assert s.flush() == 0 and len(s._read()) == 2          # desk down: both kept, order preserved
+    status[0] = 200
+    assert s.flush() == 2 and s._read() == []
+    assert seen == ["placed", "placed", "filled"]
+    status[0] = 422; s.enqueue({"event": "exit"})
+    assert s.flush() == 1 and s._read() == []                # permanently refused rows are dropped, not retried forever
+
+def test_unconfigured_is_a_noop(tmp_path):
+    s = fs.Sink(str(tmp_path / "o.jsonl"), url="", token="")
+    assert s.enqueue({"event": "filled"}) is False and s.flush() == 0 and not (tmp_path / "o.jsonl").exists()
+    s = fs.Sink(str(tmp_path / "o.jsonl"), url="https://desk/api/desk/fills", token="")
+    assert s.enqueue({"event": "filled"}) is False and not (tmp_path / "o.jsonl").exists()
+
+def test_corrupt_line_is_quarantined_and_good_rows_survive(tmp_path):
+    path = tmp_path / "outbox.jsonl"
+    path.write_text('{"event": "placed"}\n{"event": "fil\n[1, 2]\n{"event": "filled"}\n')
+    seen = []
+    s = fs.Sink(str(path), url="https://desk/api/desk/fills", token="t", post=lambda u, p, t: seen.append(p["event"]) or 503)
+    assert s._read() == [{"event": "placed"}, {"event": "filled"}]       # read skips bad lines, never returns []
+    assert s.flush() == 0                                                  # desk down
+    assert [json.loads(l) for l in path.read_text().splitlines()] == [{"event": "placed"}, {"event": "filled"}]
+    assert (tmp_path / "outbox.jsonl.bad").read_text().splitlines() == ['{"event": "fil', "[1, 2]"]
+    s._post = lambda u, p, t: seen.append(p["event"]) or 200
+    assert s.flush() == 2 and s._read() == [] and seen == ["placed", "placed", "filled"]
+    assert (tmp_path / "outbox.jsonl.bad").exists()                       # quarantine is kept for a human
+
+def test_enqueue_never_blocks_while_a_send_hangs(tmp_path):
+    import threading, time as t
+    gate = threading.Event(); started = threading.Event()
+    def hang(u, p, tok):
+        started.set(); gate.wait(10); return 200
+    s = fs.Sink(str(tmp_path / "outbox.jsonl"), url="https://desk/api/desk/fills", token="t", post=hang)
+    s.enqueue({"event": "placed"})
+    th = threading.Thread(target=s.flush); th.start()
+    assert started.wait(5)
+    t0 = t.monotonic()
+    for i in range(20): assert s.enqueue({"event": "filled", "i": i})
+    assert t.monotonic() - t0 < 0.5, "enqueue waited on a network send"
+    assert s.flush() == 0                                                 # a second sender does not queue behind the first
+    gate.set(); th.join(5)
+    rows = s._read()
+    assert [r.get("i") for r in rows] == list(range(20)), "rows appended during the send were kept, the acked one dropped"
+
+def test_full_outbox_refuses_new_rows_and_keeps_the_oldest(tmp_path):
+    s = fs.Sink(str(tmp_path / "outbox.jsonl"), url="https://desk/api/desk/fills", token="t", post=lambda u, p, t: 503, max_bytes=60)
+    assert s.enqueue({"event": "placed", "n": 1}) and s.enqueue({"event": "filled", "n": 2})
+    assert s.enqueue({"event": "exit", "n": 3}) is False and s.refused == 1
+    assert [r["n"] for r in s._read()] == [1, 2]
+
+def test_boot_starts_the_sender_and_drains_an_existing_outbox(tmp_path, monkeypatch):
+    import time as t
+    (tmp_path / "outbox.jsonl").write_text('{"event": "placed"}\n{"event": "filled"}\n')
+    sent = []
+    monkeypatch.setattr(fs, "_default", None)
+    monkeypatch.setenv("WATCHER_FILLS_URL", "https://desk/api/desk/fills"); monkeypatch.setenv("WATCHER_STATUS_TOKEN", "t")
+    real = fs.Sink._send
+    monkeypatch.setattr(fs.Sink, "_send", lambda self, p: sent.append(p["event"]) or 200)
+    cfg = SimpleNamespace(live=True, fire_enabled=True, path=lambda n: str(tmp_path / n))
+    s = fs.boot(cfg)
+    assert s is not None and s._thread is not None
+    for _ in range(100):
+        if sent == ["placed", "filled"] and s._read() == []: break
+        t.sleep(0.05)
+    assert sent == ["placed", "filled"] and s._read() == []
+    monkeypatch.setattr(fs, "_default", None)
+
+def test_boot_is_a_noop_when_dry_run_or_unconfigured(tmp_path, monkeypatch):
+    monkeypatch.setattr(fs, "_default", None)
+    monkeypatch.delenv("WATCHER_FILLS_URL", raising=False); monkeypatch.delenv("WATCHER_STATUS_URL", raising=False)
+    assert fs.boot(SimpleNamespace(live=False, fire_enabled=True, path=lambda n: str(tmp_path / n))) is None
+    assert fs.boot(SimpleNamespace(live=True, fire_enabled=True, path=lambda n: str(tmp_path / n))) is None
+    rec = {"kind": "alert", "text": "FILLED 1 @ 2.96"}
+    assert fs.on_record(rec, ST, SimpleNamespace(live=True, fire_enabled=True, path=lambda n: str(tmp_path / n))) is None
+    assert not (tmp_path / "outbox.jsonl").exists()
+    monkeypatch.setattr(fs, "_default", None)
+
+def test_dry_run_and_fire_disabled_skip(tmp_path):
+    rec = {"kind": "alert", "text": "FILLED 1 @ 2.96"}
+    cfg = SimpleNamespace(live=False, fire_enabled=True, path=lambda n: str(tmp_path / n))
+    assert fs.on_record(rec, ST, cfg) is None
+    cfg.live, cfg.fire_enabled = True, False
+    assert fs.on_record(rec, ST, cfg) is None
+    assert not (tmp_path / "outbox.jsonl").exists()
+
+def test_url_derivation():
+    assert fs.fills_url({"WATCHER_STATUS_URL": "https://x.app/api/desk/watcher"}) == "https://x.app/api/desk/fills"
+    assert fs.fills_url({"WATCHER_FILLS_URL": "https://y/f", "WATCHER_STATUS_URL": "https://x/a/b"}) == "https://y/f"
+    assert fs.fills_url({}) == ""
