diff -ruN '--exclude=data' '--exclude=tools' a/watcher/fills_sink.py b/watcher/fills_sink.py
--- a/watcher/fills_sink.py	1969-12-31 18:00:00.000000000 -0600
+++ b/watcher/fills_sink.py	2026-10-16 01:20:41.517196876 -0500
@@ -0,0 +1,132 @@
+"""Live order events -> desk /api/desk/fills (room_orders + desk_trades). Spec: ledger-desk docs/watcher-fills-1016.
+
+Off the order path: on_record() only builds a payload from a record the daemon ALREADY logged plus state["position"],
+appends it to outbox.jsonl and wakes a background thread that POSTs it (WATCHER_STATUS_TOKEN bearer, 5 s timeout).
+Anything not acknowledged stays in the outbox and is retried (at most every RETRY_S). Never raises into the daemon,
+never places/cancels/gates anything. Skipped entirely for dry-run (cfg.live False or fire disabled) and shadow records.
+URL: WATCHER_FILLS_URL, else WATCHER_STATUS_URL with its last path segment replaced by "fills".
+"""
+import json, os, re, threading, time
+
+RETRY_S = 60
+MAX_OUTBOX = 500
+_FILL = re.compile(r"^FILLED (\d+) @ ([\d.]+)")
+_EXIT = re.compile(r"^EXIT (\d+) @ ([\d.]+)(?::\s*(.*?))?(?:\(px ([\d.]+)\))?\s*$")
+
+def fills_url(env=None):
+    env = os.environ if env is None else env
+    u = (env.get("WATCHER_FILLS_URL") or "").strip()
+    if u: return u
+    s = (env.get("WATCHER_STATUS_URL") or "").strip()
+    return s.rsplit("/", 1)[0] + "/fills" if s else ""
+
+def _plan(pos):
+    card = pos.get("card") or {}
+    entry = card.get("entry"); stop = pos.get("fut_stop") or card.get("stop_px"); t1 = pos.get("fut_t1") or card.get("first_target")
+    if entry is None or stop is None: return None
+    p = {"entry": float(entry), "stop": float(stop)}
+    if t1 is not None:
+        try: p["t1"] = float(t1)
+        except (TypeError, ValueError): pass
+    return p
+
+def _option(pos):
+    c = pos.get("contract") or {}
+    if not c.get("symbol"): return None
+    o = {"underlier": str(c["symbol"]), "right": "call" if str(c.get("type", "")).lower().startswith("c") else "put",
+         "strike": float(c.get("strike") or 0), "expiry": str(c.get("exp") or "")[:10]}
+    return o
+
+def payload_for(rec, state):
+    """-> dict for POST /api/desk/fills, or None. Pure."""
+    if rec.get("shadow") or rec.get("kind") != "alert": return None
+    text = str(rec.get("text", "")); pos = (state or {}).get("position") or {}
+    if not pos.get("signal") or pos.get("fut_symbol") not in ("ES", "MNQ") or pos.get("fut_side") not in ("long", "short"): return None
+    base = {"signal": pos["signal"], "atMs": int(time.time() * 1000), "symbol": pos["fut_symbol"], "side": pos["fut_side"],
+            "band": (pos.get("card") or {}).get("band"), "option": _option(pos), "qty": int(pos.get("qty") or pos.get("ordered") or 1)}
+    if base["option"] is None: base.pop("option")
+    if base["band"] is None: base.pop("band")
+    plan = _plan(pos)
+    if plan is None: return None
+    base["plan"] = plan
+    if text.startswith("FIRE ") and rec.get("signal") == pos["signal"]:      # logged right after PLACED, once pos["card"] exists
+        return {**base, "event": "placed", "orderId": pos.get("order_id")}
+    m = _FILL.match(text)
+    if m: return {**base, "event": "filled", "orderId": pos.get("order_id"), "qty": int(m[1]), "fillPx": float(m[2])}
+    m = _EXIT.match(text)
+    if m:
+        res = rec.get("result") if isinstance(rec.get("result"), dict) else {}
+        out = {**base, "event": "exit", "qty": int(m[1]), "exitPx": float(m[2]), "reason": (m[3] or "exit").strip()[:300]}
+        if res.get("id"): out["orderId"] = str(res["id"])
+        if m[4]: out["exitUnderlierPx"] = float(m[4])
+        try: out["optionPnl"] = round((float(m[2]) - float(pos.get("entry"))) * int(m[1]) * 100, 2)
+        except (TypeError, ValueError): pass
+        return out
+    return None
+
+class Sink:
+    def __init__(self, outbox_path, url=None, token=None, post=None, clock=time.time):
+        self.path = outbox_path; self.url = fills_url() if url is None else url
+        self.token = os.environ.get("WATCHER_STATUS_TOKEN", "") if token is None else token
+        self._post = post; self.clock = clock; self.last_try = 0.0
+        self._lock = threading.Lock(); self._wake = threading.Event(); self._thread = None
+
+    def enqueue(self, p):
+        with self._lock:
+            with open(self.path, "a") as f: f.write(json.dumps(p, default=str) + "\n")
+        self._wake.set()
+
+    def _read(self):
+        try:
+            with open(self.path) as f: return [json.loads(l) for l in f if l.strip()]
+        except FileNotFoundError: return []
+        except Exception: return []
+
+    def flush(self):
+        """POST every outbox row in order; keep the ones not acknowledged (2xx, or 422 = permanently refused, dropped)."""
+        if not self.url or not self.token: return 0
+        with self._lock:
+            rows = self._read(); keep = []; sent = 0
+            for i, p in enumerate(rows):
+                try:
+                    status = self._send(p)
+                except Exception:
+                    status = None
+                if status is not None and (200 <= status < 300 or status == 422): sent += 1
+                else: keep = rows[i:]; break
+            keep = keep[-MAX_OUTBOX:]
+            tmp = self.path + ".tmp"
+            with open(tmp, "w") as f:
+                for p in keep: f.write(json.dumps(p, default=str) + "\n")
+            os.replace(tmp, self.path)
+            self.last_try = self.clock()
+            return sent
+
+    def _send(self, p):
+        if self._post: return self._post(self.url, p, self.token)
+        import requests
+        return requests.post(self.url, json=p, timeout=5, headers={"authorization": f"Bearer {self.token}"}).status_code
+
+    def start(self):
+        if self._thread: return
+        def loop():
+            while True:
+                self._wake.wait(RETRY_S); self._wake.clear()
+                try: self.flush()
+                except Exception: pass
+        self._thread = threading.Thread(target=loop, name="fills_sink", daemon=True); self._thread.start()
+
+_default = None
+def on_record(rec, state, cfg):
+    """Daemon hook. Dry-run / fire-disabled / shadow -> nothing. Never raises."""
+    global _default
+    try:
+        if not getattr(cfg, "live", False) or not getattr(cfg, "fire_enabled", False): return None
+        p = payload_for(rec, state)
+        if p is None: return None
+        if _default is None:
+            _default = Sink(cfg.path("outbox.jsonl")); _default.start()
+        _default.enqueue(p)
+        return p
+    except Exception:
+        return None
