{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/checklist",
      "schedule": "15 13 * * 1-5"
    },
    {
      "path": "/api/cron/checklist",
      "schedule": "15 14 * * 1-5"
    },
    {
      "path": "/api/cron/review",
      "schedule": "15 20 * * 1-5"
    },
    {
      "path": "/api/cron/review",
      "schedule": "15 21 * * 1-5"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 22 * * 0"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 23 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
