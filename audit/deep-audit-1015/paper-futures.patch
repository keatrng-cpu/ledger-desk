@@ -0,0 +1,88 @@
+"""Deep audit 2026-10-15 paper fixes (#1, #3, #18, #19). Runs on a temp ledger; never touches the live one."""
+import json, os, sys, datetime as dt
+from zoneinfo import ZoneInfo
+import pytest
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+import paper as P
+ET = ZoneInfo("America/New_York")
+
+@pytest.fixture(autouse=True)
+def tmp_ledger(tmp_path, monkeypatch):
+    for k, v in dict(L=tmp_path / "ledger.json", C=tmp_path / "trades.csv", JD=tmp_path / "journal", LEVELS=tmp_path / "levels.json",
+                     REJ=tmp_path / "rej.jsonl", OUTBOX=tmp_path / "journal" / "outbox.jsonl", SENT=tmp_path / "journal" / "sent.txt").items():
+        monkeypatch.setattr(P, k, str(v))
+    monkeypatch.delenv("PAPER_JOURNAL_URL", raising=False); monkeypatch.delenv("PAPER_JOURNAL_TOKEN", raising=False)
+    yield
+
+def et(y, mo, d, h, mi): return dt.datetime(y, mo, d, h, mi, tzinfo=ET)
+def pend(**kw):
+    t = dict(id="X", alerted=et(2026, 10, 14, 9, 34).isoformat(), symbol="ES", side="short", band="A-", q=0.67, entry=7816.5, stop=7826.5,
+             t1=7796.5, t2=None, rr=2, contracts=2, remaining=2, cur_stop=7826.5, trimmed=False, status="pending", risk_cap=2000, atr=4.21,
+             commission=0.0, realized=0.0, events=[], plan_key="sig|7816.5|7826.5|7796.5|None")
+    t.update(kw); return t
+CARD = {"ok": True, "symbol": "ES", "side": "short", "band": "A-", "signal": "sig", "entry": 7816.5, "stop": 7826.5, "t1": 7796.5, "t2": None}
+
+# ---- #3 expiry -------------------------------------------------------------
+def test_pending_from_yesterday_expires():   # 10/14 ES-S 7816.5 / NQ-S 30249.5 still pending on 10/15
+    assert P.pending_expired(pend(), et(2026, 10, 15, 8, 30))
+def test_pending_expires_at_1550_flat():
+    t = pend(alerted=et(2026, 10, 15, 13, 34).isoformat())
+    assert P.pending_expired(t, et(2026, 10, 15, 15, 49)) is None
+    assert P.pending_expired(t, et(2026, 10, 15, 15, 50)) == "15:50 ET flat"
+def test_evening_alert_does_not_fill_12h_later():   # ES-L-20261013-1924: alerted 20:24 ET, filled 08:30 ET next day, -1.03R
+    t = pend(alerted=et(2026, 10, 13, 20, 24).isoformat())
+    assert P.pending_expired(t, et(2026, 10, 13, 22, 0)) is None
+    assert "pending > 3h" in P.pending_expired(t, et(2026, 10, 14, 8, 30))
+def test_pending_inside_3h_same_session_lives():   # MNQ-S-044008 alerted 05:40 ET, filled 08:27 ET (+3.77R)
+    t = pend(alerted=et(2026, 10, 14, 5, 40).isoformat())
+    assert P.pending_expired(t, et(2026, 10, 14, 8, 27)) is None
+def test_advance_cancels_expired():
+    s = {"open": [pend()], "closed": [], "cash": 1e5}
+    P.advance(s, {"ES": 7816.0}, CARD, now_et=et(2026, 10, 15, 9, 0))
+    assert s["open"] == [] and s["cancelled"][0]["status"] == "cancelled" and s["cancelled"][0]["events"][-1]["what"] == "expired"
+
+# ---- #3 the card must still be alive at touch -----------------------------
+@pytest.mark.parametrize("card,why", [
+    ({**CARD, "band": "C"}, "below B+"), ({**CARD, "band": "B"}, "below B+"), ({**CARD, "side": "long"}, "card is now"),
+    ({**CARD, "stop": 7830.0}, "plan changed"), ({"ok": False}, "no current card"), (None, "no current card")])
+def test_touch_requires_live_card(card, why):
+    now = et(2026, 10, 14, 10, 0)
+    s = {"open": [pend()], "closed": [], "cash": 1e5}
+    P.advance(s, {"ES": 7817.0}, card, now_et=now)
+    assert s["open"] == [] and why in s["cancelled"][0]["events"][-1]["why"]
+def test_touch_with_live_bplus_card_fills():
+    s = {"open": [pend()], "closed": [], "cash": 1e5}
+    P.advance(s, {"ES": 7817.0}, {**CARD, "band": "B+"}, now_et=et(2026, 10, 14, 10, 0))
+    assert s["open"][0]["status"] == "open"
+def test_no_touch_keeps_pending_even_if_card_changed():
+    s = {"open": [pend()], "closed": [], "cash": 1e5}
+    P.advance(s, {"ES": 7810.0}, {**CARD, "band": "C"}, now_et=et(2026, 10, 14, 10, 0))
+    assert s["open"][0]["status"] == "pending"
+
+# ---- #1 refuse a fill through the stop -------------------------------------
+def test_fill_through_stop_refused():   # 10/14 14:33 MNQ long entry 30641.75 stop 30537.75, price 30217 → was -4.1R
+    t = pend(symbol="MNQ", side="long", entry=30641.75, stop=30537.75, cur_stop=30537.75, t1=30800, risk_cap=2080, atr=30.0)
+    P.step(t, 30217.0)
+    assert t["status"] == "cancelled" and t["realized"] == 0
+
+# ---- #19 MNQ stays MNQ -------------------------------------------------------
+def card(sym, e, st, t1):
+    return {"id": f"{sym}-L", "symbol": sym, "side": "long", "band": "A-", "q": 0.68, "entry": e, "stop": st, "t1": t1, "t2": None, "px": e, "atr": 30.0, "alerted": P.now()}
+def test_mnq_card_books_mnq():
+    P._open(card("MNQ", 30641.75, 30537.75, 30900))
+    t = P.load()["open"][0]
+    assert t["symbol"] == "MNQ" and t["contract"] == "MNQ" and t["card_symbol"] == "MNQ"
+    assert t["risk$"] <= 2000 and t["contracts"] == 9   # 2% of 100k / (104pt × $2)
+def test_full_size_card_may_step_down_to_micro():
+    P._open(card("NQ", 30641.75, 30537.75, 30900))      # 1 NQ = $2,080 > $2,000 → MNQ
+    assert P.load()["open"][0]["symbol"] == "MNQ"
+def test_closed_schema_has_qty_pnl_r():
+    s = P.load(); t = pend(status="open", remaining=0, contracts=1, realized=500.0, commission=2.5, events=[{"what": "T1 full exit", "at": "x", "px": 1, "qty": 1}], **{"risk$": 500})
+    P.finish(s, t)
+    assert t["qty"] == 1 and t["pnl"] == t["pnl$"] == 497.5 and t["r"] == t["result_R"] and t["contract"] == "ES"
+
+# ---- #18 outbox backlog is reported ----------------------------------------
+def test_flush_reports_backlog(capsys):
+    os.makedirs(P.JD, exist_ok=True)
+    open(P.OUTBOX, "w").write(json.dumps({"id": "a", "source": "paper-futures"}) + "\n" + json.dumps({"id": "b", "source": "paper-futures"}) + "\n")
+    assert P.flush() == 0 and "2 rows queued" in capsys.readouterr().out
