index 0000000..4068fc9
--- /dev/null
+++ b/tests/test_deep_audit_hygiene.py
@@ -0,0 +1,63 @@
+"""Deep audit 2026-10-15 #12 / #18 watcher hygiene."""
+import json
+from watcher import hygiene, status, gates
+from watcher.ticks import Agg
+from watcher.config import Config
+
+def test_scrub_drops_nested_forbidden_keys():
+    d = []
+    out = hygiene.scrub({"a": 1, "x": [{"access_token": "t", "ok": 1}], "Equity": 5, "mfa_code": 1}, d)
+    assert out == {"a": 1, "x": [{"ok": 1}]} and sorted(d) == ["Equity", "access_token", "mfa_code"]
+
+def test_account_number_still_refused_if_unmaskable(tmp_path, monkeypatch):
+    monkeypatch.setenv("WATCHER_DIR", str(tmp_path)); cfg = Config()
+    status.write(cfg, {"gates": [{"why": "acct 995386158"}]})
+    assert "995386158" not in open(tmp_path / "status.json").read()
+
+def test_near_miss_same_card_alerts_once_in_30min():   # 10/14 12:35/12:40/12:45 same B 0.5999 card
+    sn = {}; fp = ["B", "ES", "long", 0.5999]
+    assert hygiene.alert_once(sn, "near_miss", fp, 1000)
+    assert not hygiene.alert_once(sn, "near_miss", fp, 1300)
+    assert not hygiene.alert_once(sn, "near_miss", fp, 1600)
+    assert hygiene.alert_once(sn, "near_miss", ["B", "ES", "long", 0.5899], 1700)   # card changed
+    assert hygiene.alert_once(sn, "near_miss", ["B", "ES", "long", 0.5899], 1700 + hygiene.ALERT_DEDUPE_S)
+
+def test_bplus_caution_logs_flips_only():   # 681 rows on 10/13
+    sn = {}; n = sum(hygiene.flipped(sn, "bplus_caution", ok) for ok in [False] * 50 + [True] + [True] * 20 + [False])
+    assert n == 3
+
+def test_spike_log_filter():
+    assert not hygiene.spike_worth_logging({"tag": "breakout", "atExtreme": False})
+    assert hygiene.spike_worth_logging({"tag": "failed", "atExtreme": False})
+    assert hygiene.spike_worth_logging({"tag": "breakout", "atExtreme": True})
+
+def test_at_extreme_can_be_true_without_session_args():   # was False 426/426
+    a = Agg(keep_s=900)
+    for t in range(0, 100): a.add("ES", 100.0 + (t % 3) * 0.25, t)       # quiet range 100–100.5
+    W = __import__("watcher.ticks", fromlist=["F"]).F["spikeWindowS"]
+    for i, t in enumerate(range(100, 100 + W)): a.add("ES", 100.5 + (i + 1) * 2.0, t)   # push to a new high
+    for t in range(100 + W, 100 + 2 * W + 1): a.add("ES", 100.5 + W * 2.0, t)
+    sp = a.detect("ES", 4.0, 100 + 2 * W)
+    assert sp is not None and sp["atExtreme"] is True
+
+def _snap(**kw):
+    s = {"tape_fresh": True, "invalidated": False, "stale_tape": False, "entry_state": {"state": "near"}}; s.update(kw); return s
+def test_alert_withheld_on_stale_or_dead_card():   # #12: 10/14 09:24–10:25 lag 600 s; #2/#13 dead cards
+    assert hygiene.alert_allowed(_snap())[0]
+    assert not hygiene.alert_allowed(_snap(tape_fresh=False))[0]
+    assert not hygiene.alert_allowed(_snap(invalidated=True))[0]
+    assert hygiene.alert_allowed(_snap(entry_state={"state": "missed"}))[0]        # missed alone is not suppressed
+    assert not hygiene.alert_allowed(_snap(played_out=True))[0]                    # played out (T1 traded) is
+    assert not hygiene.alert_allowed(_snap(entry_state={"state": "invalidated"}))[0]
+    assert not hygiene.alert_allowed(_snap(stale_tape=True))[0]
+
+def test_snapshot_reads_dead_card_flags():
+    card = {"ok": True, "wire": {"strategy": {"symbol": "MNQ", "side": "long", "band": "A-", "q": 0.68, "invalidated": True, "staleTape": True,
+                                              "entryState": {"state": "invalidated"}}, "tape": {"fresh": True}}}
+    s = gates.snapshot(card)
+    assert s["invalidated"] and s["stale_tape"] and s["entry_state"]["state"] == "invalidated"
+
+def test_compact_gates_keeps_hard_and_would_rows():
+    g = [("band", False, "x"), ("shadow:a", True, "ok"), ("soft:b", True, "WOULD block: y"), ("shadow:c", False, "z"), ("entry", True, "e")]
+    kept, quiet = hygiene.compact_gates(g)
+    assert quiet == 1 and [k[0] for k in kept] == ["band", "soft:b", "shadow:c", "entry"]
