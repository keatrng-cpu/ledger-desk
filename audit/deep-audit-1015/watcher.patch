index 0000000..622b2b9
--- /dev/null
+++ b/watcher/hygiene.py
@@ -0,0 +1,64 @@
+"""Deep audit 2026-10-15 #18 / #12 — watcher hygiene, pure helpers (no I/O).
+
+- scrub(): status.json used to be REFUSED whole when any forbidden key appeared (194x "would leak a secret, not written"
+  on 10/13-14, so the Watcher tab went stale). Now forbidden keys are dropped recursively and the account masked; the
+  refusal stays as the last line of defence for anything the scrub could not remove.
+- alert_once(): NEAR-MISS for the same B 0.5999 card repeated every 300 s cooldown (12:35/12:40/12:45). An alert now
+  re-sends only when its fingerprint (band/symbol/side/q) changes, or after ALERT_DEDUPE_S (30 min).
+- flipped(): bplus_caution logged 681 rows on 10/13 because the detail text carried live numbers; log on ok flips only.
+- spike_worth_logging(): 110 spike_shadow rows/day were noise; log failed spikes and spikes at a session extreme only.
+- alert_allowed(): no DESK alert while the tape is stale (#12) or the card is invalidated / played out.
+"""
+import re
+
+FORBIDDEN = re.compile(r"^(password|token|access_token|refresh_token|mfa[a-z_]*|secret|buying_power|cash|equity|balance|portfolio_value)$", re.I)
+ALERT_DEDUPE_S = 1800
+
+def scrub(obj, dropped=None):
+    """Return a copy with forbidden KEYS removed at any depth (values under them never leave the box)."""
+    dropped = [] if dropped is None else dropped
+    if isinstance(obj, dict):
+        out = {}
+        for k, v in obj.items():
+            if isinstance(k, str) and FORBIDDEN.match(k): dropped.append(k); continue
+            out[k] = scrub(v, dropped)
+        return out
+    if isinstance(obj, (list, tuple)): return [scrub(v, dropped) for v in obj]
+    return obj
+
+def alert_once(sig_state, kind, fingerprint, now_s, window_s=ALERT_DEDUPE_S):
+    """True = send. Records the send. Same fingerprint inside window_s = suppressed."""
+    rec = sig_state.get(kind + "_fp")
+    if rec and rec[0] == fingerprint and now_s - rec[1] < window_s: return False
+    sig_state[kind + "_fp"] = [fingerprint, now_s]
+    return True
+
+def flipped(sig_state, kind, ok):
+    if sig_state.get(kind + "_ok") == ok and (kind + "_ok") in sig_state: return False
+    sig_state[kind + "_ok"] = ok
+    return True
+
+def spike_worth_logging(sp):
+    return bool(sp) and (sp.get("tag") == "failed" or sp.get("atExtreme") is True)
+
+def alert_allowed(snap):
+    """(ok, why). Stale tape or a dead card never alerts."""
+    if snap.get("tape_fresh") is not True: return False, "tape stale — grade withheld"
+    if snap.get("invalidated"): return False, "card invalidated (stop printed)"
+    if snap.get("stale_tape"): return False, "desk flagged STALE TAPE"
+    if snap.get("played_out"): return False, "card played out (T1 traded)"
+    es = snap.get("entry_state")
+    # Accuracy PR #19: "missed" alone (price ran from an unfilled entry) can still come back — it is NOT suppressed.
+    if isinstance(es, dict) and es.get("state") == "invalidated": return False, "entry state invalidated"
+    return True, None
+
+
+def compact_gates(g):
+    """#7: ~90 shadow:/soft: gates were True on 100% of 4,602 rows and made up most of gates.log. A shadow/soft row
+    that passed and says no WOULD-block is counted, not logged. Hard gates and any would-block row are always kept,
+    so the parity replay (hard gates only) is unchanged."""
+    kept, quiet = [], 0
+    for n, ok, w in g:
+        if ok is True and str(n).startswith(("shadow:", "soft:")) and "WOULD" not in str(w).upper(): quiet += 1; continue
+        kept.append((n, ok, w))
+    return kept, quiet
