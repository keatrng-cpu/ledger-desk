diff --git a/tests/test_intraday_ticket.py b/tests/test_intraday_ticket.py
new file mode 100644
index 0000000..1ebb5df
--- /dev/null
+++ b/tests/test_intraday_ticket.py
@@ -0,0 +1,80 @@
+"""Owner rule (Keaton 2026-10-15): intraday tickets are 0DTE ATM singles (1 OTM fallback), never a spread;
+1DTE+ only for swing tickets (path unchanged). Late (0DTE impractical) = BLOCK, never a silent roll to 1DTE."""
+from datetime import datetime
+from watcher import optexec, gates
+from watcher.config import Config
+
+et = lambda h, m: datetime(2026, 10, 15, h, m, tzinfo=gates.ET)
+
+def test_rule_live_0dte_atm_otm1_no_spread():
+    it = optexec.intraday()
+    assert it and it["dte"] == 0 and it["strike"] == "ATM" and it["fallback"] == "OTM_1" and it["debitSpread"] is False
+
+def test_dte_target_is_0_through_the_session():
+    cfg = Config()
+    for h, m in ((8, 30), (9, 52), (13, 0), (14, 45)):
+        assert optexec.dte_target(cfg, et(h, m)) == 0
+
+def test_late_day_blocks_never_rolls():
+    cfg = Config()
+    for h, m in ((15, 25), (15, 31), (15, 50)):
+        assert optexec.intraday_late_blocked(cfg, et(h, m)) is True
+        assert optexec.dte_target(cfg, et(h, m)) is None   # None = block, not 1
+    assert optexec.intraday_late_blocked(cfg, et(10, 0)) is False
+
+def test_ticket_classification_swing_keeps_its_dte():
+    assert optexec.is_intraday_ticket({"dte": 0}) is True
+    assert optexec.is_intraday_ticket({"dte": 1}) is False
+    assert optexec.is_intraday_ticket({"dte": 5}) is False
+    assert optexec.is_intraday_ticket({"dte": 0, "horizon": "swing"}) is False
+    # swing path still uses dteByTime (unchanged): never None
+    assert optexec.dte_target(Config(), et(15, 40), intraday_ticket=False) is not None
+
+def test_picker_source_atm_then_otm1_no_delta_no_spread_when_intraday():
+    src = open(optexec.__file__.replace("optexec.py", "broker.py")).read()
+    assert "_it = optexec.is_intraday_ticket(ticket)" in src
+    assert "if _it: pick = optexec.pick_intraday(cands, cap)" in src and "if not _it and _fc_live() and FC.get(\"spreadFallback\")" in src
+    assert "exp = optexec.pick_expiry(exps, today, ticket, self.cfg" in src and "if exp is None: return []" in src
+
+
+# ---- expiry picker (Accuracy PR #19 #1): intraday = today's expiry exactly; swing = nearest >= 1 day; Friday/holiday pinned
+from datetime import date
+FRI = date(2026, 10, 16)   # Friday
+fri = lambda h, m: datetime(2026, 10, 16, h, m, tzinfo=gates.ET)
+DAILY = ["2026-10-16", "2026-10-19", "2026-10-20", "2026-10-21", "2026-10-23"]
+
+def test_expiry_friday_intraday_is_today_swing_is_monday():
+    c = Config()
+    assert optexec.pick_expiry(DAILY, FRI, {"dte": 0}, c, fri(10, 0)) == "2026-10-16"
+    assert optexec.pick_expiry(DAILY, FRI, {"dte": 1}, c, fri(10, 0)) == "2026-10-19"   # never today's 0DTE (was the |0-1| tie bug)
+    assert optexec.pick_expiry(DAILY, FRI, {"dte": 5}, c, fri(10, 0)) == "2026-10-21"
+    assert optexec.pick_expiry(DAILY, FRI, {"dte": 0}, c, fri(15, 31)) is None          # late Friday: block, not Monday
+    assert optexec.pick_expiry(DAILY, FRI, {"dte": 1}, c, fri(15, 31)) == "2026-10-19"   # swing unaffected late
+
+def test_expiry_holiday():
+    c = Config()
+    # Thanksgiving 2026-11-26 (no listing): Wed intraday = Wed 0DTE; Wed 1DTE swing skips to Fri 11-27
+    wed = date(2026, 11, 25); w = datetime(2026, 11, 25, 10, 0, tzinfo=gates.ET)
+    exps = ["2026-11-25", "2026-11-27", "2026-11-30"]
+    assert optexec.pick_expiry(exps, wed, {"dte": 0}, c, w) == "2026-11-25"
+    assert optexec.pick_expiry(exps, wed, {"dte": 1}, c, w) == "2026-11-27"
+    # a holiday-like day with no expiry today: intraday blocks (never rolls to tomorrow)
+    assert optexec.pick_expiry(["2026-11-27"], date(2026, 11, 26), {"dte": 0}, c, datetime(2026, 11, 26, 10, 0, tzinfo=gates.ET)) is None
+
+# ---- intraday picker respects intradayTicket.deltaBand 0.45-0.55 (Accuracy #d)
+def _c(off, ask, delta): return {"contract": {"offset": off}, "quote": {"ask": ask, "delta": delta}}
+
+def test_pick_intraday_band_then_otm1():
+    atm, otm, itm = _c("ATM", 2.44, 0.51), _c("OTM_1", 1.90, 0.42), _c("ITM_1", 3.10, 0.60)
+    assert optexec.pick_intraday([atm, otm, itm], 650) is atm
+    assert optexec.pick_intraday([_c("ATM", 7.0, 0.51), otm], 650)["contract"]["offset"] == "OTM_1"   # cap needs 1 OTM
+    assert optexec.pick_intraday([_c("ATM", 2.0, 0.62), _c("ITM_1", 2.2, 0.53), otm], 650)["contract"]["offset"] == "ITM_1"  # in-band strike nearest 0.5
+    assert optexec.pick_intraday([itm], 650) is None   # out of band, no ATM/OTM_1 -> nothing
+
+# ---- sizing at real 0DTE prices: QQQ 0DTE ATM ~$2.44 -> 2 contracts under $650 on A+/A, 1 on A-/B+
+def test_size_0dte_atm_two_under_650():
+    c = Config()
+    assert gates.size_contracts(2.44, 4, c, "A+")[0] == 2
+    assert gates.size_contracts(2.44, 2, c, "A")[0] == 2
+    assert gates.size_contracts(2.44, 2, c, "A-")[0] == 1
+    assert gates.size_contracts(2.44, 1, c, "A+")[0] == 1   # watcher never exceeds the desk's wanted count
