+
+def is_intraday_ticket(ticket):
+    """An intraday ticket = the intradayTicket DTE (0) and not swing-classified. Swing (1DTE+) keeps the old path."""
+    it = intraday()
+    if not it or (ticket or {}).get("horizon") == "swing": return False
+    try: return int((ticket or {}).get("dte", 0)) == int(it.get("dte", 0))
+    except (TypeError, ValueError): return False
+
+def intraday_late_blocked(cfg, et_dt):
+    """0DTE impractical: from lateBlockEt (or whenever min_dte_now already forbids 0DTE) intraday is BLOCKED, never rolled to 1DTE."""
+    it = intraday()
