+    return hm >= _hm(it.get("lateBlockEt") or RULES["session"]["zeroDteCutoffEt"]) or min_dte_now(cfg, et_dt) > 0
+
+def dte_target(cfg, et_dt, intraday_ticket=True):
+    """Fix 5: 0DTE in the morning, afterDte from zeroDteUntilEt; never 0DTE from session.zeroDteCutoffEt (15:25).
+    Owner rule 2026-10-15: an intraday ticket wants 0DTE all session and gets None (BLOCK) once late — never a silent 1DTE roll."""
+    it = intraday()
+    if it and intraday_ticket:
+        return None if intraday_late_blocked(cfg, et_dt) else int(it.get("dte", 0))
     d = OX["dteByTime"]; hm = et_dt.hour * 60 + et_dt.minute
     want = 0 if hm < _hm(d["zeroDteUntilEt"]) else d["afterDte"]
     return max(want, min_dte_now(cfg, et_dt))
 
+def pick_expiry(exps, today, ticket, cfg, et_dt):
+    """Owner rule 2026-10-15 (Accuracy PR #19 #1): one expiry rule, desk and watcher agree.
+    Intraday ticket -> TODAY's expiry exactly (QQQ/SPY list a daily); none or late -> None (block, never roll).
+    Swing ticket (1DTE+) -> nearest expiry with days >= 1 (and >= min_dte_now) to the ticket's dte (dteByTime when live);
+    a Friday 1DTE swing picks Monday, never today's 0DTE. Expiries past cfg.dte_max are ignored on both paths."""
+    from datetime import date as _d
+    days = {e: (_d.fromisoformat(e) - today).days for e in exps}
+    if is_intraday_ticket(ticket):
+        if dte_target(cfg, et_dt) is None: return None
+        return next((e for e in sorted(exps) if days[e] == 0), None)
+    lo = max(1, min_dte_now(cfg, et_dt))
+    ok = sorted(e for e in exps if lo <= days[e] <= cfg.dte_max)
+    if not ok: return None
+    want = int(ticket.get("dte", 1))
+    if mode("dteByTime") == "live": want = max(1, dte_target(cfg, et_dt, intraday_ticket=False))
+    return min(ok, key=lambda e: (abs(days[e] - max(1, want)), days[e]))
+
+def pick_intraday(cands, cap):
+    """Owner rule 2026-10-15 + Accuracy #d: intraday single = ATM inside intradayTicket.deltaBand (0.45-0.55) that fits the
+    cap (the in-band strike nearest |delta| 0.5); else 1 OTM if it fits the cap; else the ATM (the cap gate refuses it).
+    A strike with no live delta counts as in-band only when it is the ATM. Never further out, never a spread."""
+    it = intraday() or {}
+    lo, hi = (it.get("deltaBand") or [0.45, 0.55])[:2]
+    fits = lambda x: bool((x.get("quote") or {}).get("ask") and x["quote"]["ask"] * 100 <= cap)
+    def inband(x):
+        d = _num((x.get("quote") or {}).get("delta"))
+        return (lo <= abs(d) <= hi) if d is not None else x["contract"].get("offset") == "ATM"
+    band = [x for x in cands if inband(x) and fits(x)]
+    if band:
+        return min(band, key=lambda x: (abs(abs(_num((x.get("quote") or {}).get("delta")) or 0.5) - 0.5), x["contract"].get("offset") != "ATM"))
+    otm = next((x for x in cands if x["contract"].get("offset") == "OTM_1" and fits(x)), None)
+    if otm: return otm
+    return next((x for x in cands if x["contract"].get("offset") == "ATM"), None)
+
