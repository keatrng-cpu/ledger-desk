# Copy to .env — never commit real keys.
# On Netlify: Site settings → Environment variables (set for Production + Deploy previews)

# CME Globex historical (primary for dual charts + desk structure)
# Same key as Trading-Automation. Requires GLBX.MDP3 entitlement.
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3

# Durable Postgres (Neon recommended for Netlify/Vercel).
# Without this, production falls back to ephemeral PGLite (journal/paper reset on cold start).
DATABASE_URL=

# Optional: override account equity used for risk display defaults
# AP_ACCOUNT_EQUITY=10000

# --- Phase B (automation) ---
# Shared secret for the scheduled jobs at /api/cron/* .
# Callers send: Authorization: Bearer <CRON_SECRET>
# Unset => those endpoints return 503.
CRON_SECRET=
# User id the scheduled jobs attribute rows to. Falls back to
# ENGINE_BRIDGE_USER_ID, then "dev-user".
CRON_USER_ID=
# Web Push (VAPID). Generate with: node scripts/gen-vapid.mjs (see INTEGRATION-C.md).
# PUBLIC key is served to the browser by design; PRIVATE key is server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URL sent in the VAPID JWT "sub" claim.
VAPID_SUBJECT=

# Force Nitro preset when building outside Netlify CI (optional)
# NITRO_PRESET=netlify

# --- Desk coach narration (optional) ---
# Grok + Claude as peers in the Desk coach panel (src/lib/coach/claude-server.ts).
# One click fires both in parallel when both keys are set. Neither is primary.
# READ-ONLY: explains already-computed structure. It never gates, scores or
# sizes a trade — that stays deterministic TypeScript (CLAUDE.md house rule).
# Costs money per call, so it is on-demand (button) only, never the desk poll.
# Unset both => the deterministic coach still renders; the Ask button explains why.
# Server-only — never prefix with VITE_. Never commit a real value.
XAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Databento (CME ES/NQ bars) ---
# Historical API, GLBX.MDP3, ohlcv-1m on ES.c.0 / NQ.c.0. Unset => Yahoo only.
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
# How far behind "now" to end each request window, in MINUTES.
# Live CME (Standard plan) is ON for this desk — keep at 0. Historical still
# batches ~15–20m behind the Live socket; fetchDatabentoBars parses the 422
# `available_end` and retries. Revert to 600 only if the plan lapses.
DATABENTO_DELAY_MINUTES=0

# --- Tradovate execution (ROADMAP E2) ---
# Master kill switch. Anything other than "true" => the adapter cannot send.
TRADOVATE_ENABLED=false
# "live" (exact word) reaches live.tradovateapi.com. EVERY other value,
# including unset/blank/typos, resolves to the demo host. Default: demo.
TRADOVATE_ENV=demo
# Second, independent switch. Live sending additionally requires this to be
# "true". Two switches so no single edit or mistake can promote demo to live.
TRADOVATE_LIVE_ARMED=false
# Credentials — API Access add-on required. Never commit real values.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=

# --- The trading floor's execution layer (src/lib/room/exec) — options orders via Alpaca ---
# Off until the trader turns it on in the Floor tab's Execution card (the phase lives in the database).
# Paper keys: Alpaca → Paper Trading → API Keys. Used for shadow quotes and paper orders.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Live keys are SEPARATE variables on purpose: a paper key can never be used live and the reverse.
# Live also stays shut until the human-flipped flags in src/lib/room/exec/limits.ts are true.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
# "opra" only if you pay for Alpaca's OPRA options data. Anything else = "indicative" (free; quotes are modified
# and never price a live order).
ALPACA_DATA_FEED=indicative
# The execution layer's safety-net cron (/api/cron/exec-flatten) needs CRON_SECRET and CRON_USER_ID = this trader's id
# (the Execution card prints it). Without CRON_USER_ID the cron looks at the wrong trader and flattens nothing.

# --- Robinhood live options (Agentic 995386158 only) ---
# Connect Robinhood on the floor (one sign-in). The refresh token stays in
# Postgres. Opening the desk again does not connect again.
# RH_ACCESS_TOKEN is unused unless you already have a bearer. Unset, and no
# stored sign-in, means the cycle is decided and nothing is sent.
# Both arms default ON (Keaton 2026-10-07): a false / typo stops NEW entries.
# A close of a position this desk opened still sends while the sign-in is stored.
# Envelope, the session clock, and the buying-power gate still refuse a bad ticket.
# RH_ACCESS_TOKEN=
# RH_API_BASE=https://api.robinhood.com
# RH_LEDGER_PATH=/tmp/ledger-desk-rh.json
# Master automation switch. "false" disarms. Unset or "true" is armed.
RH_OPTIONS_AUTOFIRE_ENABLED=true
# Explicit live arm. "false" disarms. Unset or "true" is armed.
RH_LIVE_ARMED=true
