# Copy to .env (gitignored) and fill in. Never commit real secrets.

# Postgres (Neon). Unset -> the embedded PGLite fallback is used.
DATABASE_URL=

# --- Phase 4 automation bridge (POST /api/engine/*) ---------------------------
# Shared secret the Python Trading-Automation engine sends as
#   Authorization: Bearer <token>
# Generate one locally, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UNSET => both bridge endpoints answer 503 and write nothing. There is no
# unauthenticated write path.
ENGINE_BRIDGE_TOKEN=

# The bridge bypasses browser auth (no session cookie on a Python process), so
# rows it writes are attributed to this user id. Must match the desk user whose
# journal should show the engine rows. Defaults to 'dev-user' (the preview user).
ENGINE_BRIDGE_USER_ID=dev-user
